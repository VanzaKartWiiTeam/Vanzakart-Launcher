                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#B80B1020"
                        BorderBrush="#202A42"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,18">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>



                        <StackPanel Grid.Row="1">
                            <!-- General -->
                            <TextBlock Text="General" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaint}" Margin="12,0,0,8"/>
                            <Button x:Name="HomeNavButton" Tag="&#xE768;" Content="HOME / PLAY" Style="{StaticResource NavButton}" Click="HomeNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="NewsNavButton" Tag="&#xE8A5;" Content="NEWS" Style="{StaticResource NavButton}" Click="NewsNavButton_Click" Margin="0,0,0,4"/>

                            <!-- Online -->
                            <TextBlock Text="Online" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaint}" Margin="12,14,0,8"/>
                            <Button x:Name="RoomsNavButton" Tag="&#xE716;" Content="ROOMS" Style="{StaticResource NavButton}" Click="RoomsNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="LeaderboardNavButton" Tag="&#xED39;" Content="LEADERBOARD" Style="{StaticResource NavButton}" Click="LeaderboardNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="FriendsNavButton" Tag="&#xE902;" Content="FRIENDS" Style="{StaticResource NavButton}" Click="FriendsNavButton_Click" Margin="0,0,0,4"/>

                            <!-- Customize -->
                            <TextBlock Text="Customize" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaint}" Margin="12,14,0,8"/>
                            <Button x:Name="ModsNavButton" Tag="&#xE7B8;" Content="MODS" Style="{StaticResource NavButton}" Click="ModsNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="LicensesNavButton" Tag="&#xE77B;" Content="MII &amp; LICENSES" Style="{StaticResource NavButton}" Click="LicensesNavButton_Click" Margin="0,0,0,4"/>

                            <!-- Other -->
                            <TextBlock Text="Other" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaint}" Margin="12,14,0,8"/>
                            <Button x:Name="SettingsNavButton" Tag="&#xE713;" Content="SETTINGS" Style="{StaticResource NavButton}" Click="SettingsNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="DebugNavButton" Tag="&#xE943;" Content="DEBUG" Style="{StaticResource NavButton}" Click="DebugNavButton_Click" Visibility="Collapsed" Margin="0,0,0,4"/>
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource MiniCard}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="COMMUNITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Discord and website" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,4,0,12"/>
                                <UniformGrid Columns="2">
                                    <Button Content="Discord" Style="{StaticResource ActionButton}" Padding="8" FontSize="12" Margin="0,0,5,0" Click="OpenDiscordBorder_OnClick"/>
                                    <Button Content="Website" Style="{StaticResource ActionButton}" Padding="8" FontSize="12" Margin="5,0,0,0" Click="OpenWebsiteButton_OnClick"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="26,18,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleTextBlock" Text="Home / Play" FontSize="25" FontWeight="Black"/>
                            <TextBlock x:Name="PageSubtitleTextBlock" Text="Ready to race VanzaKart." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="MainContentScrollViewer" ScrollChanged="MainContentScrollViewer_OnScrollChanged">
                            <Grid>
                                <Grid x:Name="PlayView" Visibility="Visible" MinHeight="520">
                                    <StackPanel>
                                        <Border Style="{StaticResource GlassCard}" Padding="0" Margin="0,0,0,14" ClipToBounds="True">
                                            <Grid MinHeight="350">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.18*"/>
                                                    <ColumnDefinition Width="0.82*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.ColumnSpan="2" CornerRadius="15" Opacity="0.18">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF3B7A" Offset="-0.15"/>
                                                            <GradientStop Color="#39E7FF" Offset="0.55"/>
                                                            <GradientStop Color="#9D5CFF" Offset="1.20"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Margin="34,32" VerticalAlignment="Center">
                                                    <TextBlock Text="VANZAKART" FontSize="50" FontWeight="Black" Height="86"/>

                                                    <Button x:Name="LaunchButton"
                                                            Content="PLAY"
                                                            Style="{StaticResource HugePlayButton}"
                                                            Width="440"
                                                            Height="118"
                                                            HorizontalAlignment="Left"
                                                            Click="LaunchButton_OnClick"/>

                                                    <TextBlock x:Name="StatusTextBlock"
                                                               Text="Checking local install..."
                                                               TextWrapping="Wrap"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Margin="2,24,0,10"/>

                                                    <ProgressBar x:Name="DownloadProgressBar"
                                                                 Style="{StaticResource NeonProgressBar}"
                                                                 Width="440"
                                                                 HorizontalAlignment="Left"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="0"
                                                                 Visibility="Collapsed"/>

                                                    <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                                                        <TextBlock x:Name="UpdatePhaseTextBlock" Text="Idle" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock Text="  /  " FontSize="12" Foreground="{StaticResource TextFaint}"/>
                                                        <TextBlock x:Name="UpdatePercentTextBlock" Text="0%" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                                                        <TextBlock Text="  " FontSize="12" Foreground="{StaticResource TextFaint}"/>
                                                        <TextBlock x:Name="UpdateSpeedTextBlock" Text="" FontSize="12" Foreground="{StaticResource TextFaint}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="1" Margin="12,18,34,18">
                                                    <Image Source="/Assets/logo.png" Width="200" Height="200" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.96">
                                                        <Image.RenderTransform>
                                                            <TranslateTransform x:Name="HeroLogoTransform"/>
                                                        </Image.RenderTransform>
                                                    </Image>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.05*"/>
                                                <ColumnDefinition Width="0.95*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,119">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"><Run Text="Game stats"/></TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                            <TextBlock Foreground="{StaticResource TextFaint}"><Run Text="Last"/><Run Text=" play"/><Run Text=" "/></TextBlock>
                                                            <TextBlock x:Name="LastPlayedTextBlock" Text="Never" FontWeight="Bold"/>
                                                            <TextBlock Text="   Time " Foreground="{StaticResource TextFaint}"/>
                                                            <TextBlock x:Name="TimePlayedTextBlock" Text="0 min" FontWeight="Bold"/>
                                                            <TextBlock Text="   Launches " Foreground="{StaticResource TextFaint}"/>
                                                            <TextBlock x:Name="LaunchCountTextBlock" Text="0" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="ModFolderTextBlock" Text="" Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Mods" Style="{StaticResource CompactButton}" Click="ModsNavButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource GlassCard}" Grid.Column="1" Margin="10,0,0,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="MOD UPDATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                            <TextBlock x:Name="HomeUpdateTitleTextBlock" Text="Checking local state" FontSize="18" FontWeight="Black" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                        <Border x:Name="HomeUpdateBadgeBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,5" CornerRadius="8" Background="#1C2740" BorderBrush="#354A70" BorderThickness="1">
                                                            <TextBlock x:Name="HomeUpdateBadgeTextBlock" Text="Idle" FontSize="11" FontWeight="Black"/>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Installed" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock x:Name="HomeInstalledVersionTextBlock" Text="Unknown" FontSize="15" FontWeight="Black"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Latest" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock x:Name="HomeLatestVersionTextBlock" Text="Unknown" FontSize="15" FontWeight="Black"/>
                                                        </StackPanel>
