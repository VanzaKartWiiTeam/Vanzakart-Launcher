<Window x:Class="VanzaKartLauncher.MainWindow"
        x:Name="MainWindowInstance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:VanzaKartLauncher.Services"
        Title="VanzaKart Launcher"
        Width="1320"
        Height="840"
        MinWidth="1320"
        MinHeight="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/app.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="18"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7FAFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA8C6"/>
        <SolidColorBrush x:Key="TextFaint" Color="#64718C"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151B2B"/>
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#111827"/>
        <SolidColorBrush x:Key="PanelGlassBrush" Color="#EE12192A"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#2A3857"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0B1020"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B82"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4DFFB0"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFD166"/>

        <SolidColorBrush x:Key="ActiveTabBackgroundBrush" Color="#1E2A42"/>
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#070A13"/>
            <GradientStop Offset="0.35" Color="#0F1426"/>
            <GradientStop Offset="0.70" Color="#061622"/>
            <GradientStop Offset="1.00" Color="#140A1F"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RainbowGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.00" Color="#FF0066"/>
            <GradientStop Offset="0.18" Color="#FF8800"/>
            <GradientStop Offset="0.34" Color="#FFEA00"/>
            <GradientStop Offset="0.50" Color="#00FF66"/>
            <GradientStop Offset="0.67" Color="#00F2FF"/>
            <GradientStop Offset="0.84" Color="#3300FF"/>
            <GradientStop Offset="1.00" Color="#B000FF"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PlayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#FF0066"/>
            <GradientStop Offset="0.35" Color="#FF8800"/>
            <GradientStop Offset="0.68" Color="#00F2FF"/>
            <GradientStop Offset="1.00" Color="#B000FF"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="0" Opacity="0.32" Color="#000000"/>
        <DropShadowEffect x:Key="NeonGlow" BlurRadius="26" ShadowDepth="0" Opacity="0.70" Color="#00F2FF"/>
        <DropShadowEffect x:Key="PinkGlow" BlurRadius="26" ShadowDepth="0" Opacity="0.65" Color="#FF0066"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="Image">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="Fant"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#40506F" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="MiniCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>

        <Style x:Key="SkeletonCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Opacity" Value="0.4"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.3" To="0.7" Duration="0:0:1.2"
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoomCardBorder" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Width" Value="290"/>
            <Setter Property="Height" Value="176"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00F2FF"/>
                    <Setter Property="Background" Value="#1A2235"/>
                    <Setter Property="Effect" Value="{StaticResource NeonGlow}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeaderboardRowBorder" TargetType="Border" BasedOn="{StaticResource MiniCard}">
            <Setter Property="Background" Value="{StaticResource PanelGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3B5C"/>
                    <Setter Property="BorderBrush" Value="#00F2FF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource RainbowGradient}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Background" Value="#EE1D142D"/>
                    <Setter Property="Effect" Value="{StaticResource NeonGlow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Podium1CardStyle" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="BorderBrush" Value="#FFD166"/>
            <Setter Property="BorderThickness" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Podium2CardStyle" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Podium3CardStyle" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="BorderBrush" Value="#CD7F32"/>
            <Setter Property="BorderThickness" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <!-- Hover Background Overlay -->
                                <Border x:Name="HoverOverlay" Background="#20FFFFFF" CornerRadius="11" Opacity="0"/>
                                <!-- Active Background Overlay -->
                                <Border x:Name="ActiveOverlay" Background="#1E2A42" CornerRadius="11" Opacity="0"/>

                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Selection Indicator Rail -->
                                    <Border x:Name="Rail" Width="4" CornerRadius="2" Background="{StaticResource RainbowGradient}" Opacity="0"/>
                                    
                                    <!-- Icon Container -->
                                    <Border x:Name="IconPlate" Grid.Column="1" Width="30" Height="30" CornerRadius="10" Background="#152033" BorderBrush="#263654" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <Border x:Name="IconPlateActiveBg" CornerRadius="9" Background="{StaticResource RainbowGradient}" Opacity="0"/>
                                            <TextBlock x:Name="IconGlyph"
                                                       Text="{TemplateBinding Tag}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    
                                    <ContentPresenter Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="IconPlateActiveBg" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="IconPlateActiveBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="IconPlate" Property="BorderBrush" Value="#A8FFFFFF"/>
                                <Setter TargetName="IconGlyph" Property="Foreground" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            
                            <Trigger Property="Background" Value="{StaticResource ActiveTabBackgroundBrush}">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IconPlateActiveBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="IconPlate" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E0FFFFFF" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IconPlateActiveBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="IconPlate" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#263654" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="IconGlyph" Property="Foreground" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#9AA8C6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid">
                            <!-- Hover Overlay -->
                            <Border x:Name="HoverOverlay" Background="White" CornerRadius="6" Opacity="0"/>
                            <!-- Press Overlay -->
                            <Border x:Name="PressOverlay" Background="White" CornerRadius="6" Opacity="0"/>
                            <!-- Content -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressOverlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseChromeButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#9AA8C6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid">
                            <!-- Hover Overlay (Translucent Pink) -->
                            <Border x:Name="HoverOverlay" Background="#FF0066" CornerRadius="6" Opacity="0"/>
                            <!-- Press Overlay -->
                            <Border x:Name="PressOverlay" Background="White" CornerRadius="6" Opacity="0"/>
                            <!-- Content -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressOverlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2640"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33405D"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#25355C" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#4A5E8C" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1B2640" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#33405D" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#151E33"/>
            <Setter Property="BorderBrush" Value="{StaticResource RainbowGradient}"/>
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="2">
                            <!-- Rainbow Neon Glow Backdrop -->
                            <Border x:Name="GlowBorder" CornerRadius="10" Background="{StaticResource RainbowGradient}" Opacity="0.25" Margin="-4">
                                <Border.Effect>
                                    <BlurEffect Radius="10"/>
                                </Border.Effect>
                            </Border>

                            <!-- Main Button Card -->
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.8"
                                    CornerRadius="8"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="315" Opacity="0.6" Color="Black"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1F2C4C" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#151E33" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.05"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>

        <Style x:Key="HugePlayButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PlayGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#E0FFFFFF"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource PinkGlow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border Background="#1CFFFFFF" CornerRadius="14" Margin="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Direction="315" Opacity="0.9" Color="Black"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:1.8">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:1.8">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Root" Property="Effect" Value="{StaticResource NeonGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Fill="{StaticResource TextSecondary}" Data="M0,0 L8,0 L4,5 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CustomComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background" Value="#151B2B"/>
                        <Setter Property="Padding" Value="12,10"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Template="{StaticResource ComboBoxToggleButton}"/>
                            <ContentPresenter Margin="14,0,34,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              IsHitTestVisible="False"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="#151B2B"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220">
                                    <ScrollViewer Margin="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#253049" BorderBrush="#3A4865" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3" HorizontalAlignment="Left" Fill="{StaticResource TextSecondary}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource RainbowGradient}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A8FFFFFF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource RainbowGradient}"/>
            <Setter Property="Background" Value="#0A1020"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"
                                    Effect="{StaticResource NeonGlow}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18"
            BorderThickness="1.2"
            BorderBrush="#4C5C8C"
            Background="{StaticResource WindowGradient}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dual-layer background parallax animation -->
            <Canvas x:Name="AmbientParticleCanvas" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.85">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="AmbientParticleTransform"/>
                </Canvas.RenderTransform>

                <!-- Glowing Layer 1 (Deep/Thick/Soft) -->
                <Path Data="M-120,130 C180,20 330,260 650,112 S1040,160 1460,48"
                      Stroke="{StaticResource RainbowGradient}"
                      StrokeThickness="20"
                      Opacity="0.5">
                    <Path.Effect>
                        <BlurEffect Radius="28"/>
                    </Path.Effect>
                </Path>
                <!-- Glowing Layer 1 (Thin/Solid) -->
                <Path Data="M-120,130 C180,20 330,260 650,112 S1040,160 1460,48"
                      Stroke="{StaticResource RainbowGradient}"
                      StrokeThickness="3.0"
                      Opacity="0.8">
                    <Path.Effect>
                        <DropShadowEffect Color="#FF007F" BlurRadius="12" ShadowDepth="0" Opacity="0.65"/>
                    </Path.Effect>
                </Path>

                <!-- Glowing Layer 2 (Deep/Thick/Soft) -->
                <Path Data="M-80,650 C250,500 430,720 720,560 S1060,540 1420,430"
                      Stroke="#00F2FF"
                      StrokeThickness="18"
                      Opacity="0.45">
                    <Path.Effect>
                        <BlurEffect Radius="24"/>
                    </Path.Effect>
                </Path>
                <!-- Glowing Layer 2 (Thin/Solid) -->
                <Path Data="M-80,650 C250,500 430,720 720,560 S1060,540 1420,430"
                      Stroke="#00F2FF"
                      StrokeThickness="2.5"
                      Opacity="0.75">
                    <Path.Effect>
                        <DropShadowEffect Color="#00F2FF" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                    </Path.Effect>
                </Path>

                <Rectangle Width="260" Height="2" RadiusX="1" RadiusY="1" Fill="#39E7FF" Opacity="0.4" Canvas.Left="880" Canvas.Top="154">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#39E7FF" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="AmbientStreakTransformA"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="180" Height="2" RadiusX="1" RadiusY="1" Fill="#FF3B7A" Opacity="0.35" Canvas.Left="620" Canvas.Top="690">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#FF3B7A" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="AmbientStreakTransformB"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="140" Height="2" RadiusX="1" RadiusY="1" Fill="#FFD166" Opacity="0.3" Canvas.Left="1120" Canvas.Top="420">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#FFD166" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="AmbientStreakTransformC"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <Border Grid.Row="0"
                    Background="#D00A0F1E"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="VANZAKART" FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                        <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="8" Background="#1F273C" BorderBrush="#33405F" BorderThickness="1">
                            <TextBlock x:Name="VersionBadgeTextBlock" Text="Launcher v1.2.2" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,0,0,1"/>
                        </Border>
                        <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="8" Background="#151F31" BorderBrush="#30425E" BorderThickness="1">
                            <TextBlock x:Name="ShellStatusTextBlock" Text="Ready" FontSize="11" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Padding="0,0,0,1" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource CloseChromeButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#B80B1020"
                        BorderBrush="#202A42"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,18">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>



                        <StackPanel Grid.Row="1">
                            <!-- General -->
                            <TextBlock Text="General" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaint}" Margin="12,0,0,8"/>
                            <Button x:Name="HomeNavButton" Tag="&#xE768;" Content="HOME / PLAY" Style="{StaticResource NavButton}" Click="HomeNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="NewsNavButton" Tag="&#xE8A5;" Content="NEWS" Style="{StaticResource NavButton}" Click="NewsNavButton_Click" Margin="0,0,0,4"/>

                            <!-- Online -->
                            <TextBlock Text="Online" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaint}" Margin="12,14,0,8"/>
                            <Button x:Name="RoomsNavButton" Tag="&#xE716;" Content="ROOMS" Style="{StaticResource NavButton}" Click="RoomsNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="LeaderboardNavButton" Tag="&#xED39;" Content="LEADERBOARD" Style="{StaticResource NavButton}" Click="LeaderboardNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="FriendsNavButton" Tag="&#xE902;" Content="FRIENDS" Style="{StaticResource NavButton}" Click="FriendsNavButton_Click" Margin="0,0,0,4"/>

                            <!-- Customize -->
                            <TextBlock Text="Customize" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaint}" Margin="12,14,0,8"/>
                            <Button x:Name="ModsNavButton" Tag="&#xE7B8;" Content="MODS" Style="{StaticResource NavButton}" Click="ModsNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="LicensesNavButton" Tag="&#xE77B;" Content="MII &amp; LICENSES" Style="{StaticResource NavButton}" Click="LicensesNavButton_Click" Margin="0,0,0,4"/>

                            <!-- Other -->
                            <TextBlock Text="Other" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaint}" Margin="12,14,0,8"/>
                            <Button x:Name="SettingsNavButton" Tag="&#xE713;" Content="SETTINGS" Style="{StaticResource NavButton}" Click="SettingsNavButton_Click" Margin="0,0,0,4"/>
                            <Button x:Name="DebugNavButton" Tag="&#xE943;" Content="DEBUG" Style="{StaticResource NavButton}" Click="DebugNavButton_Click" Visibility="Collapsed" Margin="0,0,0,4"/>
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource MiniCard}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="COMMUNITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Discord and website" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,4,0,12"/>
                                <UniformGrid Columns="2">
                                    <Button Content="Discord" Style="{StaticResource ActionButton}" Padding="8" FontSize="12" Margin="0,0,5,0" Click="OpenDiscordBorder_OnClick"/>
                                    <Button Content="Website" Style="{StaticResource ActionButton}" Padding="8" FontSize="12" Margin="5,0,0,0" Click="OpenWebsiteButton_OnClick"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="26,18,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleTextBlock" Text="Home / Play" FontSize="25" FontWeight="Black"/>
                            <TextBlock x:Name="PageSubtitleTextBlock" Text="Ready to race VanzaKart." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer>
                            <Grid>
                                <Grid x:Name="PlayView" Visibility="Visible" MinHeight="520">
                                    <StackPanel>
                                        <Border Style="{StaticResource GlassCard}" Padding="0" Margin="0,0,0,14" ClipToBounds="True">
                                            <Grid MinHeight="350">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.18*"/>
                                                    <ColumnDefinition Width="0.82*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.ColumnSpan="2" CornerRadius="15" Opacity="0.18">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF3B7A" Offset="-0.15"/>
                                                            <GradientStop Color="#39E7FF" Offset="0.55"/>
                                                            <GradientStop Color="#9D5CFF" Offset="1.20"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Margin="34,32" VerticalAlignment="Center">
                                                    <TextBlock Text="VANZAKART" FontSize="50" FontWeight="Black" Height="86"/>

                                                    <Button x:Name="LaunchButton"
                                                            Content="PLAY"
                                                            Style="{StaticResource HugePlayButton}"
                                                            Width="440"
                                                            Height="118"
                                                            HorizontalAlignment="Left"
                                                            Click="LaunchButton_OnClick"/>

                                                    <TextBlock x:Name="StatusTextBlock"
                                                               Text="Checking local install..."
                                                               TextWrapping="Wrap"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Margin="2,24,0,10"/>

                                                    <ProgressBar x:Name="DownloadProgressBar"
                                                                 Style="{StaticResource NeonProgressBar}"
                                                                 Width="440"
                                                                 HorizontalAlignment="Left"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="0"
                                                                 Visibility="Collapsed"/>

                                                    <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                                                        <TextBlock x:Name="UpdatePhaseTextBlock" Text="Idle" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock Text="  /  " FontSize="12" Foreground="{StaticResource TextFaint}"/>
                                                        <TextBlock x:Name="UpdatePercentTextBlock" Text="0%" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                                                        <TextBlock Text="  " FontSize="12" Foreground="{StaticResource TextFaint}"/>
                                                        <TextBlock x:Name="UpdateSpeedTextBlock" Text="" FontSize="12" Foreground="{StaticResource TextFaint}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="1" Margin="12,18,34,18">
                                                    <Image Source="/Assets/logo.png" Width="200" Height="200" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.96">
                                                        <Image.RenderTransform>
                                                            <TranslateTransform x:Name="HeroLogoTransform"/>
                                                        </Image.RenderTransform>
                                                    </Image>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.05*"/>
                                                <ColumnDefinition Width="0.95*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,119">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"><Run Text="Game stats"/></TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                            <TextBlock Foreground="{StaticResource TextFaint}"><Run Text="Last"/><Run Text=" play"/><Run Text=" "/></TextBlock>
                                                            <TextBlock x:Name="LastPlayedTextBlock" Text="Never" FontWeight="Bold"/>
                                                            <TextBlock Text="   Time " Foreground="{StaticResource TextFaint}"/>
                                                            <TextBlock x:Name="TimePlayedTextBlock" Text="0 min" FontWeight="Bold"/>
                                                            <TextBlock Text="   Launches " Foreground="{StaticResource TextFaint}"/>
                                                            <TextBlock x:Name="LaunchCountTextBlock" Text="0" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="ModFolderTextBlock" Text="" Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Mods" Style="{StaticResource CompactButton}" Click="ModsNavButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource GlassCard}" Grid.Column="1" Margin="10,0,0,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="MOD UPDATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                            <TextBlock x:Name="HomeUpdateTitleTextBlock" Text="Checking local state" FontSize="18" FontWeight="Black" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                        <Border x:Name="HomeUpdateBadgeBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,5" CornerRadius="8" Background="#1C2740" BorderBrush="#354A70" BorderThickness="1">
                                                            <TextBlock x:Name="HomeUpdateBadgeTextBlock" Text="Idle" FontSize="11" FontWeight="Black"/>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Installed" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock x:Name="HomeInstalledVersionTextBlock" Text="Unknown" FontSize="15" FontWeight="Black"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Latest" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock x:Name="HomeLatestVersionTextBlock" Text="Unknown" FontSize="15" FontWeight="Black"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                                        <TextBlock x:Name="HomeUpdateCheckTextBlock" Text="No check performed yet." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                                                        <Button Style="{StaticResource CompactButton}" Margin="0,0,10,10" Click="CheckUpdatesButton_OnClick">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Check Updates" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource CompactPrimaryButton}" Margin="0,0,10,10" Click="InstallButton_OnClick">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE118;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Update Mod" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource CompactButton}" Margin="0,0,0,10" Click="RepairModButton_OnClick">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Repair" VerticalAlignment="Center" UseLayoutRounding="True" FontWeight="Bold" FontSize="14"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                 </Grid>

                                 <!-- ==================================================
                                      ROOMS VIEW
                                      ================================================== -->
                                 <Grid x:Name="RoomsView" Visibility="Collapsed" Margin="0,0,0,10" ClipToBounds="False">
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="*"/>
                                     </Grid.RowDefinitions>

                                     <!-- HERO STATISTICS CARD -->
                                     <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="0" Margin="0,0,0,18" ClipToBounds="True">
                                         <Grid MinHeight="100">
                                             <!-- Rainbow ambient overlay -->
                                             <Border CornerRadius="15" Opacity="0.08">
                                                 <Border.Background>
                                                     <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                         <GradientStop Color="#FF0066" Offset="0.0"/>
                                                         <GradientStop Color="#00F2FF" Offset="0.5"/>
                                                         <GradientStop Color="#B000FF" Offset="1.0"/>
                                                     </LinearGradientBrush>
                                                 </Border.Background>
                                             </Border>

                                             <UniformGrid Columns="4" Margin="24,14">
                                                 <!-- Active Rooms -->
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="ACTIVE ROOMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding ActiveRoomsCount, FallbackValue=0}" FontSize="32" FontWeight="Black" Foreground="#FFD166" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                         <TextBlock.Effect>
                                                             <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FFD166" Opacity="0.5"/>
                                                         </TextBlock.Effect>
                                                     </TextBlock>
                                                 </StackPanel>

                                                 <!-- Online Players -->
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="PLAYERS ONLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding OnlinePlayersCount, FallbackValue=0}" FontSize="32" FontWeight="Black" Foreground="#00F2FF" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                         <TextBlock.Effect>
                                                             <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00F2FF" Opacity="0.5"/>
                                                         </TextBlock.Effect>
                                                     </TextBlock>
                                                 </StackPanel>

                                                 <!-- Server Status -->
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="SERVER STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                         <!-- Glowing online dot -->
                                                         <Ellipse Width="10" Height="10" Fill="#4DFFB0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                             <Ellipse.Effect>
                                                                 <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#4DFFB0" Opacity="0.8"/>
                                                             </Ellipse.Effect>
                                                         </Ellipse>
                                                         <TextBlock Text="{Binding ServerStatus, FallbackValue=ONLINE}" FontSize="18" FontWeight="Bold" Foreground="#4DFFB0" VerticalAlignment="Center"/>
                                                     </StackPanel>
                                                 </StackPanel>

                                                 <!-- Last Updated -->
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="LAST UPDATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding LastUpdatedText, FallbackValue='--:--:--'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                 </StackPanel>
                                             </UniformGrid>
                                         </Grid>
                                     </Border>

                                     <!-- MAIN ROOM CONTENT (GRID ROW 1) -->
                                     <Grid Grid.Row="1" MinHeight="400">

                                         <!-- SKELETON LOADING STATE -->
                                         <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <WrapPanel Orientation="Horizontal">
                                                 <Border Style="{StaticResource SkeletonCard}" Width="290" Height="176" Margin="0,0,14,14"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Width="290" Height="176" Margin="0,0,14,14"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Width="290" Height="176" Margin="0,0,14,14"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Width="290" Height="176" Margin="0,0,14,14"/>
                                             </WrapPanel>
                                         </Grid>

                                         <!-- EMPTY STATE -->
                                         <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <Border Style="{StaticResource GlassCard}" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,10">
                                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <TextBlock Text="&#xF133;" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                     <TextBlock Text="NO ACTIVE ROOMS" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="There are no active multiplayer rooms at the moment. Launch the game and create a room to start!" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,24" TextAlignment="Center" MaxWidth="450" TextWrapping="Wrap"/>
                                                     <Button Content="Refresh Rooms" Style="{StaticResource ActionButton}" Width="160" Padding="12" Click="RoomsRefresh_Click"/>
                                                 </StackPanel>
                                             </Border>
                                         </Grid>

                                         <!-- ERROR STATE -->
                                         <Grid Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <Border Style="{StaticResource GlassCard}" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,10" BorderBrush="{StaticResource DangerBrush}">
                                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                     <TextBlock Text="CONNECTION ERROR" FontSize="18" FontWeight="Black" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,24" TextAlignment="Center" MaxWidth="500" TextWrapping="Wrap"/>
                                                     <Button Content="Retry Connection" Style="{StaticResource ActionButton}" Width="180" Padding="12" Click="RoomsRefresh_Click"/>
                                                 </StackPanel>
                                             </Border>
                                         </Grid>

                                         <!-- DATA STATE (ROOMS LIST) -->
                                         <Grid ClipToBounds="False">
                                             <Grid.Style>
                                                 <Style TargetType="Grid">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding HasError}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Grid.Style>

                                             <!-- Scrollable WrapPanel for cards -->
                                             <ItemsControl ItemsSource="{Binding Rooms}" ClipToBounds="False" Margin="8">
                                                 <ItemsControl.ItemsPanel>
                                                     <ItemsPanelTemplate>
                                                         <WrapPanel Orientation="Horizontal" ClipToBounds="False"/>
                                                     </ItemsPanelTemplate>
                                                 </ItemsControl.ItemsPanel>
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Border Style="{StaticResource RoomCardBorder}">
                                                             <Grid>
                                                                 <Grid.RowDefinitions>
                                                                     <RowDefinition Height="Auto"/>
                                                                     <RowDefinition Height="*"/>
                                                                     <RowDefinition Height="Auto"/>
                                                                 </Grid.RowDefinitions>

                                                                 <!-- Card Header -->
                                                                 <Grid Grid.Row="0">
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*"/>
                                                                         <ColumnDefinition Width="Auto"/>
                                                                     </Grid.ColumnDefinitions>
                                                                     <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                                                                     <!-- Player Count Pill -->
                                                                     <Border Grid.Column="1" Background="#202A42" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                                                         <TextBlock Text="{Binding DisplayPlayerCount}" FontSize="11.5" FontWeight="Bold" Foreground="#39E7FF"/>
                                                                     </Border>
                                                                 </Grid>

                                                                 <!-- Card Body (Current Track & Info) -->
                                                                 <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0">
                                                                     <TextBlock Text="CURRENT TRACK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextFaint}"/>
                                                                     <TextBlock Text="{Binding Track}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                     <TextBlock Text="{Binding Mode}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,4,0,0"/>
                                                                 </StackPanel>

                                                                 <!-- Card Footer -->
                                                                 <Grid Grid.Row="2" Margin="0,8,0,0">
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*"/>
                                                                         <ColumnDefinition Width="Auto"/>
                                                                     </Grid.ColumnDefinitions>

                                                                     <TextBlock Text="{Binding Region}" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Grid.Column="0"/>
                                                                     
                                                                     <!-- Game status badge -->
                                                                     <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                                                         <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                                                             <Ellipse.Style>
                                                                                 <Style TargetType="Ellipse">
                                                                                     <Setter Property="Fill" Value="#FFD166"/>
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding IsRacing}" Value="True">
                                                                                             <Setter Property="Fill" Value="#4DFFB0"/>
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Ellipse.Style>
                                                                         </Ellipse>
                                                                         <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                             <TextBlock.Style>
                                                                                 <Style TargetType="TextBlock">
                                                                                     <Setter Property="Foreground" Value="#FFD166"/>
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding IsRacing}" Value="True">
                                                                                             <Setter Property="Foreground" Value="#4DFFB0"/>
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </TextBlock.Style>
                                                                         </TextBlock>
                                                                     </StackPanel>
                                                                 </Grid>
                                                             </Grid>
                                                         </Border>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </Grid>
                                     </Grid>
                                 </Grid>

                                 <!-- ==================================================
                                      LEADERBOARD VIEW
                                      ================================================== -->
                                 <Grid x:Name="LeaderboardView" Visibility="Collapsed" Margin="0,0,0,10">
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/> <!-- Podium -->
                                         <RowDefinition Height="Auto"/> <!-- Filter toolbar -->
                                         <RowDefinition Height="*"/>    <!-- Classifica completa -->
                                     </Grid.RowDefinitions>

                                     <!-- TOP 3 PODIUM -->
                                     <Grid Grid.Row="0" Margin="0,0,0,24">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>   <!-- 2nd Place -->
                                             <ColumnDefinition Width="1.1*"/> <!-- 1st Place -->
                                             <ColumnDefinition Width="*"/>   <!-- 3rd Place -->
                                         </Grid.ColumnDefinitions>

                                         <!-- 2° POSTO (SINISTRA) -->
                                         <Border Grid.Column="0" Style="{StaticResource Podium2CardStyle}" Padding="16" Height="230" Margin="0,15,10,0" VerticalAlignment="Bottom">
                                             <Border.Effect>
                                                 <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#C0C0C0" Opacity="0.18"/>
                                             </Border.Effect>
                                             <Grid DataContext="{Binding Top2}">
                                                 <Grid.Style>
                                                     <Style TargetType="Grid">
                                                         <Setter Property="Visibility" Value="Visible"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                 <Setter Property="Visibility" Value="Hidden"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Grid.Style>
                                                 <StackPanel VerticalAlignment="Center">
                                                     <!-- Circle badge for position -->
                                                     <Border Width="30" Height="30" CornerRadius="15" Background="#88C0C0C0" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                         <TextBlock Text="2" FontSize="15" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                     <!-- Mii Avatar / Initials Avatar -->
                                                     <Border Width="80" Height="80" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True">
                                                         <Border.Background>
                                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                 <GradientStop Color="{Binding AvatarGradientStart, FallbackValue=#00F2FF}" Offset="0"/>
                                                                 <GradientStop Color="{Binding AvatarGradientEnd, FallbackValue=#B000FF}" Offset="1"/>
                                                             </LinearGradientBrush>
                                                         </Border.Background>
                                                         <Grid>
                                                             <TextBlock Text="{Binding AvatarInitial, FallbackValue=?}" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                 <TextBlock.Style>
                                                                     <Style TargetType="TextBlock">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </TextBlock.Style>
                                                             </TextBlock>
                                                             <Image Source="{Binding AvatarImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                                 <Image.RenderTransform>
                                                                     <ScaleTransform ScaleX="1.28" ScaleY="1.28"/>
                                                                 </Image.RenderTransform>
                                                                 <Image.Style>
                                                                     <Style TargetType="Image">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Image.Style>
                                                             </Image>
                                                         </Grid>
                                                     </Border>
                                                     <TextBlock Text="{Binding Name, FallbackValue=Player}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                     <TextBlock Text="{Binding DisplayPoints, FallbackValue='0 EV'}" FontSize="12" FontWeight="SemiBold" Foreground="#39E7FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                     <TextBlock Text="{Binding FriendCode}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>

                                         <!-- 1° POSTO (CENTRO) -->
                                         <Border Grid.Column="1" Style="{StaticResource Podium1CardStyle}" Padding="18" Height="260" Margin="10,0,10,0" VerticalAlignment="Bottom">
                                             <Border.Effect>
                                                 <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#FFD166" Opacity="0.3"/>
                                             </Border.Effect>
                                             <Grid DataContext="{Binding Top1}">
                                                 <Grid.Style>
                                                     <Style TargetType="Grid">
                                                         <Setter Property="Visibility" Value="Visible"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                 <Setter Property="Visibility" Value="Hidden"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Grid.Style>
                                                 <StackPanel VerticalAlignment="Center">
                                                     <!-- Trophy/Position Badge (coppa) -->
                                                     <Border Width="36" Height="36" CornerRadius="18" Background="#FFD166" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                         <Border.Effect>
                                                             <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#FFD166" Opacity="0.75"/>
                                                         </Border.Effect>
                                                         <TextBlock Text="1" FontSize="18" FontWeight="Black" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                     <!-- Mii Avatar / Initials Avatar -->
                                                     <Border Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True">
                                                         <Border.Background>
                                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                 <GradientStop Color="{Binding AvatarGradientStart, FallbackValue=#FF0066}" Offset="0"/>
                                                                 <GradientStop Color="{Binding AvatarGradientEnd, FallbackValue=#FF7A00}" Offset="1"/>
                                                             </LinearGradientBrush>
                                                         </Border.Background>
                                                         <Grid>
                                                             <TextBlock Text="{Binding AvatarInitial, FallbackValue=?}" FontSize="32" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                 <TextBlock.Style>
                                                                     <Style TargetType="TextBlock">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </TextBlock.Style>
                                                             </TextBlock>
                                                             <Image Source="{Binding AvatarImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                                 <Image.RenderTransform>
                                                                     <ScaleTransform ScaleX="1.28" ScaleY="1.28"/>
                                                                 </Image.RenderTransform>
                                                                 <Image.Style>
                                                                     <Style TargetType="Image">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Image.Style>
                                                             </Image>
                                                         </Grid>
                                                     </Border>
                                                     <TextBlock Text="{Binding Name, FallbackValue=Player}" FontSize="17" FontWeight="Black" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                     <TextBlock Text="{Binding DisplayPoints, FallbackValue='0 EV'}" FontSize="13.5" FontWeight="Bold" Foreground="#FFD166" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                         <TextBlock.Effect>
                                                             <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFD166" Opacity="0.5"/>
                                                         </TextBlock.Effect>
                                                     </TextBlock>
                                                     <TextBlock Text="{Binding FriendCode}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>

                                         <!-- 3° POSTO (DESTRA) -->
                                         <Border Grid.Column="2" Style="{StaticResource Podium3CardStyle}" Padding="16" Height="215" Margin="10,15,0,0" VerticalAlignment="Bottom">
                                             <Border.Effect>
                                                 <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#CD7F32" Opacity="0.15"/>
                                             </Border.Effect>
                                             <Grid DataContext="{Binding Top3}">
                                                 <Grid.Style>
                                                     <Style TargetType="Grid">
                                                         <Setter Property="Visibility" Value="Visible"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                 <Setter Property="Visibility" Value="Hidden"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Grid.Style>
                                                 <StackPanel VerticalAlignment="Center">
                                                     <!-- Circle badge for position -->
                                                     <Border Width="28" Height="28" CornerRadius="14" Background="#88CD7F32" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                         <TextBlock Text="3" FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                     <!-- Mii Avatar / Initials Avatar -->
                                                     <Border Width="80" Height="80" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True">
                                                         <Border.Background>
                                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                 <GradientStop Color="{Binding AvatarGradientStart, FallbackValue=#00FF66}" Offset="0"/>
                                                                 <GradientStop Color="{Binding AvatarGradientEnd, FallbackValue=#00F2FF}" Offset="1"/>
                                                             </LinearGradientBrush>
                                                         </Border.Background>
                                                         <Grid>
                                                             <TextBlock Text="{Binding AvatarInitial, FallbackValue=?}" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                 <TextBlock.Style>
                                                                     <Style TargetType="TextBlock">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </TextBlock.Style>
                                                             </TextBlock>
                                                             <Image Source="{Binding AvatarImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                                 <Image.RenderTransform>
                                                                     <ScaleTransform ScaleX="1.28" ScaleY="1.28"/>
                                                                 </Image.RenderTransform>
                                                                 <Image.Style>
                                                                     <Style TargetType="Image">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Image.Style>
                                                             </Image>
                                                         </Grid>
                                                     </Border>
                                                     <TextBlock Text="{Binding Name, FallbackValue=Player}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                                     <TextBlock Text="{Binding DisplayPoints, FallbackValue='0 EV'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#39E7FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                     <TextBlock Text="{Binding FriendCode}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>
                                     </Grid>

                                     <!-- FILTER TOOLBAR (ROW 1) -->
                                     <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,16">
                                         <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*"/>      <!-- Search -->
                                                 <ColumnDefinition Width="Auto"/>   <!-- Sort combo -->
                                                 <ColumnDefinition Width="Auto"/>   <!-- Reload button -->
                                             </Grid.ColumnDefinitions>

                                             <!-- Search input -->
                                             <Border Background="{StaticResource InputBrush}" CornerRadius="8" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Grid.Column="0" Height="36" Margin="0,0,10,0">
                                                 <Grid Margin="10,0">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <TextBlock Text="&#xE11A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                     <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" VerticalContentAlignment="Center" Grid.Column="1" FontSize="13"/>
                                                 </Grid>
                                             </Border>

                                             <!-- Sort combo -->
                                             <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" Style="{StaticResource CustomComboBox}" Width="150" Height="36" Margin="0,0,10,0" Grid.Column="1" VerticalContentAlignment="Center"/>

                                             <!-- Manual Reload Button -->
                                             <Button Content="&#xE149;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ActionButton}" Padding="0" Width="36" Height="36" FontSize="14" Grid.Column="2" Click="LeaderboardRefresh_Click" ToolTip="Reload Rankings"/>
                                         </Grid>
                                     </Border>

                                     <!-- CLASSIFICA COMPLETA (ROW 2) -->
                                     <Grid Grid.Row="2" MinHeight="250">
                                         <!-- Loading state -->
                                         <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <StackPanel>
                                                 <Border Style="{StaticResource SkeletonCard}" Height="48" Margin="0,0,0,10"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Height="48" Margin="0,0,0,10"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Height="48" Margin="0,0,0,10"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Height="48" Margin="0,0,0,10"/>
                                             </StackPanel>
                                         </Grid>

                                         <!-- Error State -->
                                         <Grid Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <Border Style="{StaticResource GlassCard}" Padding="24" BorderBrush="{StaticResource DangerBrush}" Margin="0,10">
                                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                     <TextBlock Text="COULD NOT LOAD LEADERBOARD" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,18" TextAlignment="Center"/>
                                                     <Button Content="Retry" Style="{StaticResource ActionButton}" Width="120" Padding="10" Click="LeaderboardRefresh_Click"/>
                                                 </StackPanel>
                                             </Border>
                                         </Grid>

                                         <!-- Rankings List -->
                                         <Grid>
                                             <Grid.Style>
                                                 <Style TargetType="Grid">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding HasError}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Grid.Style>

                                             <DockPanel>
                                                 <!-- Column Headers -->
                                                 <Grid DockPanel.Dock="Top" Margin="14,0,14,8">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="45"/>  <!-- POS -->
                                                         <ColumnDefinition Width="72"/>  <!-- Avatar -->
                                                         <ColumnDefinition Width="*"/>   <!-- Player Name -->
                                                         <ColumnDefinition Width="110"/> <!-- POINTS -->
                                                         <ColumnDefinition Width="90"/>  <!-- WINS -->
                                                         <ColumnDefinition Width="90"/>  <!-- RACES -->
                                                         <ColumnDefinition Width="90"/>  <!-- WINRATE -->
 
                                                     </Grid.ColumnDefinitions>
                                                     
                                                     <TextBlock Text="POS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="0"/>
                                                     <TextBlock Text="PLAYER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>
                                                     <TextBlock Text="POINTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="3"/>
                                                     <TextBlock Text="WINS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="4"/>
                                                     <TextBlock Text="RACES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="5"/>
                                                     <TextBlock Text="WINRATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="6"/>
 
                                                 </Grid>
                                                 
                                                 <!-- Scrollable List of Ranks -->
                                                 <ItemsControl ItemsSource="{Binding Players}">
                                                 <ItemsControl.ItemsPanel>
                                                     <ItemsPanelTemplate>
                                                         <VirtualizingStackPanel/>
                                                     </ItemsPanelTemplate>
                                                 </ItemsControl.ItemsPanel>
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Border Style="{StaticResource LeaderboardRowBorder}">
                                                             <Grid>
                                                                 <Grid.ColumnDefinitions>
                                                                     <ColumnDefinition Width="45"/>  <!-- Position -->
                                                                     <ColumnDefinition Width="72"/>  <!-- Avatar -->
                                                                     <ColumnDefinition Width="*"/>   <!-- Player Name -->
                                                                     <ColumnDefinition Width="110"/> <!-- Points -->
                                                                     <ColumnDefinition Width="90"/>  <!-- Wins -->
                                                                     <ColumnDefinition Width="90"/>  <!-- Races -->
                                                                     <ColumnDefinition Width="90"/>  <!-- Winrate -->
 
                                                                 </Grid.ColumnDefinitions>

                                                                 <!-- Position -->
                                                                 <TextBlock Text="{Binding Position}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">
                                                                     <TextBlock.Style>
                                                                         <Style TargetType="TextBlock">
                                                                             <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                                             <Style.Triggers>
                                                                                 <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                                     <Setter Property="Foreground" Value="#00F2FF"/>
                                                                                 </DataTrigger>
                                                                             </Style.Triggers>
                                                                         </Style>
                                                                     </TextBlock.Style>
                                                                 </TextBlock>

                                                                 <!-- Avatar -->
                                                                 <Border Grid.Column="1" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                                                     <Border.Background>
                                                                         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                             <GradientStop Color="{Binding AvatarGradientStart}" Offset="0"/>
                                                                             <GradientStop Color="{Binding AvatarGradientEnd}" Offset="1"/>
                                                                         </LinearGradientBrush>
                                                                     </Border.Background>
                                                                     <Grid>
                                                                         <TextBlock Text="{Binding AvatarInitial}" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                             <TextBlock.Style>
                                                                                 <Style TargetType="TextBlock">
                                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </TextBlock.Style>
                                                                         </TextBlock>
                                                                         <Image Source="{Binding AvatarImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                                             <Image.RenderTransform>
                                                                                 <ScaleTransform ScaleX="1.28" ScaleY="1.28"/>
                                                                             </Image.RenderTransform>
                                                                             <Image.Style>
                                                                                 <Style TargetType="Image">
                                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Image.Style>
                                                                         </Image>
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Player Name -->
                                                                 <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                     <StackPanel Orientation="Horizontal">
                                                                         <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                                         <!-- "YOU" Badge -->
                                                                         <Border Background="{StaticResource RainbowGradient}" CornerRadius="4" Padding="5,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSelf, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                             <TextBlock Text="YOU" FontSize="9.5" FontWeight="Black" Foreground="White"/>
                                                                         </Border>
                                                                     </StackPanel>
                                                                     <TextBlock Text="{Binding FriendCode}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                                 </StackPanel>

                                                                 <!-- Points -->
                                                                 <TextBlock Text="{Binding DisplayPoints}" FontSize="13.5" FontWeight="Bold" Foreground="#00F2FF" VerticalAlignment="Center" Grid.Column="3"/>

                                                                 <!-- Wins -->
                                                                 <TextBlock Text="{Binding Wins}" FontSize="13.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Grid.Column="4"/>

                                                                 <!-- Races -->
                                                                 <TextBlock Text="{Binding Races}" FontSize="13.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Grid.Column="5"/>

                                                                 <!-- Winrate -->
                                                                 <TextBlock Text="{Binding WinRatePercent}" FontSize="13.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Grid.Column="6"/>
                                                             </Grid>
                                                         </Border>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </DockPanel>
                                     </Grid>
                                 </Grid>
                             </Grid>

                                <Grid x:Name="NewsView" Visibility="Collapsed">
                                    <StackPanel MaxWidth="920" MinWidth="700" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="NewsSearchTextBox" Style="{StaticResource PathTextBox}" TextChanged="NewsSearchTextBox_TextChanged"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="All" Tag="All" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="NewsFilterButton_Click"/>
                                                    <Button Content="Updates" Tag="Update" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="NewsFilterButton_Click"/>
                                                    <Button Content="Events" Tag="Event" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="NewsFilterButton_Click"/>
                                                    <Button Content="Pinned" Tag="Pinned" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="NewsFilterButton_Click"/>
                                                    <Button x:Name="RefreshNewsButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="Refresh News" Style="{StaticResource ActionButton}" Click="RefreshNewsButton_Click" Width="42" Padding="0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ItemsControl x:Name="NewsItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,14">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,4,0,0"/>
                                                                <Border Margin="0,12,0,0" Padding="8,4" CornerRadius="8" Background="#1C2740" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Version}" FontSize="10" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Black" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                <TextBlock services:MarkdownHelper.MarkdownText="{Binding Summary}" FontSize="13.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,0"/>

                                                                <!-- Media Section -->
                                                                <Border CornerRadius="12" Margin="0,14,0,0" ClipToBounds="True" MaxHeight="300" Background="#0C101F" BorderBrush="#2A3857" BorderThickness="1" HorizontalAlignment="Left">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <!-- Image Element -->
                                                                        <Image Source="{Binding MediaPath}" Stretch="Uniform" MaxHeight="300">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>

                                                                        <!-- Video Element (MediaElement) -->
                                                                        <MediaElement Source="{Binding MediaPath}" 
                                                                          Stretch="Uniform" 
                                                                          MaxHeight="300" 
                                                                          LoadedBehavior="Manual"
                                                                          UnloadedBehavior="Close" 
                                                                          IsMuted="True"
                                                                          Loaded="NewsVideo_Loaded"
                                                                          MediaEnded="NewsVideo_MediaEnded">
                                                                            <MediaElement.Style>
                                                                                <Style TargetType="MediaElement">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </MediaElement.Style>
                                                                        </MediaElement>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ModsView" Visibility="Collapsed" AllowDrop="True" DragOver="ModsDropZone_DragOver" Drop="ModsDropZone_Drop">
                                    <StackPanel MaxWidth="920" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource GlassCard}" Padding="28" Margin="0,0,0,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="260"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="VanzaKart Modpack" FontSize="30" FontWeight="Black"/>
                                                    <TextBlock x:Name="CoreModStatusTextBlock" Text="Status unknown" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,18"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Installed: " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                                        <TextBlock x:Name="InstalledVersionText" Text="Not installed" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="   Latest: " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                                        <TextBlock x:Name="LatestVersionText" Text="Unknown" FontSize="13" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button x:Name="InstallButton" Content="Install" ToolTip="Install or update the mod" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,8" Click="InstallButton_OnClick" FontWeight="Bold" FontSize="14"/>
                                                    <Button x:Name="RepairModButton" Content="Repair" ToolTip="Re-download and repair files" Style="{StaticResource CompactButton}" Margin="0,0,0,8" Click="RepairModButton_OnClick" FontWeight="Bold" FontSize="14"/>
                                                    <Button x:Name="CheckUpdatesButton" Content="Check" ToolTip="Check for updates" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CheckUpdatesButton_OnClick" FontSize="14" FontWeight="Bold"/>
                                                    <Button x:Name="OpenModFolderButton" Content="Folder" ToolTip="Open mod folder" Style="{StaticResource CompactButton}" Click="OpenModFolderButton_OnClick" FontSize="14" FontWeight="Bold"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="ModsDropZone" Style="{StaticResource GlassCard}" MinHeight="170" BorderBrush="#445D8C">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Drop addons here" HorizontalAlignment="Center" FontSize="22" FontWeight="Black"/>
                                                    <TextBlock x:Name="AddonFolderTextBlock" Text="Files go into the local My Stuff folder." HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Addons" ToolTip="Open addon folder" Style="{StaticResource CompactButton}" Margin="0,0,10,0" Click="OpenAddonsFolderButton_OnClick"/>
                                                        <Button Content="Root" ToolTip="Open mod root" Style="{StaticResource CompactButton}" Click="OpenModFolderButton_OnClick"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Margin="0,18,0,0">
                                            <TextBlock x:Name="CompatibilityTextBlock" Text="Install the core mod before importing addons." FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="VersioningTextBlock" Text="Waiting for manifest" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="ModConflictTextBlock" Text="No addon conflicts detected." Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="LicensesView" Visibility="Collapsed">
                                    <StackPanel MaxWidth="920" HorizontalAlignment="Center">
                                        <Border x:Name="MiiRuntimeSetupCard" Style="{StaticResource GlassCard}" Padding="22" Margin="0,0,0,18" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="260"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Mii render setup" FontSize="20" FontWeight="Black"/>
                                                    <TextBlock x:Name="MiiRuntimeStatusTextBlock" Text="Renderer assets are not installed yet." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,12"/>
                                                    <ProgressBar x:Name="MiiRuntimeProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"/>
                                                    <TextBlock x:Name="MiiRuntimeProgressTextBlock" Text="Ready to install" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,8,0,0"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button x:Name="InstallMiiRuntimeButton" Content="Setup" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" Click="InstallMiiRuntimeButton_OnClick"/>
                                                    <Button Content="Log" ToolTip="Open renderer log" Style="{StaticResource CompactButton}" Click="OpenMiiRendererLogButton_OnClick"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="240"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="Mii &amp; Licenses" FontSize="30" FontWeight="Black"/>
                                                    <TextBlock x:Name="LicenseSummaryTextBlock" Text="Select a Dolphin user folder to scan local saves." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,18"/>

                                                    <ItemsControl x:Name="LicenseCardsItemsControl">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <Grid Margin="0,0,0,12">
                                                                     <!-- Soft Glow Backdrop -->
                                                                     <Border x:Name="LicenseGlow" CornerRadius="10" Background="{StaticResource RainbowGradient}" Opacity="0" Margin="-3">
                                                                         <Border.Effect>
                                                                             <BlurEffect Radius="8"/>
                                                                         </Border.Effect>
                                                                     </Border>
                                                                     
                                                                     <!-- Main License Card -->
                                                                     <Border x:Name="LicenseCardBorder" Background="#121A2A" BorderBrush="#2B3855" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0" RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonDown="LicenseCard_MouseLeftButtonDown">
                                                                         <Border.RenderTransform>
                                                                             <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                                                         </Border.RenderTransform>
                                                                         <Grid>
                                                                             <Grid.ColumnDefinitions>
                                                                                 <ColumnDefinition Width="112"/>
                                                                                 <ColumnDefinition Width="*"/>
                                                                             </Grid.ColumnDefinitions>

                                                                             <Border Width="96" Height="96" CornerRadius="12" Background="#0B1020" BorderBrush="#365071" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                                                                                 <Grid ClipToBounds="True">
                                                                                     <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill">
                                                                                         <Image.Style>
                                                                                             <Style TargetType="Image">
                                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                 <Style.Triggers>
                                                                                                     <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                                     </DataTrigger>
                                                                                                 </Style.Triggers>
                                                                                             </Style>
                                                                                         </Image.Style>
                                                                                     </Image>
                                                                                     <TextBlock Text="{Binding AvatarStatus}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                                                                                         <TextBlock.Style>
                                                                                             <Style TargetType="TextBlock">
                                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                                                 <Style.Triggers>
                                                                                                     <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                     </DataTrigger>
                                                                                                 </Style.Triggers>
                                                                                             </Style>
                                                                                         </TextBlock.Style>
                                                                                     </TextBlock>
                                                                                 </Grid>
                                                                             </Border>

                                                                              <StackPanel Grid.Column="1">
                                                                                  <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="Black" TextWrapping="Wrap"/>
                                                                                  <TextBlock Text="{Binding MiiName}" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                                                  <TextBlock Text="{Binding StatsLine}" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="Bold" Margin="0,7,0,0"/>
                                                                                  <!-- Friend Code Badge (click to copy) -->
                                                                                  <Border Margin="0,7,0,0" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" Cursor="Hand" ToolTip="Click to copy Friend Code" MouseLeftButtonDown="FriendCode_OnMouseLeftButtonDown">
                                                                                      <Border.Style>
                                                                                          <Style TargetType="Border">
                                                                                              <Setter Property="Background" Value="#0C2A3D"/>
                                                                                              <Setter Property="BorderBrush" Value="#1D4A6A"/>
                                                                                              <Setter Property="BorderThickness" Value="1"/>
                                                                                              <Setter Property="Visibility" Value="Visible"/>
                                                                                              <Style.Triggers>
                                                                                                  <DataTrigger Binding="{Binding FriendCode}" Value="">
                                                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                  </DataTrigger>
                                                                                              </Style.Triggers>
                                                                                          </Style>
                                                                                      </Border.Style>
                                                                                       <StackPanel Orientation="Horizontal">
                                                                                           <TextBlock Text="FC" FontFamily="Segoe UI" FontSize="11" FontWeight="Black" Foreground="#39E7FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                                           <TextBlock Text="{Binding FriendCode}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#39E7FF" VerticalAlignment="Center"/>
                                                                                       </StackPanel>
                                                                                  </Border>
                                                                                  <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextFaint}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                                                  <!-- Hide AvatarStatus when rendered or avatar is loaded -->
                                                                                  <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                                                                      <TextBlock.Style>
                                                                                          <Style TargetType="TextBlock">
                                                                                              <Setter Property="Text" Value="{Binding AvatarStatus}"/>
                                                                                              <Setter Property="Visibility" Value="Visible"/>
                                                                                              <Style.Triggers>
                                                                                                  <DataTrigger Binding="{Binding AvatarStatus}" Value="Rendered">
                                                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                  </DataTrigger>
                                                                                                  <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                  </DataTrigger>
                                                                                              </Style.Triggers>
                                                                                          </Style>
                                                                                      </TextBlock.Style>
                                                                                  </TextBlock>
                                                                              </StackPanel>
                                                                         </Grid>
                                                                     </Border>
                                                                 </Grid>
                                                                 <DataTemplate.Triggers>
                                                                      <Trigger SourceName="LicenseCardBorder" Property="IsMouseOver" Value="True">
                                                                          <Trigger.EnterActions>
                                                                              <BeginStoryboard>
                                                                                  <Storyboard>
                                                                                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.15">
                                                                                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                      </DoubleAnimation>
                                                                                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.15">
                                                                                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                      </DoubleAnimation>
                                                                                  </Storyboard>
                                                                              </BeginStoryboard>
                                                                          </Trigger.EnterActions>
                                                                          <Trigger.ExitActions>
                                                                              <BeginStoryboard>
                                                                                  <Storyboard>
                                                                                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                                                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                      </DoubleAnimation>
                                                                                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                                                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                      </DoubleAnimation>
                                                                                  </Storyboard>
                                                                              </BeginStoryboard>
                                                                          </Trigger.ExitActions>
                                                                          <Setter TargetName="LicenseCardBorder" Property="Background" Value="#1B253D"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="BorderBrush" Value="#3B4D73"/>
                                                                          <Setter TargetName="LicenseGlow" Property="Opacity" Value="0.45"/>
                                                                      </Trigger>
                                                                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                          <Setter TargetName="LicenseCardBorder" Property="BorderBrush" Value="#00F2FF"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="Background" Value="#17273F"/>
                                                                          <Setter TargetName="LicenseGlow" Property="Opacity" Value="0.75"/>
                                                                      </DataTrigger>
                                                                      <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                          <Setter TargetName="LicenseCardBorder" Property="Opacity" Value="0.55"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="BorderThickness" Value="1"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="BorderBrush" Value="#1A2436"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="Cursor" Value="Arrow"/>
                                                                      </DataTrigger>
                                                                 </DataTemplate.Triggers>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>

                                                    <TextBlock x:Name="PrimaryLicenseTextBlock" Text="" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="PrimaryLicensePathTextBlock" Text="" Visibility="Collapsed"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Licenses " Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock x:Name="LicensesCountTextBlock" Text="0" FontWeight="Bold"/>
                                                        <TextBlock Text="   Mii DB " Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock x:Name="MiiStateTextBlock" Text="Unknown" FontWeight="Bold"/>
                                                        <TextBlock Text="   Backups " Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock x:Name="BackupCountTextBlock" Text="0" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LatestBackupTextBlock" Text="No backups yet" Foreground="{StaticResource TextFaint}" FontSize="12" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <WrapPanel>
                                                    <Button Content="New Mii" ToolTip="Create a real Wii Mii and sync it to Dolphin" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,8" Click="CreateMiiButton_OnClick"/>
                                                    <Button Content="New Lic." ToolTip="Create a save-backed license when a real save is available" Style="{StaticResource CompactButton}" Margin="0,0,0,8" Click="CreateLicenseButton_OnClick"/>
                                                    <Button Content="Backup" ToolTip="Backup current Dolphin save" Style="{StaticResource CompactButton}" Margin="0,0,8,8" Click="BackupSaveButton_OnClick"/>
                                                    <Button Content="Restore" ToolTip="Restore a previous backup" Style="{StaticResource CompactButton}" Margin="0,0,0,8" Click="RestoreBackupButton_OnClick"/>
                                                    <Button Content="Import" ToolTip="Import rksys.dat" Style="{StaticResource CompactButton}" Margin="0,0,8,8" Click="ImportSaveButton_OnClick"/>
                                                    <Button Content="Export" ToolTip="Export current save" Style="{StaticResource CompactButton}" Margin="0,0,0,8" Click="ExportSaveButton_OnClick"/>
                                                    <Button Content="Folder" ToolTip="Open save folder" Style="{StaticResource CompactButton}" Margin="0,0,8,8" Click="OpenSavesFolderButton_OnClick"/>
                                                    <Button Content="Friends" ToolTip="Open friend management" Style="{StaticResource CompactButton}" Margin="0,0,0,8" Click="OpenFriendsViewButton_OnClick"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource GlassCard}" Padding="18" AllowDrop="True" DragOver="MiiDropZone_DragOver" Drop="MiiDropZone_Drop" Margin="0,0,0,18">
                                             <StackPanel>
                                                 <Grid Margin="0,0,0,12">
                                                     <TextBlock Text="My Miis" FontSize="18" FontWeight="Black"/>
                                                     <WrapPanel HorizontalAlignment="Right">
                                                         <Button Content="Import" ToolTip="Import .mii, .miigx, .mae" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="ImportMiiButton_OnClick"/>
                                                         <Button Content="Edit" ToolTip="Open the visual Mii editor" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" Click="EditMiiButton_OnClick"/>
                                                         <Button Content="Export" ToolTip="Export selected Mii profile" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="ExportMiiButton_OnClick"/>
                                                         <Button Content="Copy" ToolTip="Duplicate selected Mii" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="DuplicateMiiButton_OnClick"/>
                                                         <Button Content="Delete" ToolTip="Delete selected launcher Mii" Style="{StaticResource CompactButton}" Click="DeleteMiiButton_OnClick"/>
                                                     </WrapPanel>
                                                 </Grid>

                                                 <ListBox x:Name="MiiCardsListBox"
                                                          MinHeight="116"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Padding="8"
                                                          ClipToBounds="False"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          SelectionChanged="MiiCardsListBox_SelectionChanged"
                                                          MouseDoubleClick="MiiCardsListBox_MouseDoubleClick"
                                                          PreviewMouseWheel="MiiCardsListBox_PreviewMouseWheel">
                                                     <ListBox.Template>
                                                         <ControlTemplate TargetType="ListBox">
                                                             <Border Name="Bd" Background="Transparent" BorderThickness="0" ClipToBounds="False">
                                                                 <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="false" ClipToBounds="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                                                                     <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                                 </ScrollViewer>
                                                             </Border>
                                                         </ControlTemplate>
                                                     </ListBox.Template>
                                                     <ListBox.ItemsPanel>
                                                         <ItemsPanelTemplate>
                                                             <WrapPanel/>
                                                         </ItemsPanelTemplate>
                                                     </ListBox.ItemsPanel>
                                                     <ListBox.ItemContainerStyle>
                                                         <Style TargetType="ListBoxItem">
                                                             <Setter Property="Padding" Value="0"/>
                                                             <Setter Property="Margin" Value="6"/>
                                                             <Setter Property="Background" Value="Transparent"/>
                                                             <Setter Property="BorderThickness" Value="0"/>
                                                             <Setter Property="Template">
                                                                 <Setter.Value>
                                                                     <ControlTemplate TargetType="ListBoxItem">
                                                                         <Border x:Name="Root" Background="Transparent" CornerRadius="12">
                                                                             <ContentPresenter/>
                                                                         </Border>
                                                                     </ControlTemplate>
                                                                 </Setter.Value>
                                                             </Setter>
                                                         </Style>
                                                     </ListBox.ItemContainerStyle>
                                                     <ListBox.ItemTemplate>
                                                         <DataTemplate>
                                                             <Grid Margin="2">
                                                                 <!-- Dynamic Glow Border behind the main card -->
                                                                 <Border x:Name="GlowBorder" CornerRadius="14" Background="{Binding FavoriteColor}" Opacity="0" Margin="-3">
                                                                     <Border.Effect>
                                                                         <BlurEffect Radius="10"/>
                                                                     </Border.Effect>
                                                                 </Border>

                                                                 <!-- Main Mii Card -->
                                                                 <Border x:Name="CardBorder" Width="140" Padding="12" CornerRadius="12" BorderBrush="{Binding FavoriteColor}" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                                                     <Border.Background>
                                                                         <SolidColorBrush Color="#131C30"/>
                                                                     </Border.Background>
                                                                     <Border.RenderTransform>
                                                                         <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                                                     </Border.RenderTransform>
                                                                     <Grid>
                                                                         <Grid.RowDefinitions>
                                                                             <RowDefinition Height="Auto"/>
                                                                             <RowDefinition Height="*"/>
                                                                         </Grid.RowDefinitions>

                                                                         <!-- Large Mii Preview Avatar -->
                                                                         <Border Width="84" Height="84" CornerRadius="16" Background="#0C1222" BorderBrush="#2F426F" BorderThickness="1.5" HorizontalAlignment="Center" ClipToBounds="True" Margin="0,0,0,12">
                                                                             <Grid ClipToBounds="True">
                                                                                 <!-- Avatar Image -->
                                                                                 <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill">
                                                                                     <Image.Style>
                                                                                         <Style TargetType="Image">
                                                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                                                             <Style.Triggers>
                                                                                                 <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                                                 </DataTrigger>
                                                                                             </Style.Triggers>
                                                                                         </Style>
                                                                                     </Image.Style>
                                                                                 </Image>

                                                                                 <!-- Text Placeholder when image is not rendered yet -->
                                                                                 <TextBlock Text="{Binding AvatarInitial}" Foreground="{StaticResource TextFaint}" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                     <TextBlock.Style>
                                                                                         <Style TargetType="TextBlock">
                                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                                             <Style.Triggers>
                                                                                                 <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                 </DataTrigger>
                                                                                             </Style.Triggers>
                                                                                         </Style>
                                                                                     </TextBlock.Style>
                                                                                 </TextBlock>
                                                                             </Grid>
                                                                         </Border>

                                                                         <!-- Details -->
                                                                         <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                             <!-- Mii Name -->
                                                                             <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                                                             <!-- Creator Name -->
                                                                             <TextBlock Text="{Binding CreatorName}" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                                             <!-- Status (Only visible if not rendered) -->
                                                                             <TextBlock Text="{Binding RenderStatusText}" Foreground="{StaticResource TextFaint}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                                                 <TextBlock.Style>
                                                                                     <Style TargetType="TextBlock">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                         <Style.Triggers>
                                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                             </DataTrigger>
                                                                                         </Style.Triggers>
                                                                                     </Style>
                                                                                 </TextBlock.Style>
                                                                             </TextBlock>
                                                                         </StackPanel>
                                                                     </Grid>
                                                                 </Border>
                                                             </Grid>
                                                             <DataTemplate.Triggers>
                                                                 <!-- Hover Trigger -->
                                                                 <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                     <DataTrigger.EnterActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1C2744" Duration="0:0:0.18"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.EnterActions>
                                                                     <DataTrigger.ExitActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#131C30" Duration="0:0:0.18"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.ExitActions>
                                                                 </DataTrigger>

                                                                 <!-- Selected Trigger -->
                                                                 <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                     <DataTrigger.EnterActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.15">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#25355C" Duration="0:0:0.15"/>
                                                                                 <ThicknessAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness" To="2.5" Duration="0:0:0.15"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.EnterActions>
                                                                     <DataTrigger.ExitActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#131C30" Duration="0:0:0.18"/>
                                                                                 <ThicknessAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness" To="1.5" Duration="0:0:0.18"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.ExitActions>
                                                                 </DataTrigger>

                                                                 <!-- Pressed (IsMouseCaptured) Trigger for tactile click feedback -->
                                                                 <DataTrigger Binding="{Binding IsMouseCaptured, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                     <DataTrigger.EnterActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.EnterActions>
                                                                     <DataTrigger.ExitActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.ExitActions>
                                                                 </DataTrigger>
                                                             </DataTemplate.Triggers>
                                                         </DataTemplate>
                                                     </ListBox.ItemTemplate>
                                                 </ListBox>
                                             </StackPanel>
                                         </Border>

                                        <Border Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="Save Recovery" FontSize="18" FontWeight="Black"/>
                                                <TextBlock Text="Recent backups are restored with an automatic safety backup first." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,12"/>
                                                <ComboBox x:Name="BackupRestoreComboBox" Style="{StaticResource CustomComboBox}" Height="38"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="FriendsView" Visibility="Collapsed">
                                    <StackPanel MaxWidth="920" HorizontalAlignment="Center" Width="920">
                                        <!-- Placeholder when no Active License is selected -->
                                        <Grid Visibility="{Binding HasNoActiveLicense, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border Style="{StaticResource GlassCard}" Padding="32" Margin="0,0,0,18">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                    <TextBlock Text="SELECT ACTIVE LICENSE" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="You must select an active license before managing your friends locally." FontSize="13" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,8,0,24" TextAlignment="Center"/>
                                                    <Button Content="Go to Mii &amp; Licenses" Style="{StaticResource CompactPrimaryButton}" Width="200" Height="40" Click="SelectLicenseRedirect_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Friends Management Panel when Active License IS selected -->
                                        <Grid Visibility="{Binding HasActiveLicense, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <!-- Active License Info Card and Add Friend Input -->
                                                <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,18">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/> <!-- Active Profile details -->
                                                            <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                                            <ColumnDefinition Width="380"/>  <!-- Add Friend Form -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left side: Active License Details -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Mii Avatar -->
                                                            <Border Width="64" Height="64" CornerRadius="12" Background="#0B1020" BorderBrush="#365071" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <Image Source="{Binding ActiveLicense.AvatarImagePath}" Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ActiveLicense.HasAvatarImage}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <TextBlock Text="{Binding ActiveLicense.AvatarInitial}" TextAlignment="Center" Foreground="{StaticResource TextFaint}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ActiveLicense.HasAvatarImage}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="ACTIVE LICENSE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding ActiveLicense.DisplayName}" FontSize="18" FontWeight="Black" Margin="0,2,0,0"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <Border Background="#0C2A3D" BorderBrush="#1D4A6A" BorderThickness="1" Padding="6,2" CornerRadius="4">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="FC" FontSize="10" FontWeight="Black" Foreground="#39E7FF" Margin="0,0,4,0"/>
                                                                            <TextBlock Text="{Binding ActiveLicense.FriendCode}" FontSize="11" FontWeight="Bold" Foreground="#39E7FF" FontFamily="Consolas"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Right side: Add Friend Form -->
                                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                                            <StackPanel>
                                                                <TextBlock Text="ADD FRIEND" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                                                 <Grid>
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*"/>
                                                                         <ColumnDefinition Width="Auto"/>
                                                                     </Grid.ColumnDefinitions>
                                                                     <TextBox x:Name="FriendCodeTextBox" Text="{Binding FriendCodeInput, UpdateSourceTrigger=PropertyChanged}" 
                                                                              Style="{StaticResource PathTextBox}" 
                                                                              Height="36"/>
                                                                     <TextBlock IsHitTestVisible="False" Text="Friend Code (e.g. 1234-5678-9012)" VerticalAlignment="Center" Margin="14,0" Foreground="{StaticResource TextFaint}">
                                                                         <TextBlock.Style>
                                                                             <Style TargetType="TextBlock">
                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding Text, ElementName=FriendCodeTextBox}" Value="">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                     </DataTrigger>
                                                                                     <DataTrigger Binding="{Binding Text, ElementName=FriendCodeTextBox}" Value="{x:Null}">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </TextBlock.Style>
                                                                     </TextBlock>
                                                                     <Button Grid.Column="1" 
                                                                             Content="Add" 
                                                                             Style="{StaticResource PrimaryButton}" 
                                                                             Height="36" 
                                                                             Width="110"
                                                                             Padding="0"
                                                                             Margin="8,0,0,0" 
                                                                             Click="AddFriendButton_Click"/>
                                                                 </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                     </Grid>
                                                </Border>

                                                <!-- Friends List Content Grid -->
                                                <Grid>
                                                    <!-- Loading state -->
                                                    <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource SkeletonCard}" Height="76" Margin="0,0,0,10"/>
                                                            <Border Style="{StaticResource SkeletonCard}" Height="76" Margin="0,0,0,10"/>
                                                            <Border Style="{StaticResource SkeletonCard}" Height="76" Margin="0,0,0,10"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Error State -->
                                                    <Grid Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border Style="{StaticResource GlassCard}" Padding="24" BorderBrush="{StaticResource DangerBrush}" Margin="0,10">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                                <TextBlock Text="ERROR LOADING" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,18" TextAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Empty List Placeholder -->
                                                    <Grid Visibility="{Binding ShowEmptyPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border Style="{StaticResource GlassCard}" Padding="32" Margin="0,10">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                                <TextBlock Text="NO FRIENDS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="You haven't added any friends to this license yet. Add friend codes above!" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Main Friends List -->
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ShowEmptyPlaceholder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>

                                                        <StackPanel>
                                                            <!-- Count Header -->
                                                            <Grid Margin="12,0,12,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="FRIENDS LIST" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding FriendsList.Count}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                                    <TextBlock Text=" / 30 Friends" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,0"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Friends ItemsControl -->
                                                            <ItemsControl ItemsSource="{Binding FriendsList}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,10">
                                                                            <!-- Soft Glow Backdrop on Hover -->
                                                                            <Border x:Name="HoverGlow" CornerRadius="10" Background="{StaticResource RainbowGradient}" Opacity="0" Margin="-2">
                                                                                <Border.Effect>
                                                                                    <BlurEffect Radius="6"/>
                                                                                </Border.Effect>
                                                                            </Border>

                                                                            <Border x:Name="FriendItemCard" Style="{StaticResource GlassCard}" Padding="12" Margin="0" BorderBrush="#2B3855" BorderThickness="1">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="56"/>  <!-- Avatar -->
                                                                                        <ColumnDefinition Width="*"/>   <!-- Profile Details -->
                                                                                        <ColumnDefinition Width="200"/> <!-- Stats -->
                                                                                        <ColumnDefinition Width="50"/>  <!-- Remove Button -->
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- Avatar -->
                                                                                    <Border Width="44" Height="44" CornerRadius="22" Background="#0B1020" BorderBrush="#365071" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                        <Grid>
                                                                                            <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill">
                                                                                                <Image.Style>
                                                                                                    <Style TargetType="Image">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Image.Style>
                                                                                            </Image>
                                                                                            <TextBlock Text="{Binding AvatarInitial}" TextAlignment="Center" Foreground="{StaticResource TextFaint}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </Grid>
                                                                                    </Border>

                                                                                    <!-- Friend details -->
                                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                                                            
                                                                                            <!-- Status Badge -->
                                                                                            <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Background="#153827">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding Status}" Value="Online">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock Text="ONLINE" FontSize="9" FontWeight="Black" Foreground="#4DFFB0"/>
                                                                                            </Border>
                                                                                        </StackPanel>

                                                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                                            <TextBlock Text="FC: " Foreground="{StaticResource TextFaint}" FontSize="11"/>
                                                                                            <TextBlock Text="{Binding FriendCode}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontFamily="Consolas"/>
                                                                                            <TextBlock Text="   •   Mii: " Foreground="{StaticResource TextFaint}" FontSize="11"/>
                                                                                            <TextBlock Text="{Binding LocalMiiName}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>

                                                                                    <!-- Stats -->
                                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                                            <TextBlock Text="VR " Foreground="{StaticResource TextFaint}" FontSize="11"/>
                                                                                            <TextBlock Text="{Binding Vr}" Foreground="#00F2FF" FontWeight="Bold" FontSize="12"/>
                                                                                            <TextBlock Text="   BR " Foreground="{StaticResource TextFaint}" FontSize="11"/>
                                                                                            <TextBlock Text="{Binding Br}" Foreground="#FF6B6B" FontWeight="Bold" FontSize="12"/>
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{Binding StatsLine}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                                                                                    </StackPanel>

                                                                                    <!-- Delete Button -->
                                                                                    <Button Grid.Column="3" 
                                                                                            Style="{StaticResource ActionButton}" 
                                                                                            Foreground="{StaticResource DangerBrush}" 
                                                                                            Width="36" 
                                                                                            Height="36" 
                                                                                            Padding="0" 
                                                                                            Click="RemoveFriendButton_Click" 
                                                                                            ToolTip="Remove friend">
                                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                                                    </Button>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Grid>
                                                                        <DataTemplate.Triggers>
                                                                            <Trigger SourceName="FriendItemCard" Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="HoverGlow" Property="Opacity" Value="0.25"/>
                                                                                <Setter TargetName="FriendItemCard" Property="Background" Value="#1B253D"/>
                                                                                <Setter TargetName="FriendItemCard" Property="BorderBrush" Value="#3B4D73"/>
                                                                            </Trigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="SettingsView" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="SettingsSearchTextBox" Style="{StaticResource PathTextBox}" TextChanged="SettingsSearchTextBox_TextChanged"/>
                                                <TextBlock x:Name="SettingsSearchHintTextBlock" Grid.Column="1" Text="Launcher, game, graphics, audio, downloads, controller, network, accessibility" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="18,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="GamePathsSettingsCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="GAME PATHS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Text="Dolphin Emulator" FontWeight="Bold" Margin="0,14,0,7"/>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="94"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="DolphinPathTextBox" Style="{StaticResource PathTextBox}"/>
                                                    <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="BrowseDolphinButton_OnClick"/>
                                                </Grid>
                                                <TextBlock Text="Dolphin User Folder" FontWeight="Bold" Margin="0,0,0,7"/>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="94"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="UserFolderTextBox" Style="{StaticResource PathTextBox}"/>
                                                    <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="BrowseUserFolderButton_OnClick"/>
                                                </Grid>
                                                <TextBlock Text="Mario Kart Wii ROM" FontWeight="Bold" Margin="0,0,0,7"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="94"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="RomPathTextBox" Style="{StaticResource PathTextBox}"/>
                                                    <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="BrowseRomButton_OnClick"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Border x:Name="LauncherSettingsCard" Style="{StaticResource GlassCard}" Margin="0,0,10,18">
                                                    <StackPanel>
                                                        <TextBlock Text="LAUNCHER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                        <CheckBox x:Name="AutoUpdateCheckBox" Content="Check updates on startup" Margin="0,14,0,12" Checked="AutoUpdateSetting_Changed" Unchecked="AutoUpdateSetting_Changed"/>
                                                        <CheckBox x:Name="SeparateSaveDefaultCheckBox" Content="Separate savegame by default" Checked="SeparateSaveDefault_Changed" Unchecked="SeparateSaveDefault_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <Border x:Name="GameSettingsCard" Style="{StaticResource GlassCard}" Margin="0,0,10,18">
                                                    <StackPanel>
                                                        <TextBlock Text="GAME" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                        <Grid Margin="0,14,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,10,0">
                                                                <TextBlock Text="Textures (my stuff)" FontWeight="Bold" Margin="0,0,0,12"/>
                                                                <CheckBox x:Name="GraphicsTexturesCheckBox" Content="Enabled" Checked="GraphicsTextures_Changed" Unchecked="GraphicsTextures_Changed"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                <TextBlock Text="Launch save" FontWeight="Bold" Margin="0,0,0,12"/>
                                                                <CheckBox x:Name="SeparateSaveCheckBox" Content="Separate savegame" Checked="SeparateSave_Changed" Unchecked="SeparateSave_Changed"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="DebugView" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="DEBUG CONSOLE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock x:Name="DebugLogTextBlock" Text="Debug information will appear here." FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="3">
                                            <Button Content="Refresh state" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="RefreshDebugButton_OnClick"/>
                                            <Button Content="Open settings file" Style="{StaticResource ActionButton}" Margin="4,0" Click="OpenSettingsFileButton_OnClick"/>
                                            <Button Content="Open preferences file" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="OpenPreferencesFileButton_OnClick"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="ToastBorder"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="360"
                    Margin="0,0,28,28"
                    Padding="16"
                    CornerRadius="8"
                    Background="#F012192A"
                    BorderBrush="#3B4C72"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Opacity="0"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock x:Name="ToastTitleTextBlock" Text="VanzaKart" FontSize="13" FontWeight="Bold"/>
                    <TextBlock x:Name="ToastMessageTextBlock" Text="" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
