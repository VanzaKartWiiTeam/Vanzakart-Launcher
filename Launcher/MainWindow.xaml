                                                            <Grid Margin="4,3"><TextBlock Text="⬅️ Left" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox x:Name="SimpleBind_DPadLeft" Style="{StaticResource BindingTextBox}" Width="100" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
