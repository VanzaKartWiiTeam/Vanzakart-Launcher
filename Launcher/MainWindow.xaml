                                                            <Grid Margin="0,3"><TextBlock Text="Right" VerticalAlignment="Center"/><TextBox x:Name="Bind_MainRight" Style="{StaticResource BindingTextBox}" Width="120" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- C-Stick / Triggers Group -->
                                                    <Border Background="#101726" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                                        <StackPanel x:Name="Group_Secondary">
                                                            <TextBlock Text="C-STICK &amp; TRIGGERS" FontWeight="Bold" Foreground="#00F2FF" Margin="0,0,0,8"/>
                                                            <Grid Margin="0,3"><TextBlock Text="C-Stick Up" VerticalAlignment="Center"/><TextBox x:Name="Bind_CUp" Style="{StaticResource BindingTextBox}" Width="120" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
