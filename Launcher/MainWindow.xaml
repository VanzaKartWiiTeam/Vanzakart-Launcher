                                                            <Grid Margin="0,3"><TextBlock Text="Button B" VerticalAlignment="Center"/><TextBox x:Name="Bind_B" Style="{StaticResource BindingTextBox}" Width="120" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                            <Grid Margin="0,3"><TextBlock Text="Button X" VerticalAlignment="Center"/><TextBox x:Name="Bind_X" Style="{StaticResource BindingTextBox}" Width="120" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
