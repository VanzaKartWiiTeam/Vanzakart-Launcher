                                <UniformGrid Columns="2">
                                    <Button Content="Discord" Style="{StaticResource ActionButton}" Padding="8" FontSize="12" Margin="0,0,5,0" Click="OpenDiscordBorder_OnClick"/>
                                    <Button Content="Website" Style="{StaticResource ActionButton}" Padding="8" FontSize="12" Margin="5,0,0,0" Click="OpenWebsiteButton_OnClick"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="26,18,26,24">
