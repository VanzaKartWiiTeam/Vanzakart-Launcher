                                                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                                        <TextBlock x:Name="HomeUpdateCheckTextBlock" Text="No check performed yet." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                                                        <Button Style="{StaticResource CompactButton}" Margin="0,0,10,10" Click="CheckUpdatesButton_OnClick">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Check Updates" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource CompactPrimaryButton}" Margin="0,0,10,10" Click="InstallButton_OnClick">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE118;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Update Mod" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource CompactButton}" Margin="0,0,0,10" Click="RepairModButton_OnClick">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Repair" VerticalAlignment="Center" UseLayoutRounding="True" FontWeight="Bold" FontSize="14"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                 </Grid>

                                 <!-- ==================================================
                                      ROOMS VIEW
                                      ================================================== -->
                                 <Grid x:Name="RoomsView" Visibility="Collapsed" Margin="0,0,0,10" ClipToBounds="False">
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="*"/>
                                     </Grid.RowDefinitions>

                                     <!-- HERO STATISTICS CARD -->
                                     <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="0" Margin="0,0,0,18" ClipToBounds="True">
                                         <Grid MinHeight="100">
                                             <!-- Rainbow ambient overlay -->
                                             <Border CornerRadius="15" Opacity="0.08">
                                                 <Border.Background>
                                                     <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                         <GradientStop Color="#FF0066" Offset="0.0"/>
                                                         <GradientStop Color="#00F2FF" Offset="0.5"/>
                                                         <GradientStop Color="#B000FF" Offset="1.0"/>
                                                     </LinearGradientBrush>
                                                 </Border.Background>
                                             </Border>

                                             <UniformGrid Columns="4" Margin="24,14">
                                                 <!-- Active Rooms -->
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="ACTIVE ROOMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding ActiveRoomsCount, FallbackValue=0}" FontSize="32" FontWeight="Black" Foreground="#FFD166" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                         <TextBlock.Effect>
                                                             <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FFD166" Opacity="0.5"/>
                                                         </TextBlock.Effect>
                                                     </TextBlock>
                                                 </StackPanel>

                                                 <!-- Online Players -->
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="PLAYERS ONLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding OnlinePlayersCount, FallbackValue=0}" FontSize="32" FontWeight="Black" Foreground="#00F2FF" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                         <TextBlock.Effect>
                                                             <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00F2FF" Opacity="0.5"/>
                                                         </TextBlock.Effect>
                                                     </TextBlock>
                                                 </StackPanel>

                                                 <!-- Server Status -->
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="SERVER STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                         <!-- Glowing online dot -->
                                                         <Ellipse Width="10" Height="10" Fill="#4DFFB0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                             <Ellipse.Effect>
                                                                 <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#4DFFB0" Opacity="0.8"/>
                                                             </Ellipse.Effect>
                                                         </Ellipse>
                                                         <TextBlock Text="{Binding ServerStatus, FallbackValue=ONLINE}" FontSize="18" FontWeight="Bold" Foreground="#4DFFB0" VerticalAlignment="Center"/>
                                                     </StackPanel>
                                                 </StackPanel>

                                                 <!-- Last Updated -->
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="LAST UPDATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding LastUpdatedText, FallbackValue='--:--:--'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                 </StackPanel>
                                             </UniformGrid>
                                         </Grid>
                                     </Border>

                                     <!-- MAIN ROOM CONTENT (GRID ROW 1) -->
                                     <Grid Grid.Row="1" MinHeight="400">

                                         <!-- SKELETON LOADING STATE -->
                                         <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <WrapPanel Orientation="Horizontal">
                                                 <Border Style="{StaticResource SkeletonCard}" Width="290" Height="176" Margin="0,0,14,14"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Width="290" Height="176" Margin="0,0,14,14"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Width="290" Height="176" Margin="0,0,14,14"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Width="290" Height="176" Margin="0,0,14,14"/>
                                             </WrapPanel>
                                         </Grid>

                                         <!-- EMPTY STATE -->
                                         <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <Border Style="{StaticResource GlassCard}" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,10">
                                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <TextBlock Text="&#xF133;" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                     <TextBlock Text="NO ACTIVE ROOMS" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="There are no active multiplayer rooms at the moment. Launch the game and create a room to start!" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,24" TextAlignment="Center" MaxWidth="450" TextWrapping="Wrap"/>
                                                     <Button Content="Refresh Rooms" Style="{StaticResource ActionButton}" Width="160" Padding="12" Click="RoomsRefresh_Click"/>
                                                 </StackPanel>
                                             </Border>
                                         </Grid>

                                         <!-- ERROR STATE -->
                                         <Grid Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <Border Style="{StaticResource GlassCard}" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,10" BorderBrush="{StaticResource DangerBrush}">
                                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                     <TextBlock Text="CONNECTION ERROR" FontSize="18" FontWeight="Black" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,24" TextAlignment="Center" MaxWidth="500" TextWrapping="Wrap"/>
                                                     <Button Content="Retry Connection" Style="{StaticResource ActionButton}" Width="180" Padding="12" Click="RoomsRefresh_Click"/>
                                                 </StackPanel>
                                             </Border>
                                         </Grid>

                                         <!-- DATA STATE (ROOMS LIST) -->
                                         <Grid ClipToBounds="False">
                                             <Grid.Style>
                                                 <Style TargetType="Grid">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding HasError}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Grid.Style>

                                             <!-- Scrollable WrapPanel for cards -->
                                             <ItemsControl ItemsSource="{Binding Rooms}" ClipToBounds="False" Margin="8">
                                                 <ItemsControl.ItemsPanel>
                                                     <ItemsPanelTemplate>
                                                         <WrapPanel Orientation="Horizontal" ClipToBounds="False"/>
                                                     </ItemsPanelTemplate>
                                                 </ItemsControl.ItemsPanel>
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Border Style="{StaticResource RoomCardBorder}">
                                                             <Grid>
                                                                 <Grid.RowDefinitions>
                                                                     <RowDefinition Height="Auto"/>
                                                                     <RowDefinition Height="*"/>
                                                                     <RowDefinition Height="Auto"/>
                                                                 </Grid.RowDefinitions>

                                                                 <!-- Card Header -->
                                                                 <Grid Grid.Row="0">
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*"/>
                                                                         <ColumnDefinition Width="Auto"/>
                                                                     </Grid.ColumnDefinitions>
                                                                     <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                                                                     <!-- Player Count Pill -->
                                                                     <Border Grid.Column="1" Background="#202A42" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                                                         <TextBlock Text="{Binding DisplayPlayerCount}" FontSize="11.5" FontWeight="Bold" Foreground="#39E7FF"/>
                                                                     </Border>
                                                                 </Grid>

                                                                 <!-- Card Body (Current Track & Info) -->
                                                                 <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0">
                                                                     <TextBlock Text="CURRENT TRACK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextFaint}"/>
                                                                     <TextBlock Text="{Binding Track}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                     <TextBlock Text="{Binding Mode}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,4,0,0"/>
                                                                 </StackPanel>

                                                                 <!-- Card Footer -->
                                                                 <Grid Grid.Row="2" Margin="0,8,0,0">
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*"/>
                                                                         <ColumnDefinition Width="Auto"/>
                                                                     </Grid.ColumnDefinitions>

                                                                     <TextBlock Text="{Binding Region}" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Grid.Column="0"/>
                                                                     
                                                                     <!-- Game status badge -->
                                                                     <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                                                         <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                                                             <Ellipse.Style>
                                                                                 <Style TargetType="Ellipse">
                                                                                     <Setter Property="Fill" Value="#FFD166"/>
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding IsRacing}" Value="True">
                                                                                             <Setter Property="Fill" Value="#4DFFB0"/>
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Ellipse.Style>
                                                                         </Ellipse>
                                                                         <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                             <TextBlock.Style>
                                                                                 <Style TargetType="TextBlock">
                                                                                     <Setter Property="Foreground" Value="#FFD166"/>
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding IsRacing}" Value="True">
                                                                                             <Setter Property="Foreground" Value="#4DFFB0"/>
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </TextBlock.Style>
                                                                         </TextBlock>
                                                                     </StackPanel>
                                                                 </Grid>
                                                             </Grid>
                                                         </Border>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </Grid>
                                     </Grid>
                                 </Grid>

                                 <!-- ==================================================
                                      LEADERBOARD VIEW
                                      ================================================== -->
                                 <Grid x:Name="LeaderboardView" Visibility="Collapsed" Margin="0,0,0,10" ClipToBounds="False">
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/> <!-- Podium -->
                                         <RowDefinition Height="Auto"/> <!-- Filter toolbar -->
                                         <RowDefinition Height="*"/>    <!-- Classifica completa -->
                                     </Grid.RowDefinitions>

                                     <!-- TOP 3 PODIUM -->
                                     <Grid Grid.Row="0" Margin="0,38,0,30" MinHeight="348" ClipToBounds="False">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>   <!-- 2nd Place -->
                                             <ColumnDefinition Width="1.1*"/> <!-- 1st Place -->
                                             <ColumnDefinition Width="*"/>   <!-- 3rd Place -->
                                         </Grid.ColumnDefinitions>

                                         <!-- Premium ambient glow behind the podium -->
                                         <Border Grid.ColumnSpan="3" CornerRadius="34" Margin="16,42,16,6" Opacity="0.28" IsHitTestVisible="False">
                                             <Border.Background>
                                                 <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.25" RadiusX="0.75" RadiusY="0.85">
                                                     <GradientStop Color="#AAFFD166" Offset="0"/>
                                                     <GradientStop Color="#5539E7FF" Offset="0.42"/>
                                                     <GradientStop Color="#2210182E" Offset="1"/>
                                                 </RadialGradientBrush>
                                             </Border.Background>
                                             <Border.Effect>
                                                 <BlurEffect Radius="24"/>
                                             </Border.Effect>
                                         </Border>

                                         <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Margin="42,0,42,0" Opacity="0.55" IsHitTestVisible="False">
                                             <Border.Background>
                                                 <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                     <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                     <GradientStop Color="#66FFD166" Offset="0.5"/>
                                                     <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                 </LinearGradientBrush>
                                             </Border.Background>
                                         </Border>

                                         <!-- 2° POSTO (SINISTRA) -->
                                         <Border Grid.Column="0" Style="{StaticResource Podium2CardStyle}" Padding="18" Height="282" Margin="0,44,12,0" VerticalAlignment="Bottom">
                                             <Border.Background>
                                                 <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                     <GradientStop Color="#EE19243B" Offset="0"/>
                                                     <GradientStop Color="#DD101827" Offset="1"/>
                                                 </LinearGradientBrush>
                                             </Border.Background>
                                             <Border.Effect>
                                                 <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#C0C0C0" Opacity="0.26"/>
                                             </Border.Effect>
                                             <Grid DataContext="{Binding Top2}">
                                                 <Grid.Style>
                                                     <Style TargetType="Grid">
                                                         <Setter Property="Visibility" Value="Visible"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                 <Setter Property="Visibility" Value="Hidden"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Grid.Style>
                                                 <StackPanel VerticalAlignment="Center">
                                                     <!-- Circle badge for position -->
                                                     <Border Width="34" Height="34" CornerRadius="17" Background="#AAC0C0C0" BorderBrush="#EEFFFFFF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,9">
                                                         <TextBlock Text="2" FontSize="15" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                     <!-- Mii Avatar / Initials Avatar -->
                                                     <Border Width="80" Height="80" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True">
                                                         <Border.Background>
                                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                 <GradientStop Color="{Binding AvatarGradientStart, FallbackValue=#00F2FF}" Offset="0"/>
                                                                 <GradientStop Color="{Binding AvatarGradientEnd, FallbackValue=#B000FF}" Offset="1"/>
                                                             </LinearGradientBrush>
                                                         </Border.Background>
                                                         <Grid>
                                                             <TextBlock Text="{Binding AvatarInitial, FallbackValue=?}" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                 <TextBlock.Style>
                                                                     <Style TargetType="TextBlock">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </TextBlock.Style>
                                                             </TextBlock>
                                                             <Image Source="{Binding AvatarImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                                 <Image.RenderTransform>
                                                                     <ScaleTransform ScaleX="1.28" ScaleY="1.28"/>
                                                                 </Image.RenderTransform>
                                                                 <Image.Style>
                                                                     <Style TargetType="Image">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Image.Style>
                                                             </Image>
                                                         </Grid>
                                                     </Border>
                                                     <TextBlock Text="{Binding Name, FallbackValue=Player}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                      <TextBlock Text="{Binding DisplayPoints, FallbackValue='0 VR'}" FontSize="12" FontWeight="SemiBold" Foreground="#39E7FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                      <TextBlock Text="{Binding GamesStatsLine}" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                      <Image Source="{Binding RankImageUrl}" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                          <Image.Style>
                                                              <Style TargetType="Image">
                                                                  <Setter Property="Visibility" Value="Collapsed"/>
                                                                  <Style.Triggers>
                                                                      <DataTrigger Binding="{Binding HasRankImage}" Value="True">
                                                                          <Setter Property="Visibility" Value="Visible"/>
                                                                      </DataTrigger>
                                                                  </Style.Triggers>
                                                              </Style>
                                                          </Image.Style>
                                                      </Image>
                                                     <TextBlock Text="{Binding FriendCode}" FontSize="10.5" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>

                                         <!-- 1° POSTO (CENTRO) -->
                                         <Border Grid.Column="1" Style="{StaticResource Podium1CardStyle}" Padding="16" Height="352" Margin="12,0,12,0" VerticalAlignment="Bottom">
                                             <Border.Background>
                                                 <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                     <GradientStop Color="#F02A2032" Offset="0"/>
                                                     <GradientStop Color="#E8121828" Offset="0.62"/>
                                                     <GradientStop Color="#D90C111E" Offset="1"/>
                                                 </LinearGradientBrush>
                                             </Border.Background>
                                             <Border.Effect>
                                                 <DropShadowEffect BlurRadius="42" ShadowDepth="0" Color="#FFD166" Opacity="0.45"/>
                                             </Border.Effect>
                                             <Grid DataContext="{Binding Top1}">
                                                 <Grid.Style>
                                                     <Style TargetType="Grid">
                                                         <Setter Property="Visibility" Value="Visible"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                 <Setter Property="Visibility" Value="Hidden"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Grid.Style>
                                                 <StackPanel VerticalAlignment="Center">
                                                     <!-- Trophy/Position Badge (coppa) -->
                                                     <Border Width="42" Height="42" CornerRadius="21" Background="#FFD166" BorderBrush="#FFFFF2B8" BorderThickness="1.4" HorizontalAlignment="Center" Margin="0,0,0,9">
                                                         <Border.Effect>
                                                             <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#FFD166" Opacity="0.85"/>
                                                         </Border.Effect>
                                                         <TextBlock Text="1" FontSize="20" FontWeight="Black" Foreground="#171008" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                     <!-- Mii Avatar / Initials Avatar -->
                                                     <Border Width="102" Height="102" CornerRadius="51" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True" BorderBrush="#88FFD166" BorderThickness="2">
                                                         <Border.Background>
                                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                 <GradientStop Color="{Binding AvatarGradientStart, FallbackValue=#FF0066}" Offset="0"/>
                                                                 <GradientStop Color="{Binding AvatarGradientEnd, FallbackValue=#FF7A00}" Offset="1"/>
                                                             </LinearGradientBrush>
                                                         </Border.Background>
                                                         <Grid>
                                                             <TextBlock Text="{Binding AvatarInitial, FallbackValue=?}" FontSize="32" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                 <TextBlock.Style>
                                                                     <Style TargetType="TextBlock">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </TextBlock.Style>
                                                             </TextBlock>
                                                             <Image Source="{Binding AvatarImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                                 <Image.RenderTransform>
                                                                     <ScaleTransform ScaleX="1.28" ScaleY="1.28"/>
                                                                 </Image.RenderTransform>
                                                                 <Image.Style>
                                                                     <Style TargetType="Image">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Image.Style>
                                                             </Image>
                                                         </Grid>
                                                     </Border>
                                                     <TextBlock Text="{Binding Name, FallbackValue=Player}" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                                     <TextBlock Text="{Binding DisplayPoints, FallbackValue='0 VR'}" FontSize="13.5" FontWeight="Bold" Foreground="#FFD166" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                         <TextBlock.Effect>
                                                             <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFD166" Opacity="0.5"/>
                                                         </TextBlock.Effect>
                                                     </TextBlock>
                                                     <TextBlock Text="{Binding GamesStatsLine}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                     <Image Source="{Binding RankImageUrl}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                         <Image.Style>
                                                             <Style TargetType="Image">
                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding HasRankImage}" Value="True">
                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Image.Style>
                                                     </Image>
                                                     <TextBlock Text="{Binding FriendCode}" FontSize="11" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>

                                         <!-- 3° POSTO (DESTRA) -->
                                         <Border Grid.Column="2" Style="{StaticResource Podium3CardStyle}" Padding="18" Height="282" Margin="12,44,0,0" VerticalAlignment="Bottom">
                                             <Border.Background>
                                                 <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                     <GradientStop Color="#EE211D32" Offset="0"/>
                                                     <GradientStop Color="#DD101827" Offset="1"/>
                                                 </LinearGradientBrush>
                                             </Border.Background>
                                             <Border.Effect>
                                                 <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#CD7F32" Opacity="0.26"/>
                                             </Border.Effect>
                                             <Grid DataContext="{Binding Top3}">
                                                 <Grid.Style>
                                                     <Style TargetType="Grid">
                                                         <Setter Property="Visibility" Value="Visible"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                 <Setter Property="Visibility" Value="Hidden"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Grid.Style>
                                                 <StackPanel VerticalAlignment="Center">
                                                     <!-- Circle badge for position -->
                                                     <Border Width="34" Height="34" CornerRadius="17" Background="#AACD7F32" BorderBrush="#EED9A066" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,9">
                                                         <TextBlock Text="3" FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                     <!-- Mii Avatar / Initials Avatar -->
                                                     <Border Width="80" Height="80" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True">
                                                         <Border.Background>
                                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                 <GradientStop Color="{Binding AvatarGradientStart, FallbackValue=#00FF66}" Offset="0"/>
                                                                 <GradientStop Color="{Binding AvatarGradientEnd, FallbackValue=#00F2FF}" Offset="1"/>
                                                             </LinearGradientBrush>
                                                         </Border.Background>
                                                         <Grid>
                                                             <TextBlock Text="{Binding AvatarInitial, FallbackValue=?}" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                 <TextBlock.Style>
                                                                     <Style TargetType="TextBlock">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </TextBlock.Style>
                                                             </TextBlock>
                                                             <Image Source="{Binding AvatarImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                                 <Image.RenderTransform>
                                                                     <ScaleTransform ScaleX="1.28" ScaleY="1.28"/>
                                                                 </Image.RenderTransform>
                                                                 <Image.Style>
                                                                     <Style TargetType="Image">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Image.Style>
                                                             </Image>
                                                         </Grid>
                                                     </Border>
                                                     <TextBlock Text="{Binding Name, FallbackValue=Player}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                      <TextBlock Text="{Binding DisplayPoints, FallbackValue='0 VR'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#39E7FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                      <TextBlock Text="{Binding GamesStatsLine}" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                      <Image Source="{Binding RankImageUrl}" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                          <Image.Style>
                                                              <Style TargetType="Image">
                                                                  <Setter Property="Visibility" Value="Collapsed"/>
                                                                  <Style.Triggers>
                                                                      <DataTrigger Binding="{Binding HasRankImage}" Value="True">
                                                                          <Setter Property="Visibility" Value="Visible"/>
                                                                      </DataTrigger>
                                                                  </Style.Triggers>
                                                              </Style>
                                                          </Image.Style>
                                                      </Image>
                                                     <TextBlock Text="{Binding FriendCode}" FontSize="10.5" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>
                                     </Grid>

                                     <!-- FILTER TOOLBAR (ROW 1) -->
                                     <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,16">
                                         <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*"/>      <!-- Search -->
                                                 <ColumnDefinition Width="Auto"/>   <!-- Sort combo -->
                                                 <ColumnDefinition Width="Auto"/>   <!-- Reload button -->
                                             </Grid.ColumnDefinitions>

                                             <!-- Search input -->
                                             <Border Background="{StaticResource InputBrush}" CornerRadius="8" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Grid.Column="0" Height="36" Margin="0,0,10,0">
                                                 <Grid Margin="10,0">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <TextBlock Text="&#xE11A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                     <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" VerticalContentAlignment="Center" Grid.Column="1" FontSize="13"/>
                                                 </Grid>
                                             </Border>

                                             <!-- Sort combo -->
                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                 <Border Background="#18243A" BorderBrush="#2F4266" BorderThickness="1" CornerRadius="8" Padding="9,0" Height="36" Margin="0,0,8,0">
                                                     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                         <TextBlock Text="RANK BY" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                         <TextBlock Text="{Binding SelectedSort}" FontSize="12" FontWeight="Bold" Foreground="#39E7FF" VerticalAlignment="Center"/>
                                                     </StackPanel>
                                                 </Border>
                                                 <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" Style="{StaticResource CustomComboBox}" Width="150" Height="36" VerticalContentAlignment="Center"/>
                                             </StackPanel>

                                             <!-- Manual Reload Button -->
                                             <Button Content="&#xE149;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ActionButton}" Padding="0" Width="36" Height="36" FontSize="14" Grid.Column="2" Click="LeaderboardRefresh_Click" ToolTip="Reload Rankings"/>
                                         </Grid>
                                     </Border>

                                     <!-- CLASSIFICA COMPLETA (ROW 2) -->
                                     <Grid Grid.Row="2" MinHeight="250">
                                         <!-- Loading state -->
                                         <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <StackPanel>
                                                 <Border Style="{StaticResource SkeletonCard}" Height="48" Margin="0,0,0,10"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Height="48" Margin="0,0,0,10"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Height="48" Margin="0,0,0,10"/>
                                                 <Border Style="{StaticResource SkeletonCard}" Height="48" Margin="0,0,0,10"/>
                                             </StackPanel>
                                         </Grid>

                                         <!-- Error State -->
                                         <Grid Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <Border Style="{StaticResource GlassCard}" Padding="24" BorderBrush="{StaticResource DangerBrush}" Margin="0,10">
                                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                     <TextBlock Text="COULD NOT LOAD LEADERBOARD" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,18" TextAlignment="Center"/>
                                                     <Button Content="Retry" Style="{StaticResource ActionButton}" Width="120" Padding="10" Click="LeaderboardRefresh_Click"/>
                                                 </StackPanel>
                                             </Border>
                                         </Grid>

                                         <!-- Rankings List -->
                                         <Grid>
                                             <Grid.Style>
                                                 <Style TargetType="Grid">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding HasError}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Grid.Style>

                                             <DockPanel>
                                                 <!-- Column Headers -->
                                                 <Grid DockPanel.Dock="Top" Margin="14,0,14,8">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="40"/>  <!-- POS -->
                                                         <ColumnDefinition Width="56"/>  <!-- Avatar -->
                                                         <ColumnDefinition Width="*"/>   <!-- Player Name -->
                                                         <ColumnDefinition Width="80"/>  <!-- VR -->
                                                         <ColumnDefinition Width="55"/>  <!-- WINS -->
                                                         <ColumnDefinition Width="55"/>  <!-- GAMES -->
                                                         <ColumnDefinition Width="60"/>  <!-- WIN % -->
                                                         <ColumnDefinition Width="45"/>  <!-- Rank -->
                                                         <ColumnDefinition Width="65"/>  <!-- 24h -->
                                                         <ColumnDefinition Width="100"/> <!-- Last seen -->
                                                     </Grid.ColumnDefinitions>
                                                     
                                                     <TextBlock Text="POS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="0"/>
                                                     <TextBlock Text="PLAYER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>
                                                     <TextBlock Text="VR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="3"/>
                                                     <TextBlock Text="WINS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="4"/>
                                                     <TextBlock Text="GAMES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="5"/>
                                                     <TextBlock Text="WIN %" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="6"/>
                                                     <TextBlock Text="RANK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="7"/>
                                                     <TextBlock Text="24H" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="8"/>
                                                     <TextBlock Text="LAST SEEN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Grid.Column="9"/>
                                                 </Grid>
                                                 
                                                 <!-- Scrollable List of Ranks -->
                                                 <ItemsControl ItemsSource="{Binding Players}">
                                                 <ItemsControl.ItemsPanel>
                                                     <ItemsPanelTemplate>
                                                         <VirtualizingStackPanel/>
                                                     </ItemsPanelTemplate>
                                                 </ItemsControl.ItemsPanel>
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Border Style="{StaticResource LeaderboardRowBorder}">
                                                             <Grid>
                                                                 <Grid.ColumnDefinitions>
                                                                     <ColumnDefinition Width="40"/>  <!-- Position -->
                                                                     <ColumnDefinition Width="56"/>  <!-- Avatar -->
                                                                     <ColumnDefinition Width="*"/>   <!-- Player Name -->
                                                                     <ColumnDefinition Width="80"/>  <!-- Points -->
                                                                     <ColumnDefinition Width="55"/>  <!-- Wins -->
                                                                     <ColumnDefinition Width="55"/>  <!-- Games -->
                                                                     <ColumnDefinition Width="60"/>  <!-- Win % -->
                                                                     <ColumnDefinition Width="45"/>  <!-- Rank -->
                                                                     <ColumnDefinition Width="65"/>  <!-- 24h -->
                                                                     <ColumnDefinition Width="100"/> <!-- Last seen -->
                                                                 </Grid.ColumnDefinitions>

                                                                 <!-- Position -->
                                                                 <TextBlock Text="{Binding DisplayPosition}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">
                                                                     <TextBlock.Style>
                                                                         <Style TargetType="TextBlock">
                                                                             <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                                             <Style.Triggers>
                                                                                 <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                                     <Setter Property="Foreground" Value="#00F2FF"/>
                                                                                 </DataTrigger>
                                                                             </Style.Triggers>
                                                                         </Style>
                                                                     </TextBlock.Style>
                                                                 </TextBlock>

                                                                 <!-- Avatar -->
                                                                 <Border Grid.Column="1" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                                                     <Border.Background>
                                                                         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                             <GradientStop Color="{Binding AvatarGradientStart}" Offset="0"/>
                                                                             <GradientStop Color="{Binding AvatarGradientEnd}" Offset="1"/>
                                                                         </LinearGradientBrush>
                                                                     </Border.Background>
                                                                     <Grid>
                                                                         <TextBlock Text="{Binding AvatarInitial}" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                             <TextBlock.Style>
                                                                                 <Style TargetType="TextBlock">
                                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </TextBlock.Style>
                                                                         </TextBlock>
                                                                         <Image Source="{Binding AvatarImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                                             <Image.RenderTransform>
                                                                                 <ScaleTransform ScaleX="1.28" ScaleY="1.28"/>
                                                                             </Image.RenderTransform>
                                                                             <Image.Style>
                                                                                 <Style TargetType="Image">
                                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Image.Style>
                                                                         </Image>
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Player Name -->
                                                                 <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                                                     <StackPanel Orientation="Horizontal">
                                                                         <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                                         <!-- "YOU" Badge -->
                                                                         <Border Background="{StaticResource RainbowGradient}" CornerRadius="4" Padding="5,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSelf, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                             <TextBlock Text="YOU" FontSize="9.5" FontWeight="Black" Foreground="White"/>
                                                                         </Border>
                                                                         <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Flagged by leaderboard checks" Visibility="{Binding IsSuspicious, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                     </StackPanel>
                                                                     <TextBlock Text="{Binding FriendCode}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                                 </StackPanel>

                                                                 <!-- Points -->
                                                                 <TextBlock Text="{Binding DisplayPoints}" FontSize="13.5" FontWeight="Bold" Foreground="#00F2FF" VerticalAlignment="Center" Grid.Column="3"/>

                                                                 <!-- Wins -->
                                                                 <TextBlock Text="{Binding WinsLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#5CE1A3" VerticalAlignment="Center" Grid.Column="4"/>

                                                                 <!-- Games -->
                                                                 <TextBlock Text="{Binding GamesLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Grid.Column="5"/>

                                                                 <!-- Winrate -->
                                                                 <TextBlock Text="{Binding WinrateLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFD166" VerticalAlignment="Center" Grid.Column="6"/>

                                                                 <!-- API rank image -->
                                                                 <Grid Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                     <Image Source="{Binding RankImageUrl}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                         <Image.Style>
                                                                             <Style TargetType="Image">
                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding HasRankImage}" Value="True">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </Image.Style>
                                                                     </Image>
                                                                     <TextBlock Text="-" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                         <TextBlock.Style>
                                                                             <Style TargetType="TextBlock">
                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding HasRankImage}" Value="False">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </TextBlock.Style>
                                                                     </TextBlock>
                                                                 </Grid>

                                                                 <!-- VR movement from the extended API -->
                                                                 <TextBlock Text="{Binding VrLast24HoursLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding VrTrendColor}" VerticalAlignment="Center" Grid.Column="8" ToolTip="{Binding VrTrendToolTip}"/>

                                                                 <!-- Last online activity -->
                                                                 <TextBlock Text="{Binding LastSeenLabel}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Grid.Column="9" TextTrimming="CharacterEllipsis"/>
                                                             </Grid>
                                                         </Border>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </DockPanel>
                                     </Grid>
                                 </Grid>
                             </Grid>

                                <Grid x:Name="NewsView" Visibility="Collapsed">
                                    <StackPanel MaxWidth="920" MinWidth="700" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="NewsSearchTextBox" Style="{StaticResource PathTextBox}" TextChanged="NewsSearchTextBox_TextChanged"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="All" Tag="All" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="NewsFilterButton_Click"/>
                                                    <Button Content="Updates" Tag="Update" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="NewsFilterButton_Click"/>
                                                    <Button Content="Events" Tag="Event" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="NewsFilterButton_Click"/>
                                                    <Button Content="Pinned" Tag="Pinned" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="NewsFilterButton_Click"/>
                                                    <Button x:Name="RefreshNewsButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="Refresh News" Style="{StaticResource ActionButton}" Click="RefreshNewsButton_Click" Width="42" Padding="0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ItemsControl x:Name="NewsItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,14">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,4,0,0"/>
                                                                <Border Margin="0,12,0,0" Padding="8,4" CornerRadius="8" Background="#1C2740" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Version}" FontSize="10" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Black" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                <TextBlock services:MarkdownHelper.MarkdownText="{Binding Summary}" FontSize="13.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,0"/>

                                                                <!-- Media Section -->
                                                                <Border CornerRadius="12" Margin="0,14,0,0" ClipToBounds="True" MaxHeight="300" Background="#0C101F" BorderBrush="#2A3857" BorderThickness="1" HorizontalAlignment="Left">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <!-- Image Element -->
                                                                        <Image Source="{Binding ImageMediaPath}" Stretch="Uniform" MaxHeight="300">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>

                                                                        <!-- Video Element (MediaElement) -->
                                                                        <MediaElement Source="{Binding VideoMediaPath}"
                                                                          Stretch="Uniform" 
                                                                          MaxHeight="300" 
                                                                          LoadedBehavior="Manual"
                                                                          UnloadedBehavior="Close" 
                                                                          IsMuted="True"
                                                                          Loaded="NewsVideo_Loaded"
                                                                          MediaEnded="NewsVideo_MediaEnded"
                                                                          MediaFailed="NewsVideo_MediaFailed">
                                                                            <MediaElement.Style>
                                                                                <Style TargetType="MediaElement">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </MediaElement.Style>
                                                                        </MediaElement>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ModsView" Visibility="Collapsed" AllowDrop="True" DragOver="ModsDropZone_DragOver" Drop="ModsDropZone_Drop">
                                    <StackPanel Width="920" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource GlassCard}" Padding="28" Margin="0,0,0,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="260"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="VanzaKart Modpack" FontSize="30" FontWeight="Black" VerticalAlignment="Center"/>
                                                        <Border x:Name="ModChannelBadgeBorder" Background="#163754" BorderBrush="#397FB9" BorderThickness="1" CornerRadius="8" Height="30" MinWidth="62" Padding="8,0" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock x:Name="ModChannelBadgeTextBlock" Text="STABLE" FontSize="10" FontWeight="Black" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="CoreModStatusTextBlock" Text="Status unknown" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,18"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Installed: " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                                        <TextBlock x:Name="InstalledVersionText" Text="Not installed" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="   Latest: " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                                        <TextBlock x:Name="LatestVersionText" Text="Unknown" FontSize="13" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button x:Name="InstallButton" Content="Install" ToolTip="Install or update the mod" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,8" Click="InstallButton_OnClick" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <Button x:Name="RepairModButton" Content="Repair" ToolTip="Re-download and repair files" Style="{StaticResource CompactButton}" Margin="0,0,0,8" Click="RepairModButton_OnClick" FontWeight="Bold" FontSize="14"/>
                                                    <Button x:Name="CheckUpdatesButton" Content="Check" ToolTip="Check for updates" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CheckUpdatesButton_OnClick" FontSize="14" FontWeight="Bold"/>
                                                    <Button x:Name="OpenModFolderButton" Content="Folder" ToolTip="Open mod folder" Style="{StaticResource CompactButton}" Click="OpenModFolderButton_OnClick" FontSize="14" FontWeight="Bold"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,18" BorderBrush="#397FB9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="350"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="VanzaKart Music Pack" FontSize="24" FontWeight="Black" VerticalAlignment="Center"/>
                                                        <Border Background="#163754" BorderBrush="#397FB9" BorderThickness="1" CornerRadius="8" Height="30" MinWidth="62" Padding="8,0" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="OFFICIAL" FontSize="10" FontWeight="Black" Foreground="#66D4FF" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="MusicPackStatusTextBlock" Text="Checking package status..." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,14"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Installed: " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                                        <TextBlock x:Name="InstalledMusicPackVersionText" Text="Not installed" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="   Latest: " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                                        <TextBlock x:Name="LatestMusicPackVersionText" Text="Unknown" FontSize="13" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <CheckBox x:Name="MusicPackEnabledCheckBox" Content="Enabled" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" Click="MusicPackEnabledCheckBox_OnClick"/>
                                                    <Button x:Name="MusicPackInstallButton" Content="Install" ToolTip="Install or update the official Music Pack" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" Click="MusicPackInstallButton_OnClick" FontWeight="Bold" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                    <Button x:Name="MusicPackRemoveButton" Content="Remove" ToolTip="Remove the Music Pack from My Stuff" Style="{StaticResource CompactButton}" Click="MusicPackRemoveButton_OnClick" FontWeight="Bold" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="InstalledAddonsTabButton" Content="INSTALLED ADDONS" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,7,0" Height="46" Click="InstalledAddonsTabButton_OnClick"/>
                                            <Button x:Name="GameBananaTabButton" Grid.Column="1" Content="GAMEBANANA BROWSER" Style="{StaticResource CompactButton}" Margin="7,0,0,0" Height="46" Click="GameBananaTabButton_OnClick"/>
                                        </Grid>

                                        <StackPanel x:Name="InstalledAddonsPanel">
                                            <Border x:Name="ModsDropZone" Style="{StaticResource GlassCard}" MinHeight="124" BorderBrush="#445D8C" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Drop addons here" FontSize="21" FontWeight="Black"/>
                                                        <TextBlock x:Name="AddonFolderTextBlock" Text="ZIP files, folders and individual files are supported." Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,7,20,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Addons folder" ToolTip="Open addon folder" Style="{StaticResource CompactButton}" Margin="0,0,10,0" Click="OpenAddonsFolderButton_OnClick"/>
                                                        <Button Content="Mod root" ToolTip="Open mod root" Style="{StaticResource CompactButton}" Click="OpenModFolderButton_OnClick"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <TextBlock x:Name="InstalledAddonsEmptyTextBlock" Text="No addons installed yet. Drop one above or browse GameBanana." Foreground="{StaticResource TextSecondary}" FontSize="14" TextAlignment="Center" Margin="0,24"/>
                                            <ItemsControl x:Name="InstalledAddonsItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="72"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="58" Height="58" CornerRadius="12" Background="#17213A" ClipToBounds="True">
                                                                    <Grid>
                                                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill"/>
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0">
                                                                        <Run Text="{Binding Source, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Author, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding FileCountText, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Content="{Binding StatusText, Mode=OneWay}" Tag="{Binding}" VerticalAlignment="Center" Margin="12,0,14,0" Click="AddonEnabledCheckBox_OnClick"/>
                                                                    <Button Content="Mod page" ToolTip="Open source page or My Stuff folder" Tag="{Binding}" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="OpenAddonPageButton_OnClick"/>
                                                                    <Button Content="Remove" Tag="{Binding}" Style="{StaticResource CompactButton}" Click="RemoveAddonButton_OnClick"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel x:Name="GameBananaPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.ColumnSpan="2">
                                                        <TextBlock Text="GameBanana for Mario Kart Wii" FontSize="22" FontWeight="Black"/>
                                                        <TextBlock Text="Search and install graphic mods and texture packs directly into VanzaKart." Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="190"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="GameBananaSearchTextBox" Style="{StaticResource ModernTextBox}" Height="42" ToolTip="Search textures, characters, karts..." KeyDown="GameBananaSearchTextBox_OnKeyDown"/>
                                                        <ComboBox x:Name="GameBananaSortComboBox" Grid.Column="1" Style="{StaticResource CustomComboBox}" Height="42" Margin="10,0,0,0" SelectionChanged="GameBananaSortComboBox_OnSelectionChanged" SelectedIndex="0">
                                                            <ComboBoxItem Content="Newest" Tag="Generic_Newest"/>
                                                            <ComboBoxItem Content="Most liked" Tag="Generic_MostLiked"/>
                                                            <ComboBoxItem Content="Most viewed" Tag="Generic_MostViewed"/>
                                                            <ComboBoxItem Content="Most downloaded" Tag="Generic_MostDownloaded"/>
                                                            <ComboBoxItem Content="A – Z" Tag="Generic_Alphabetically"/>
                                                        </ComboBox>
                                                    </Grid>
                                                    <Button x:Name="GameBananaSearchButton" Grid.Row="1" Grid.Column="1" Content="Search" Style="{StaticResource CompactPrimaryButton}" Margin="14,14,0,0" MinWidth="110" Height="42" VerticalAlignment="Center" Click="GameBananaSearchButton_OnClick"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock x:Name="GameBananaStatusTextBlock" Text="Open the browser to load Mario Kart Wii mods." Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,16"/>
                                            <ItemsControl x:Name="GameBananaModsItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="136" Height="92" CornerRadius="10" Background="#111A2E" ClipToBounds="True">
                                                                    <Grid>
                                                                        <TextBlock Text="GAMEBANANA" FontWeight="Black" FontSize="10" Foreground="#F4C430" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill"/>
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="0,1,20,0">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Black" FontSize="17" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Author, StringFormat=by {0}}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,3,0,0"/>
                                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,7,0,0"/>
                                                                    <TextBlock Text="{Binding StatsText, Mode=OneWay}" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,6,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <Button Content="{Binding InstallText, Mode=OneWay}" Tag="{Binding}" Style="{StaticResource CompactPrimaryButton}" MinWidth="100" Click="InstallGameBananaModButton_OnClick"/>
                                                                    <Button Content="View page" Tag="{Binding}" Style="{StaticResource CompactButton}" MinWidth="100" Margin="0,8,0,0" Click="OpenGameBananaPageButton_OnClick"/>
                                                                    <TextBlock Text="{Binding FileText, Mode=OneWay}" Foreground="{StaticResource TextFaint}" FontSize="10" TextAlignment="Center" Margin="0,6,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Margin="0,18,0,0">
                                            <TextBlock x:Name="CompatibilityTextBlock" Text="Install the core mod before importing addons." FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="VersioningTextBlock" Text="Waiting for manifest" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="ModConflictTextBlock" Text="No addon conflicts detected." Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="LicensesView" Visibility="Collapsed">
                                    <StackPanel MaxWidth="920" HorizontalAlignment="Center">
                                        <Border x:Name="MiiRuntimeSetupCard" Style="{StaticResource GlassCard}" Padding="22" Margin="0,0,0,18" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="260"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Mii render setup" FontSize="20" FontWeight="Black"/>
                                                    <TextBlock x:Name="MiiRuntimeStatusTextBlock" Text="Renderer assets are not installed yet." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,12"/>
                                                    <ProgressBar x:Name="MiiRuntimeProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"/>
                                                    <TextBlock x:Name="MiiRuntimeProgressTextBlock" Text="Ready to install" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,8,0,0"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button x:Name="InstallMiiRuntimeButton" Content="Setup" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" Click="InstallMiiRuntimeButton_OnClick"/>
                                                    <Button Content="Log" ToolTip="Open renderer log" Style="{StaticResource CompactButton}" Click="OpenMiiRendererLogButton_OnClick"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="240"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="Mii &amp; Licenses" FontSize="30" FontWeight="Black"/>
                                                    <TextBlock x:Name="LicenseSummaryTextBlock" Text="Select a Dolphin user folder to scan local saves." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,18"/>

                                                    <ItemsControl x:Name="LicenseCardsItemsControl">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <Grid Margin="0,0,0,12">
                                                                     <!-- Soft Glow Backdrop -->
                                                                     <Border x:Name="LicenseGlow" CornerRadius="10" Background="{StaticResource RainbowGradient}" Opacity="0" Margin="-3">
                                                                         <Border.Effect>
                                                                             <BlurEffect Radius="8"/>
                                                                         </Border.Effect>
                                                                     </Border>
                                                                     
                                                                     <!-- Main License Card -->
                                                                     <Border x:Name="LicenseCardBorder" Background="#121A2A" BorderBrush="#2B3855" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0" RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonDown="LicenseCard_MouseLeftButtonDown">
                                                                         <Border.RenderTransform>
                                                                             <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                                                         </Border.RenderTransform>
                                                                         <Grid>
                                                                             <Grid.ColumnDefinitions>
                                                                                 <ColumnDefinition Width="112"/>
                                                                                 <ColumnDefinition Width="*"/>
                                                                             </Grid.ColumnDefinitions>

                                                                             <Border Width="96" Height="96" CornerRadius="12" Background="#0B1020" BorderBrush="#365071" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                                                                                 <Grid ClipToBounds="True">
                                                                                     <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill">
                                                                                         <Image.Style>
                                                                                             <Style TargetType="Image">
                                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                 <Style.Triggers>
                                                                                                     <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                                     </DataTrigger>
                                                                                                 </Style.Triggers>
                                                                                             </Style>
                                                                                         </Image.Style>
                                                                                     </Image>
                                                                                     <TextBlock Text="{Binding AvatarStatus}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                                                                                         <TextBlock.Style>
                                                                                             <Style TargetType="TextBlock">
                                                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                                                 <Style.Triggers>
                                                                                                     <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                     </DataTrigger>
                                                                                                 </Style.Triggers>
                                                                                             </Style>
                                                                                         </TextBlock.Style>
                                                                                     </TextBlock>
                                                                                 </Grid>
                                                                             </Border>

                                                                              <StackPanel Grid.Column="1">
                                                                                  <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="Black" TextWrapping="Wrap"/>
                                                                                  <TextBlock Text="{Binding MiiName}" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                                                  <TextBlock Text="{Binding StatsLine}" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="Bold" Margin="0,7,0,0"/>
                                                                                  <!-- Friend Code Badge (click to copy) -->
                                                                                  <Border Margin="0,7,0,0" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" Cursor="Hand" ToolTip="Click to copy Friend Code" MouseLeftButtonDown="FriendCode_OnMouseLeftButtonDown">
                                                                                      <Border.Style>
                                                                                          <Style TargetType="Border">
                                                                                              <Setter Property="Background" Value="#0C2A3D"/>
                                                                                              <Setter Property="BorderBrush" Value="#1D4A6A"/>
                                                                                              <Setter Property="BorderThickness" Value="1"/>
                                                                                              <Setter Property="Visibility" Value="Visible"/>
                                                                                              <Style.Triggers>
                                                                                                  <DataTrigger Binding="{Binding FriendCode}" Value="">
                                                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                  </DataTrigger>
                                                                                              </Style.Triggers>
                                                                                          </Style>
                                                                                      </Border.Style>
                                                                                       <StackPanel Orientation="Horizontal">
                                                                                           <TextBlock Text="FC" FontFamily="Segoe UI" FontSize="11" FontWeight="Black" Foreground="#39E7FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                                           <TextBlock Text="{Binding FriendCode}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#39E7FF" VerticalAlignment="Center"/>
                                                                                       </StackPanel>
                                                                                  </Border>
                                                                                  <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextFaint}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                                                  <!-- Hide AvatarStatus when rendered or avatar is loaded -->
                                                                                  <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                                                                      <TextBlock.Style>
                                                                                          <Style TargetType="TextBlock">
                                                                                              <Setter Property="Text" Value="{Binding AvatarStatus}"/>
                                                                                              <Setter Property="Visibility" Value="Visible"/>
                                                                                              <Style.Triggers>
                                                                                                  <DataTrigger Binding="{Binding AvatarStatus}" Value="Rendered">
                                                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                  </DataTrigger>
                                                                                                  <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                      <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                  </DataTrigger>
                                                                                              </Style.Triggers>
                                                                                          </Style>
                                                                                      </TextBlock.Style>
                                                                                  </TextBlock>
                                                                              </StackPanel>
                                                                         </Grid>
                                                                     </Border>
                                                                 </Grid>
                                                                 <DataTemplate.Triggers>
                                                                      <Trigger SourceName="LicenseCardBorder" Property="IsMouseOver" Value="True">
                                                                          <Trigger.EnterActions>
                                                                              <BeginStoryboard>
                                                                                  <Storyboard>
                                                                                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.15">
                                                                                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                      </DoubleAnimation>
                                                                                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.15">
                                                                                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                      </DoubleAnimation>
                                                                                  </Storyboard>
                                                                              </BeginStoryboard>
                                                                          </Trigger.EnterActions>
                                                                          <Trigger.ExitActions>
                                                                              <BeginStoryboard>
                                                                                  <Storyboard>
                                                                                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                                                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                      </DoubleAnimation>
                                                                                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                                                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                      </DoubleAnimation>
                                                                                  </Storyboard>
                                                                              </BeginStoryboard>
                                                                          </Trigger.ExitActions>
                                                                          <Setter TargetName="LicenseCardBorder" Property="Background" Value="#1B253D"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="BorderBrush" Value="#3B4D73"/>
                                                                          <Setter TargetName="LicenseGlow" Property="Opacity" Value="0.45"/>
                                                                      </Trigger>
                                                                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                          <Setter TargetName="LicenseCardBorder" Property="BorderBrush" Value="#00F2FF"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="Background" Value="#17273F"/>
                                                                          <Setter TargetName="LicenseGlow" Property="Opacity" Value="0.75"/>
                                                                      </DataTrigger>
                                                                      <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                          <Setter TargetName="LicenseCardBorder" Property="Opacity" Value="0.55"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="BorderThickness" Value="1"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="BorderBrush" Value="#1A2436"/>
                                                                          <Setter TargetName="LicenseCardBorder" Property="Cursor" Value="Arrow"/>
                                                                      </DataTrigger>
                                                                 </DataTemplate.Triggers>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>

                                                    <TextBlock x:Name="PrimaryLicenseTextBlock" Text="" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="PrimaryLicensePathTextBlock" Text="" Visibility="Collapsed"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Licenses " Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock x:Name="LicensesCountTextBlock" Text="0" FontWeight="Bold"/>
                                                        <TextBlock Text="   Mii DB " Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock x:Name="MiiStateTextBlock" Text="Unknown" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <WrapPanel>
                                                    <Button Content="New Mii" ToolTip="Create a real Wii Mii and sync it to Dolphin" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,8" Click="CreateMiiButton_OnClick"/>
                                                    <Button Content="Switch Mii" ToolTip="Assign one of your saved Miis to the selected license" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,8" Click="SwitchLicenseMiiButton_OnClick"/>
                                                    <Button Content="Friends" ToolTip="Open friend management for the selected license" Style="{StaticResource CompactButton}" Margin="0,0,8,8" Click="OpenFriendsViewButton_OnClick"/>
                                                    <Button Content="Backup" ToolTip="Backup current Dolphin save" Style="{StaticResource CompactButton}" Margin="0,0,8,8" Click="BackupSaveButton_OnClick"/>
                                                    <Button Content="Folder" ToolTip="Open the folder that contains the detected license save" Style="{StaticResource CompactButton}" Margin="0,0,8,8" Click="OpenSavesFolderButton_OnClick"/>
                                                    <Button Content="Import" ToolTip="Import rksys.dat" Style="{StaticResource CompactButton}" Margin="0,0,8,8" Click="ImportSaveButton_OnClick"/>
                                                    <Button Content="Export" ToolTip="Export current save" Style="{StaticResource CompactButton}" Margin="0,0,0,8" Click="ExportSaveButton_OnClick"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource GlassCard}" Padding="18" AllowDrop="True" DragOver="MiiDropZone_DragOver" Drop="MiiDropZone_Drop" Margin="0,0,0,18">
                                             <StackPanel>
                                                 <Grid Margin="0,0,0,12">
                                                     <TextBlock Text="My Miis" FontSize="18" FontWeight="Black"/>
                                                     <WrapPanel HorizontalAlignment="Right">
                                                         <Button Content="Import" ToolTip="Import .mii, .miigx, .mae" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="ImportMiiButton_OnClick"/>
                                                         <Button Content="Edit" ToolTip="Open the visual Mii editor" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" Click="EditMiiButton_OnClick"/>
                                                         <Button Content="Export" ToolTip="Export selected Mii profile" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="ExportMiiButton_OnClick"/>
                                                         <Button Content="Copy" ToolTip="Duplicate selected Mii" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="DuplicateMiiButton_OnClick"/>
                                                         <Button Content="Delete" ToolTip="Delete selected launcher Mii" Style="{StaticResource CompactButton}" Click="DeleteMiiButton_OnClick"/>
                                                     </WrapPanel>
                                                 </Grid>

                                                 <ListBox x:Name="MiiCardsListBox"
                                                          MinHeight="116"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Padding="8"
                                                          ClipToBounds="False"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          SelectionChanged="MiiCardsListBox_SelectionChanged"
                                                          MouseDoubleClick="MiiCardsListBox_MouseDoubleClick"
                                                          PreviewMouseWheel="MiiCardsListBox_PreviewMouseWheel">
                                                     <ListBox.Template>
                                                         <ControlTemplate TargetType="ListBox">
                                                             <Border Name="Bd" Background="Transparent" BorderThickness="0" ClipToBounds="False">
                                                                 <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="false" ClipToBounds="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                                                                     <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                                 </ScrollViewer>
                                                             </Border>
                                                         </ControlTemplate>
                                                     </ListBox.Template>
                                                     <ListBox.ItemsPanel>
                                                         <ItemsPanelTemplate>
                                                             <WrapPanel/>
                                                         </ItemsPanelTemplate>
                                                     </ListBox.ItemsPanel>
                                                     <ListBox.ItemContainerStyle>
                                                         <Style TargetType="ListBoxItem">
                                                             <Setter Property="Padding" Value="0"/>
                                                             <Setter Property="Margin" Value="6"/>
                                                             <Setter Property="Background" Value="Transparent"/>
                                                             <Setter Property="BorderThickness" Value="0"/>
                                                             <Setter Property="Template">
                                                                 <Setter.Value>
                                                                     <ControlTemplate TargetType="ListBoxItem">
                                                                         <Border x:Name="Root" Background="Transparent" CornerRadius="12">
                                                                             <ContentPresenter/>
                                                                         </Border>
                                                                     </ControlTemplate>
                                                                 </Setter.Value>
                                                             </Setter>
                                                         </Style>
                                                     </ListBox.ItemContainerStyle>
                                                     <ListBox.ItemTemplate>
                                                         <DataTemplate>
                                                             <Grid Margin="2">
                                                                 <!-- Dynamic Glow Border behind the main card -->
                                                                 <Border x:Name="GlowBorder" CornerRadius="14" Background="{Binding FavoriteColor}" Opacity="0" Margin="-3">
                                                                     <Border.Effect>
                                                                         <BlurEffect Radius="10"/>
                                                                     </Border.Effect>
                                                                 </Border>

                                                                 <!-- Main Mii Card -->
                                                                 <Border x:Name="CardBorder" Width="140" Padding="12" CornerRadius="12" BorderBrush="{Binding FavoriteColor}" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                                                     <Border.Background>
                                                                         <SolidColorBrush Color="#131C30"/>
                                                                     </Border.Background>
                                                                     <Border.RenderTransform>
                                                                         <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                                                     </Border.RenderTransform>
                                                                     <Grid>
                                                                         <Grid.RowDefinitions>
                                                                             <RowDefinition Height="Auto"/>
                                                                             <RowDefinition Height="*"/>
                                                                         </Grid.RowDefinitions>

                                                                         <!-- Large Mii Preview Avatar -->
                                                                         <Border Width="84" Height="84" CornerRadius="16" Background="#0C1222" BorderBrush="#2F426F" BorderThickness="1.5" HorizontalAlignment="Center" ClipToBounds="True" Margin="0,0,0,12">
                                                                             <Grid ClipToBounds="True">
                                                                                 <!-- Avatar Image -->
                                                                                 <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill">
                                                                                     <Image.Style>
                                                                                         <Style TargetType="Image">
                                                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                                                             <Style.Triggers>
                                                                                                 <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                                                 </DataTrigger>
                                                                                             </Style.Triggers>
                                                                                         </Style>
                                                                                     </Image.Style>
                                                                                 </Image>

                                                                                 <!-- Text Placeholder when image is not rendered yet -->
                                                                                 <TextBlock Text="{Binding AvatarInitial}" Foreground="{StaticResource TextFaint}" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                     <TextBlock.Style>
                                                                                         <Style TargetType="TextBlock">
                                                                                             <Setter Property="Visibility" Value="Visible"/>
                                                                                             <Style.Triggers>
                                                                                                 <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                 </DataTrigger>
                                                                                             </Style.Triggers>
                                                                                         </Style>
                                                                                     </TextBlock.Style>
                                                                                 </TextBlock>
                                                                             </Grid>
                                                                         </Border>

                                                                         <!-- Details -->
                                                                         <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                             <!-- Mii Name -->
                                                                             <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                                                             <!-- Creator Name -->
                                                                             <TextBlock Text="{Binding CreatorName}" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                                             <!-- Status (Only visible if not rendered) -->
                                                                             <TextBlock Text="{Binding RenderStatusText}" Foreground="{StaticResource TextFaint}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                                                 <TextBlock.Style>
                                                                                     <Style TargetType="TextBlock">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                         <Style.Triggers>
                                                                                             <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                             </DataTrigger>
                                                                                         </Style.Triggers>
                                                                                     </Style>
                                                                                 </TextBlock.Style>
                                                                             </TextBlock>
                                                                         </StackPanel>
                                                                     </Grid>
                                                                 </Border>
                                                             </Grid>
                                                             <DataTemplate.Triggers>
                                                                 <!-- Hover Trigger -->
                                                                 <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                     <DataTrigger.EnterActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1C2744" Duration="0:0:0.18"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.EnterActions>
                                                                     <DataTrigger.ExitActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#131C30" Duration="0:0:0.18"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.ExitActions>
                                                                 </DataTrigger>

                                                                 <!-- Selected Trigger -->
                                                                 <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                     <DataTrigger.EnterActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.15">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#25355C" Duration="0:0:0.15"/>
                                                                                 <ThicknessAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness" To="2.5" Duration="0:0:0.15"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.EnterActions>
                                                                     <DataTrigger.ExitActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18">
                                                                                     <DoubleAnimation.EasingFunction>
                                                                                         <CubicEase EasingMode="EaseOut"/>
                                                                                     </DoubleAnimation.EasingFunction>
                                                                                 </DoubleAnimation>
                                                                                 <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#131C30" Duration="0:0:0.18"/>
                                                                                 <ThicknessAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderThickness" To="1.5" Duration="0:0:0.18"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.ExitActions>
                                                                 </DataTrigger>

                                                                 <!-- Pressed (IsMouseCaptured) Trigger for tactile click feedback -->
                                                                 <DataTrigger Binding="{Binding IsMouseCaptured, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                     <DataTrigger.EnterActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.EnterActions>
                                                                     <DataTrigger.ExitActions>
                                                                         <BeginStoryboard>
                                                                             <Storyboard>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                                                                 <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                                                             </Storyboard>
                                                                         </BeginStoryboard>
                                                                     </DataTrigger.ExitActions>
                                                                 </DataTrigger>
                                                             </DataTemplate.Triggers>
                                                         </DataTemplate>
                                                     </ListBox.ItemTemplate>
                                                 </ListBox>
                                             </StackPanel>
                                         </Border>

                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="FriendsView" Visibility="Collapsed">
                                    <StackPanel MaxWidth="920" HorizontalAlignment="Center" Width="920">
                                        <!-- Placeholder when no Active License is selected -->
                                        <Grid Visibility="{Binding HasNoActiveLicense, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border Style="{StaticResource GlassCard}" Padding="32" Margin="0,0,0,18">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                    <TextBlock Text="SELECT ACTIVE LICENSE" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="You must select an active license before managing your friends locally." FontSize="13" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,8,0,24" TextAlignment="Center"/>
                                                    <Button Content="Go to Mii &amp; Licenses" Style="{StaticResource CompactPrimaryButton}" Width="200" Height="40" Click="SelectLicenseRedirect_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Friends Management Panel when Active License IS selected -->
                                        <Grid Visibility="{Binding HasActiveLicense, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <!-- Active License Info Card and Add Friend Input -->
                                                <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,18">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/> <!-- Active Profile details -->
                                                            <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                                            <ColumnDefinition Width="380"/>  <!-- Add Friend Form -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left side: Active License Details -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Mii Avatar -->
                                                            <Border Width="64" Height="64" CornerRadius="12" Background="#0B1020" BorderBrush="#365071" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <Image Source="{Binding ActiveLicense.AvatarImagePath}" Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ActiveLicense.HasAvatarImage}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <TextBlock Text="{Binding ActiveLicense.AvatarInitial}" TextAlignment="Center" Foreground="{StaticResource TextFaint}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ActiveLicense.HasAvatarImage}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="ACTIVE LICENSE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding ActiveLicense.DisplayName}" FontSize="18" FontWeight="Black" Margin="0,2,0,0"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <Border Background="#0C2A3D" BorderBrush="#1D4A6A" BorderThickness="1" Padding="6,2" CornerRadius="4">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="FC" FontSize="10" FontWeight="Black" Foreground="#39E7FF" Margin="0,0,4,0"/>
                                                                            <TextBlock Text="{Binding ActiveLicense.FriendCode}" FontSize="11" FontWeight="Bold" Foreground="#39E7FF" FontFamily="Consolas"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Right side: Add Friend Form -->
                                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                                            <StackPanel>
                                                                <TextBlock Text="ADD FRIEND" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                                                 <Grid>
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*"/>
                                                                         <ColumnDefinition Width="Auto"/>
                                                                     </Grid.ColumnDefinitions>
                                                                     <TextBox x:Name="FriendCodeTextBox" Text="{Binding FriendCodeInput, UpdateSourceTrigger=PropertyChanged}" 
                                                                              Style="{StaticResource PathTextBox}" 
                                                                              Height="36"/>
                                                                     <TextBlock IsHitTestVisible="False" Text="Friend Code (e.g. 1234-5678-9012)" VerticalAlignment="Center" Margin="14,0" Foreground="{StaticResource TextFaint}">
                                                                         <TextBlock.Style>
                                                                             <Style TargetType="TextBlock">
                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding Text, ElementName=FriendCodeTextBox}" Value="">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                     </DataTrigger>
                                                                                     <DataTrigger Binding="{Binding Text, ElementName=FriendCodeTextBox}" Value="{x:Null}">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </TextBlock.Style>
                                                                     </TextBlock>
                                                                     <Button Grid.Column="1" 
                                                                             Content="Add" 
                                                                             Style="{StaticResource PrimaryButton}" 
                                                                             Height="36" 
                                                                             Width="110"
                                                                             Padding="0"
                                                                             Margin="8,0,0,0" 
                                                                             Click="AddFriendButton_Click"/>
                                                                 </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                     </Grid>
                                                </Border>

                                                <!-- Friends List Content Grid -->
                                                <Grid>
                                                    <!-- Loading state -->
                                                    <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource SkeletonCard}" Height="76" Margin="0,0,0,10"/>
                                                            <Border Style="{StaticResource SkeletonCard}" Height="76" Margin="0,0,0,10"/>
                                                            <Border Style="{StaticResource SkeletonCard}" Height="76" Margin="0,0,0,10"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Error State -->
                                                    <Grid Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border Style="{StaticResource GlassCard}" Padding="24" BorderBrush="{StaticResource DangerBrush}" Margin="0,10">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                                <TextBlock Text="ERROR LOADING" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,18" TextAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Empty List Placeholder -->
                                                    <Grid Visibility="{Binding ShowEmptyPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border Style="{StaticResource GlassCard}" Padding="32" Margin="0,10">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                                <TextBlock Text="NO FRIENDS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="You haven't added any friends to this license yet. Add friend codes above!" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Main Friends List -->
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ShowEmptyPlaceholder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>

                                                        <StackPanel>
                                                            <!-- Count Header -->
                                                            <Grid Margin="12,0,12,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="FRIENDS LIST" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding FriendsList.Count}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                                    <TextBlock Text=" / 30 Friends" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,0"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Friends ItemsControl -->
                                                            <ItemsControl ItemsSource="{Binding FriendsList}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,10">
                                                                            <!-- Soft Glow Backdrop on Hover -->
                                                                            <Border x:Name="HoverGlow" CornerRadius="10" Background="{StaticResource RainbowGradient}" Opacity="0" Margin="-2">
                                                                                <Border.Effect>
                                                                                    <BlurEffect Radius="6"/>
                                                                                </Border.Effect>
                                                                            </Border>

                                                                            <Border x:Name="FriendItemCard" Style="{StaticResource GlassCard}" Padding="12" Margin="0" BorderBrush="#2B3855" BorderThickness="1">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="56"/>  <!-- Avatar -->
                                                                                        <ColumnDefinition Width="*"/>   <!-- Profile Details -->
                                                                                        <ColumnDefinition Width="200"/> <!-- Stats -->
                                                                                        <ColumnDefinition Width="50"/>  <!-- Remove Button -->
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- Avatar -->
                                                                                    <Border Width="44" Height="44" CornerRadius="22" Background="#0B1020" BorderBrush="#365071" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                        <Grid>
                                                                                            <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill">
                                                                                                <Image.Style>
                                                                                                    <Style TargetType="Image">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Image.Style>
                                                                                            </Image>
                                                                                            <TextBlock Text="{Binding AvatarInitial}" TextAlignment="Center" Foreground="{StaticResource TextFaint}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </Grid>
                                                                                    </Border>

                                                                                    <!-- Friend details -->
                                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                                                            
                                                                                            <!-- Status Badge -->
                                                                                            <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Background="#153827">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding Status}" Value="Online">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock Text="ONLINE" FontSize="9" FontWeight="Black" Foreground="#4DFFB0"/>
                                                                                            </Border>
                                                                                        </StackPanel>

                                                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                                            <TextBlock Text="FC: " Foreground="{StaticResource TextFaint}" FontSize="11"/>
                                                                                            <TextBlock Text="{Binding FriendCode}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontFamily="Consolas"/>
                                                                                            <TextBlock Text="   •   Mii: " Foreground="{StaticResource TextFaint}" FontSize="11"/>
                                                                                            <TextBlock Text="{Binding LocalMiiName}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>

                                                                                    <!-- Stats -->
                                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                                            <TextBlock Text="VR " Foreground="{StaticResource TextFaint}" FontSize="11"/>
                                                                                            <TextBlock Text="{Binding Vr}" Foreground="#00F2FF" FontWeight="Bold" FontSize="12"/>
                                                                                            <TextBlock Text="   BR " Foreground="{StaticResource TextFaint}" FontSize="11"/>
                                                                                            <TextBlock Text="{Binding Br}" Foreground="#FF6B6B" FontWeight="Bold" FontSize="12"/>
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{Binding StatsLine}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                                                                                    </StackPanel>

                                                                                    <!-- Delete Button -->
                                                                                    <Button Grid.Column="3" 
                                                                                            Style="{StaticResource ActionButton}" 
                                                                                            Foreground="{StaticResource DangerBrush}" 
                                                                                            Width="36" 
                                                                                            Height="36" 
                                                                                            Padding="0" 
                                                                                            Click="RemoveFriendButton_Click" 
                                                                                            ToolTip="Remove friend">
                                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                                                    </Button>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Grid>
                                                                        <DataTemplate.Triggers>
                                                                            <Trigger SourceName="FriendItemCard" Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="HoverGlow" Property="Opacity" Value="0.25"/>
                                                                                <Setter TargetName="FriendItemCard" Property="Background" Value="#1B253D"/>
                                                                                <Setter TargetName="FriendItemCard" Property="BorderBrush" Value="#3B4D73"/>
                                                                            </Trigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="SettingsView" Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- Top Toolbar & Global Actions Bar -->
                                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Title & Mode Selector -->
                                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="⚙️ DOLPHIN &amp; LAUNCHER CONFIGURATION" FontSize="18" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#1A243B" CornerRadius="12" Padding="12,6" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⚙️ Advanced Mode" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                                <CheckBox x:Name="AdvancedModeCheckBox" VerticalAlignment="Center" Checked="AdvancedModeCheckBox_OnChanged" Unchecked="AdvancedModeCheckBox_OnChanged" ToolTip="Toggle advanced emulator and launcher settings"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Search & Quick Action Buttons -->
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="300"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Enhanced Search Box -->
                                                    <Grid>
                                                        <TextBox x:Name="SettingsSearchTextBox" Style="{StaticResource PathTextBox}"
                                                                 Height="38" Padding="32,8,10,8" TextChanged="SettingsSearchTextBox_OnTextChanged"
                                                                 ToolTip="Type here to search any setting (e.g. Vulkan, Resolution, Audio, Language, FPS, Controller)..."/>
                                                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                                        <TextBlock x:Name="SearchPlaceholderText" Text="Search settings..." FontSize="13" Foreground="#64748B"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="32,0,0,0" IsHitTestVisible="False"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button x:Name="SaveGlobalSettingsButton" Content="💾 Save Configuration"
                                                                Style="{StaticResource PrimaryButton}" Margin="4,0" Height="36" Padding="14,0"
                                                                Click="SaveGlobalSettingsButton_OnClick"
                                                                ToolTip="Save and apply all modified settings to Dolphin configuration files."/>

                                                        <Button x:Name="OptimizeVanzaKartButton" Content="✨ Optimize for VanzaKart"
                                                                Style="{StaticResource CompactButton}" Margin="4,0" Height="36" Padding="14,0"
                                                                Click="OptimizeVanzaKartButton_OnClick"
                                                                ToolTip="Automatically apply recommended configuration (Fullscreen, 2K/Auto, Vulkan, Hybrid Ubershaders, Texture packs, 16:9)"/>

                                                        <Button x:Name="ResetAllSettingsButton" Content="🔄 Reset Defaults"
                                                                Style="{StaticResource CompactButton}" Foreground="{StaticResource DangerBrush}" Margin="4,0" Height="36" Padding="12,0"
                                                                Click="ResetAllSettingsButton_OnClick"
                                                                ToolTip="Reset all Dolphin and launcher settings to default values"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- BETA FEATURE DISCLAIMER BANNER -->
                                        <Border Background="#2B1D0C" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="BETA FEATURE WARNING" FontSize="11" FontWeight="Black" Foreground="#FDE047"/>
                                                    <TextBlock Text="Dolphin emulator configuration via Launcher is in BETA. Settings are synchronized with Dolphin INI files, but some features may not apply immediately or might behave unexpectedly." FontSize="12" Foreground="#FEF08A" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Category Sub-Navigation Buttons (Pills) -->
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal" x:Name="CategoryTabsStackPanel">
                                                <Button x:Name="PathsCategoryBtn" Content="📁 Paths" Tag="Paths" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" Click="CategoryTab_Click"/>
                                                <Button x:Name="VideoCategoryBtn" Content="📹 Video" Tag="Video" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CategoryTab_Click"/>
                                                <Button x:Name="AudioCategoryBtn" Content="🔊 Audio" Tag="Audio" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CategoryTab_Click"/>
                                                <Button x:Name="ControllerCategoryBtn" Content="🎮 Controller" Tag="Controller" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CategoryTab_Click"/>
                                                <Button x:Name="WiiCategoryBtn" Content="🌀 Wii" Tag="Wii" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CategoryTab_Click"/>
                                                <Button x:Name="PerformanceCategoryBtn" Content="⚡ Performance" Tag="Performance" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CategoryTab_Click"/>
                                                <Button x:Name="EnhancementsCategoryBtn" Content="🎨 Enhancements" Tag="Enhancements" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CategoryTab_Click"/>
                                                <Button x:Name="AdvancedCategoryBtn" Content="🛠️ Advanced" Tag="Advanced" Style="{StaticResource CompactButton}" Margin="0,0,8,0" Click="CategoryTab_Click"/>
                                                <Button x:Name="LauncherCategoryBtn" Content="🚀 Launcher &amp; Mod" Tag="Launcher" Style="{StaticResource CompactButton}" Margin="0,0,0,0" Click="CategoryTab_Click"/>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- STATUS NOTIFICATION BANNER -->
                                        <Border x:Name="SettingsStatusNotification" Background="#1B2E4B" BorderBrush="#00F2FF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                                            <TextBlock x:Name="SettingsStatusText" Text="Changes saved automatically." Foreground="#00F2FF" FontWeight="Bold" FontSize="13"/>
                                        </Border>

                                        <!-- 1. PATHS SECTION (FIRST TAB) -->
                                        <Border x:Name="PathsSectionCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18" Visibility="Visible">
                                            <StackPanel x:Name="PathsSectionStackPanel">
                                                <TextBlock Text="📁 GAME &amp; EMULATOR PATHS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                                                <!-- Locked Banner Alert if Dolphin Path Invalid -->
                                                <Border x:Name="PathsLockAlertBanner" Background="#3D2912" BorderBrush="#FFD166" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Please select a valid Dolphin Executable (dolphin.exe) path below to unlock all emulator settings and sync live Dolphin configurations." Foreground="#FFD166" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Dolphin Executable (dolphin.exe)" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,14" x:Name="Card_DolphinPath">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="94"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="DolphinPathTextBox" Style="{StaticResource PathTextBox}" TextChanged="DolphinPathTextBox_OnTextChanged"/>
                                                    <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="BrowseDolphinButton_OnClick"/>
                                                </Grid>

                                                <TextBlock Text="Dolphin User Folder" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,14" x:Name="Card_UserFolderPath">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="94"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="UserFolderTextBox" Style="{StaticResource PathTextBox}"/>
                                                    <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="BrowseUserFolderButton_OnClick"/>
                                                </Grid>

                                                <TextBlock Text="Mario Kart Wii ISO / ROM Path" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,14" x:Name="Card_RomPath">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="94"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="RomPathTextBox" Style="{StaticResource PathTextBox}"/>
                                                    <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="BrowseRomButton_OnClick"/>
                                                </Grid>

                                                <UniformGrid Columns="2" Tag="advanced">
                                                    <StackPanel Margin="0,0,8,0">
                                                        <Button Content="📁 Open HD Textures Folder" Style="{StaticResource ActionButton}" Click="OpenTexturesFolder_OnClick" Margin="0,4"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="8,0,0,0">
                                                        <Button Content="📸 Open Screenshots Folder" Style="{StaticResource ActionButton}" Click="OpenScreenshotsFolder_OnClick" Margin="0,4"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. VIDEO SECTION -->
                                        <Border x:Name="VideoSectionCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18" Visibility="Collapsed">
                                            <StackPanel x:Name="VideoSectionStackPanel">
                                                <Grid Margin="0,0,0,14">
                                                    <TextBlock Text="📹 VIDEO &amp; GRAPHICS SETTINGS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <Button Content="Reset Section" HorizontalAlignment="Right" Style="{StaticResource CompactButton}" Click="ResetVideoSection_OnClick"/>
                                                </Grid>

                                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_GfxBackend">
                                                        <TextBlock Text="Graphics Backend" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="GfxBackendComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Select the graphics library used by Dolphin. Vulkan provides optimal stability and speed.">
                                                            <ComboBoxItem Content="Vulkan (Recommended for VanzaKart) ⭐" Tag="Vulkan"/>
                                                            <ComboBoxItem Content="Direct3D 11" Tag="D3D11"/>
                                                            <ComboBoxItem Content="Direct3D 12" Tag="D3D12"/>
                                                            <ComboBoxItem Content="OpenGL" Tag="OpenGL"/>
                                                            <ComboBoxItem Content="Software / Null" Tag="Null"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_InternalResolution">
                                                        <TextBlock Text="Internal Resolution" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="InternalResolutionComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Multiplies internal rendering resolution (1x 720p/480p, 3x 1080p, 4x 1440p 2K, 6x 4K).">
                                                            <ComboBoxItem Content="0: Native Wii (480p)" Tag="0"/>
                                                            <ComboBoxItem Content="1: 1x Native (720p/480p)" Tag="1"/>
                                                            <ComboBoxItem Content="2: 2x Native (720p HD)" Tag="2"/>
                                                            <ComboBoxItem Content="3: 3x Native (1080p Full HD) ⭐" Tag="3"/>
                                                            <ComboBoxItem Content="4: 4x Native (1440p 2K QHD) ⭐" Tag="4"/>
                                                            <ComboBoxItem Content="5: 5x Native (1620p)" Tag="5"/>
                                                            <ComboBoxItem Content="6: 6x Native (2160p 4K Ultra HD) ⭐" Tag="6"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_AspectRatio">
                                                        <TextBlock Text="Aspect Ratio" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="AspectRatioComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Display aspect ratio. Force 16:9 is recommended for VanzaKart.">
                                                            <ComboBoxItem Content="0: Auto-detect" Tag="0"/>
                                                            <ComboBoxItem Content="1: Force 16:9 (Recommended for VanzaKart) ⭐" Tag="1"/>
                                                            <ComboBoxItem Content="2: Force 4:3 (Original)" Tag="2"/>
                                                            <ComboBoxItem Content="3: Stretch to Window" Tag="3"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_Fullscreen">
                                                        <TextBlock Text="Fullscreen Mode" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="FullscreenCheckBox" Content="Enable Fullscreen on Startup ⭐" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Launches game directly in fullscreen mode."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_VSync">
                                                        <TextBlock Text="Vertical Sync (V-Sync)" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="VSyncCheckBox" Content="Enable V-Sync" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Prevents screen tearing by synchronizing frame rate with display refresh rate."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_RemoveBlur">
                                                        <TextBlock Text="Remove Blur (Disable Copy Filter)" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="RemoveBlurCheckBox" Content="Disable Copy Filter (Sharper Image) ⭐" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Removes the original Wii copy filter for an extremely sharp image."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_ShowFPS">
                                                        <TextBlock Text="Show FPS" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="ShowFpsCheckBox" Content="Show On-Screen FPS Counter" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Displays real-time frames per second overlay."/>
                                                    </StackPanel>

                                                    <!-- ADVANCED VIDEO CARDS -->
                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_ShaderCompilation" Tag="advanced">
                                                        <TextBlock Text="Shader Compilation Mode" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="ShaderCompilationComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Hybrid Ubershaders prevents stuttering during first track or effect loads.">
                                                            <ComboBoxItem Content="0: Synchronous (Standard)" Tag="0"/>
                                                            <ComboBoxItem Content="1: Asynchronous (Skip Drawing)" Tag="1"/>
                                                            <ComboBoxItem Content="2: Asynchronous (Hybrid Ubershaders) ⭐" Tag="2"/>
                                                            <ComboBoxItem Content="3: Synchronous (Specialized Ubershaders)" Tag="3"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_AnisotropicFiltering" Tag="advanced">
                                                        <TextBlock Text="Anisotropic Filtering (AF)" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="AnisotropicFilteringComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Enhances texture clarity on angled surfaces such as track asphalt.">
                                                            <ComboBoxItem Content="1x (Disabled)" Tag="0"/>
                                                            <ComboBoxItem Content="2x" Tag="1"/>
                                                            <ComboBoxItem Content="4x" Tag="2"/>
                                                            <ComboBoxItem Content="8x" Tag="3"/>
                                                            <ComboBoxItem Content="16x (Maximum Quality) ⭐" Tag="4"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_AntiAliasing" Tag="advanced">
                                                        <TextBlock Text="Anti-Aliasing (AA)" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="AntiAliasingComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Smooths jagged edges on 3D geometry models.">
                                                            <ComboBoxItem Content="Disabled" Tag="0"/>
                                                            <ComboBoxItem Content="2x MSAA" Tag="2"/>
                                                            <ComboBoxItem Content="4x MSAA" Tag="4"/>
                                                            <ComboBoxItem Content="8x MSAA" Tag="8"/>
                                                            <ComboBoxItem Content="SSAA (Super Sampling)" Tag="16"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_WidescreenHack" Tag="advanced">
                                                        <TextBlock Text="Widescreen Hack" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="WidescreenHackCheckBox" Content="Force Widescreen Rendering" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Forces Dolphin to render a wider 16:9 viewport."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_TextureCache" Tag="advanced">
                                                        <TextBlock Text="Texture Cache Accuracy" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="TextureCacheComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Accuracy level for Dolphin texture cache.">
                                                            <ComboBoxItem Content="Safe (Recommended for stability) ⭐" Tag="0"/>
                                                            <ComboBoxItem Content="Medium" Tag="1"/>
                                                            <ComboBoxItem Content="Fast (Maximum performance)" Tag="2"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. AUDIO SECTION -->
                                        <Border x:Name="AudioSectionCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18" Visibility="Collapsed">
                                            <StackPanel x:Name="AudioSectionStackPanel">
                                                <Grid Margin="0,0,0,14">
                                                    <TextBlock Text="🔊 AUDIO SETTINGS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <Button Content="Reset Section" HorizontalAlignment="Right" Style="{StaticResource CompactButton}" Click="ResetAudioSection_OnClick"/>
                                                </Grid>

                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_AudioVolume">
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Master Volume" FontWeight="Bold"/>
                                                            <TextBox x:Name="AudioVolumeTextBox" Text="100" Width="60" Height="26" Style="{StaticResource CompactNumberTextBox}" HorizontalAlignment="Right" TextChanged="AudioVolumeTextBox_TextChanged"/>
                                                        </Grid>
                                                        <Slider x:Name="AudioVolumeSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="AudioVolumeSlider_OnValueChanged" ToolTip="Adjust Dolphin master volume."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_AudioBackend">
                                                        <TextBlock Text="Audio Backend" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="AudioBackendComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Audio output backend driver. Cubeb is recommended.">
                                                            <ComboBoxItem Content="Cubeb (Recommended modern driver) ⭐" Tag="Cubeb"/>
                                                            <ComboBoxItem Content="WASAPI (Windows Audio)" Tag="WASAPI"/>
                                                            <ComboBoxItem Content="XAudio2" Tag="XAudio2"/>
                                                            <ComboBoxItem Content="OpenAL" Tag="OpenAL"/>
                                                            <ComboBoxItem Content="Null (No Audio)" Tag="Null"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_AudioStretching">
                                                        <TextBlock Text="Audio Stretching" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="AudioStretchingCheckBox" Content="Enable Audio Stretching (Prevents crackling)" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Stretches audio playback speed dynamically to prevent crackling during frame drops."/>
                                                    </StackPanel>

                                                    <!-- ADVANCED AUDIO CARDS -->
                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_DspLle" Tag="advanced">
                                                        <TextBlock Text="DSP Emulation Engine" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="DspLleCheckBox" Content="Enable DSP LLE (Low Level Emulation)" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="DSP HLE (default) is fast and optimized. DSP LLE emulates exact hardware but uses more CPU."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_AudioLatency" Tag="advanced">
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Audio Latency / Buffer Size" FontWeight="Bold"/>
                                                            <TextBox x:Name="AudioLatencyTextBox" Text="20" Width="60" Height="26" Style="{StaticResource CompactNumberTextBox}" HorizontalAlignment="Right" TextChanged="AudioLatencyTextBox_TextChanged"/>
                                                        </Grid>
                                                        <Slider x:Name="AudioLatencySlider" Style="{StaticResource ModernSlider}" Minimum="10" Maximum="100" Value="20" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="AudioLatencySlider_OnValueChanged" ToolTip="Sets audio output buffer latency in milliseconds."/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 4. CONTROLLER SECTION (FULL DOLPHIN CONFIG & PROFILES) -->
                                        <Border x:Name="ControllerSectionCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18" Visibility="Collapsed">
                                            <StackPanel x:Name="ControllerSectionStackPanel">
                                                <Grid Margin="0,0,0,14">
                                                    <TextBlock Text="🎮 DOLPHIN CONTROLLER MAPPING &amp; PROFILES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="💾 Save Controller Config" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" Click="SaveControllerConfig_OnClick"/>
                                                        <Button Content="Reset Section" Style="{StaticResource CompactButton}" Click="ResetControllerSection_OnClick"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Active Controller Status Indicator Banner -->
                                                <Border Background="#111A2E" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="ControllerStatusBannerText" Text="🟢 Connected Controller: Detecting..." FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="🔄 Refresh Devices" Style="{StaticResource ActionButton}" Height="30" Padding="10,0" Click="RefreshControllerDevices_Click"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Controller Mode Switcher: Simple MKWii vs Advanced Dolphin -->
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="SimpleControllerModeBtn" Content="🎮 Simple Mode (Mario Kart Wii) ⭐" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,6,0" Click="ControllerModeBtn_Click"/>
                                                        <Button x:Name="AdvancedControllerModeBtn" Content="⚙️ Advanced Dolphin Mode" Style="{StaticResource CompactButton}" Click="ControllerModeBtn_Click"/>
                                                    </StackPanel>

                                                    <!-- Extension Dropdown for Wiimote -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="Card_WiimoteExtension">
                                                        <TextBlock Text="Wiimote Extension:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <ComboBox x:Name="WiimoteExtensionComboBox" Style="{StaticResource CustomComboBox}" Width="160" Height="36" SelectionChanged="WiimoteExtension_SelectionChanged">
                                                            <ComboBoxItem Content="Nunchuk ⭐" Tag="Nunchuk"/>
                                                            <ComboBoxItem Content="Classic Controller" Tag="Classic"/>
                                                            <ComboBoxItem Content="None (Wheel Horizontal)" Tag="None"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Port Type Selector (GameCube Port 1-4 & Wiimote 1-2) -->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                                                    <StackPanel Orientation="Horizontal" x:Name="ControllerPortTabsStackPanel">
                                                        <Button x:Name="GcPort1TabBtn" Content="GameCube Port 1 ⭐" Tag="GC1" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,6,0" Click="ControllerPortTab_Click"/>
                                                        <Button x:Name="GcPort2TabBtn" Content="GameCube Port 2" Tag="GC2" Style="{StaticResource CompactButton}" Margin="0,0,6,0" Click="ControllerPortTab_Click"/>
                                                        <Button x:Name="GcPort3TabBtn" Content="GameCube Port 3" Tag="GC3" Style="{StaticResource CompactButton}" Margin="0,0,6,0" Click="ControllerPortTab_Click"/>
                                                        <Button x:Name="GcPort4TabBtn" Content="GameCube Port 4" Tag="GC4" Style="{StaticResource CompactButton}" Margin="0,0,6,0" Click="ControllerPortTab_Click"/>
                                                        <Button x:Name="WiiPort1TabBtn" Content="Wiimote 1" Tag="WII1" Style="{StaticResource CompactButton}" Margin="0,0,6,0" Click="ControllerPortTab_Click"/>
                                                        <Button x:Name="WiiPort2TabBtn" Content="Wiimote 2" Tag="WII2" Style="{StaticResource CompactButton}" Margin="0,0,6,0" Click="ControllerPortTab_Click"/>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!-- Device & Profile Toolbar -->
                                                <Border Background="#141C2B" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- Device Dropdown -->
                                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                                            <TextBlock Text="Input Device (Keyboard or Gamepad)" FontWeight="Bold" Margin="0,0,0,6"/>
                                                            <ComboBox x:Name="ControllerDeviceComboBox" Style="{StaticResource CustomComboBox}" Height="38" SelectionChanged="ControllerControl_Changed">
                                                                <ComboBoxItem Content="Keyboard / Mouse" Tag="Keyboard/0/Keyboard Mouse"/>
                                                                <ComboBoxItem Content="XInput Gamepad" Tag="SDL/0/XInput Controller"/>
                                                                <ComboBoxItem Content="DualSense PlayStation Controller" Tag="SDL/0/DualSense Wireless Controller"/>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <!-- Profile Management Bar -->
                                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Dolphin Profile:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <ComboBox x:Name="ControllerProfileComboBox" Style="{StaticResource CustomComboBox}" Width="180" Height="36"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Content="Load Profile" Style="{StaticResource CompactPrimaryButton}" Margin="4,0" Height="36" Click="LoadProfileButton_Click"/>
                                                                <Button Content="Save Profile" Style="{StaticResource CompactButton}" Margin="4,0" Height="36" Click="SaveProfileButton_Click"/>
                                                                <Button Content="Delete Profile" Style="{StaticResource CompactButton}" Foreground="{StaticResource DangerBrush}" Margin="4,0" Height="36" Click="DeleteProfileButton_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <!-- SIMPLE MARIO KART WII CONTROLS GRID -->
                                                <Border x:Name="SimpleControllerGrid" Background="#101726" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14" Visibility="Visible">
                                                    <StackPanel>
                                                        <TextBlock Text="🏎️ MARIO KART WII ESSENTIAL CONTROLS (Click any field to rebind!)" FontWeight="Bold" Foreground="#00F2FF" Margin="0,0,0,12"/>

                                                        <!-- Action Buttons -->
                                                        <TextBlock Text="🎯 ACTION BUTTONS" FontWeight="Bold" Foreground="#7DF9FF" FontSize="12" Margin="0,0,0,6"/>
                                                        <UniformGrid Columns="2" Margin="0,0,0,12">
                                                            <Grid Margin="6,4"><TextBlock Text="🏎️ Accelerate" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox x:Name="SimpleBind_Accelerate" Style="{StaticResource BindingTextBox}" Width="140" Height="32" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                            <Grid Margin="6,4"><TextBlock Text="🛑 Brake / Reverse" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox x:Name="SimpleBind_Brake" Style="{StaticResource BindingTextBox}" Width="140" Height="32" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
