                                                <!-- NUNCHUK & MOTION CONTROLS GRID (For Wiimotes) -->
                                                <Border x:Name="NunchukMotionGrid" Background="#101726" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="🌀 NUNCHUK, MOTION SHAKE &amp; TILT CONTROLS" FontWeight="Bold" Foreground="#00F2FF" Margin="0,0,0,12"/>
                                                        <UniformGrid Columns="3">
                                                            <!-- Nunchuk Stick & Buttons -->
                                                            <Border Background="#141C2B" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                                                <StackPanel>
                                                                    <TextBlock Text="🕹️ NUNCHUK STICK &amp; BUTTONS" FontWeight="Bold" Foreground="#00F2FF" Margin="0,0,0,8"/>
                                                                    <Grid Margin="0,3"><TextBlock Text="Stick Up" VerticalAlignment="Center"/><TextBox x:Name="Bind_NunchukUp" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Stick Down" VerticalAlignment="Center"/><TextBox x:Name="Bind_NunchukDown" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Stick Left" VerticalAlignment="Center"/><TextBox x:Name="Bind_NunchukLeft" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Stick Right" VerticalAlignment="Center"/><TextBox x:Name="Bind_NunchukRight" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Button C" VerticalAlignment="Center"/><TextBox x:Name="Bind_NunchukC" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Button Z" VerticalAlignment="Center"/><TextBox x:Name="Bind_NunchukZ" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Motion Shake -->
                                                            <Border Background="#141C2B" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                                                <StackPanel>
                                                                    <TextBlock Text="👋 MOTION SHAKE (Tricks &amp; Wheelies)" FontWeight="Bold" Foreground="#00F2FF" Margin="0,0,0,8"/>
                                                                    <Grid Margin="0,3"><TextBlock Text="Shake X (Horizontal)" VerticalAlignment="Center"/><TextBox x:Name="Bind_ShakeX" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Shake Y (Vertical)" VerticalAlignment="Center"/><TextBox x:Name="Bind_ShakeY" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Shake Z (Forward)" VerticalAlignment="Center"/><TextBox x:Name="Bind_ShakeZ" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Tilt Controls -->
                                                            <Border Background="#141C2B" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                                                <StackPanel>
                                                                    <TextBlock Text="📐 TILT CONTROLS (Wii Wheel Steering)" FontWeight="Bold" Foreground="#00F2FF" Margin="0,0,0,8"/>
                                                                    <Grid Margin="0,3"><TextBlock Text="Tilt Left" VerticalAlignment="Center"/><TextBox x:Name="Bind_TiltLeft" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Tilt Right" VerticalAlignment="Center"/><TextBox x:Name="Bind_TiltRight" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Tilt Forward" VerticalAlignment="Center"/><TextBox x:Name="Bind_TiltForward" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                    <Grid Margin="0,3"><TextBlock Text="Tilt Backward" VerticalAlignment="Center"/><TextBox x:Name="Bind_TiltBackward" Style="{StaticResource BindingTextBox}" Width="130" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Border>

                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,8,0" x:Name="Card_AnalogSensitivity" Tag="advanced">
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Analog Sensitivity" FontWeight="Bold"/>
                                                            <TextBox x:Name="AnalogSensitivityTextBox" Text="100" Width="60" Height="26" Style="{StaticResource CompactNumberTextBox}" HorizontalAlignment="Right" TextChanged="AnalogSensitivityTextBox_TextChanged"/>
                                                        </Grid>
                                                        <Slider x:Name="AnalogSensitivitySlider" Style="{StaticResource ModernSlider}" Minimum="50" Maximum="150" Value="100" ValueChanged="AnalogSensitivitySlider_OnValueChanged"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="4,0" x:Name="Card_AnalogDeadzone" Tag="advanced">
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Analog Deadzone" FontWeight="Bold"/>
                                                            <TextBox x:Name="AnalogDeadzoneTextBox" Text="10" Width="60" Height="26" Style="{StaticResource CompactNumberTextBox}" HorizontalAlignment="Right" TextChanged="AnalogDeadzoneTextBox_TextChanged"/>
                                                        </Grid>
                                                        <Slider x:Name="AnalogDeadzoneSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="50" Value="10" ValueChanged="AnalogDeadzoneSlider_OnValueChanged"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="8,0,0,0" x:Name="Card_Vibration">
                                                        <TextBlock Text="Vibration Motor" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="VibrationCheckBox" Content="Enable Controller Vibration (Rumble)" Checked="ControllerControl_Changed" Unchecked="ControllerControl_Changed"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 5. WII SECTION -->
                                        <Border x:Name="WiiSectionCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18" Visibility="Collapsed">
                                            <StackPanel x:Name="WiiSectionStackPanel">
                                                <Grid Margin="0,0,0,14">
                                                    <TextBlock Text="🌀 WII &amp; SYSTEM SETTINGS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <Button Content="Reset Section" HorizontalAlignment="Right" Style="{StaticResource CompactButton}" Click="ResetWiiSection_OnClick"/>
                                                </Grid>

                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_WiiLanguage">
                                                        <TextBlock Text="Wii Console Language" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="WiiLanguageComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Sets internal Wii console system language.">
                                                            <ComboBoxItem Content="English (Recommended for Mario Kart Wii) ⭐" Tag="1"/>
                                                            <ComboBoxItem Content="Italian" Tag="5"/>
                                                            <ComboBoxItem Content="German" Tag="2"/>
                                                            <ComboBoxItem Content="French" Tag="3"/>
                                                            <ComboBoxItem Content="Spanish" Tag="4"/>
                                                            <ComboBoxItem Content="Dutch" Tag="6"/>
                                                            <ComboBoxItem Content="Traditional Chinese" Tag="7"/>
                                                            <ComboBoxItem Content="Simplified Chinese" Tag="8"/>
                                                            <ComboBoxItem Content="Korean" Tag="9"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_WiiRegion">
                                                        <TextBlock Text="Wii Console Region" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="WiiRegionComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed" ToolTip="Wii console hardware region. PAL/EUR is standard for European discs/ISOs.">
                                                            <ComboBoxItem Content="PAL / Europe ⭐" Tag="2"/>
                                                            <ComboBoxItem Content="NTSC-U / USA" Tag="1"/>
                                                            <ComboBoxItem Content="NTSC-J / Japan" Tag="0"/>
                                                            <ComboBoxItem Content="NTSC-K / Korea" Tag="3"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_EnableSdCard">
                                                        <TextBlock Text="Virtual SD Card (1GB)" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="EnableSdCardCheckBox" Content="Enable Virtual SD Card (Required for CTGP &amp; Mods)" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Enables emulated SD card needed for custom track pack saving."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_ForceDisableWiimote">
                                                        <TextBlock Text="Disable Wiimote Speaker" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="ForceDisableWiimoteCheckBox" Content="Disable Wiimote Speaker Audio" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Disables real/emulated Wiimote speaker sound to prevent stuttering."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_RetroRewind">
                                                        <TextBlock Text="Retro Rewind Support" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="RetroRewindCheckBox" Content="Enable Retro Rewind Compatibility" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Configures Dolphin settings for Retro Rewind custom pack."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_EnableCheats" Tag="advanced">
                                                        <TextBlock Text="Cheats &amp; Gecko Codes" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="EnableCheatsCheckBox" Content="Enable Cheats / Gecko Codes" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Allows Gecko codes and cheat engines to execute."/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 6. PERFORMANCE SECTION -->
                                        <Border x:Name="PerformanceSectionCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18" Visibility="Collapsed">
                                            <StackPanel x:Name="PerformanceSectionStackPanel">
                                                <Grid Margin="0,0,0,14">
                                                    <TextBlock Text="⚡ PERFORMANCE &amp; CPU EMULATION" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <Button Content="Reset Section" HorizontalAlignment="Right" Style="{StaticResource CompactButton}" Click="ResetPerformanceSection_OnClick"/>
                                                </Grid>

                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_PerformancePreset">
                                                        <TextBlock Text="Quick Performance Preset" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="PerformancePresetComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="PerformancePreset_OnSelectionChanged">
                                                            <ComboBoxItem Content="VanzaKart Optimized ⭐" Tag="VanzaKart Recommended"/>
                                                            <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                                                            <ComboBoxItem Content="High Performance" Tag="High-Performance"/>
                                                            <ComboBoxItem Content="Low-End PC" Tag="Low-End"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_DualCore">
                                                        <TextBlock Text="Dual Core (CPU Threading)" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="DualCoreCheckBox" Content="Enable Dual Core (Recommended)" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Separates CPU and GPU emulation across dedicated processor cores."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_SkipIdle">
                                                        <TextBlock Text="Skip Idle CPU Loops" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="SkipIdleCheckBox" Content="Skip Idle CPU Loops" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Boosts performance by skipping emulated CPU idle loops."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_FastDiscSpeed">
                                                        <TextBlock Text="Fast Disc Speed Loading" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="FastDiscSpeedCheckBox" Content="Fast Disc Speed Loading ⭐" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Dramatically speeds up track and menu loading times."/>
                                                    </StackPanel>

                                                    <!-- ADVANCED PERFORMANCE CARDS -->
                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_CpuOverride" Tag="advanced">
                                                        <TextBlock Text="CPU Clock Override" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="CpuOverrideCheckBox" Content="Enable CPU Overclock / Underclock" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_CpuClockRatio" Tag="advanced">
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="CPU Clock Multiplier Ratio" FontWeight="Bold"/>
                                                            <TextBox x:Name="CpuClockRatioTextBox" Text="100%" Width="60" Height="26" Style="{StaticResource CompactNumberTextBox}" HorizontalAlignment="Right" TextChanged="CpuClockRatioTextBox_TextChanged"/>
                                                        </Grid>
                                                        <Slider x:Name="CpuClockRatioSlider" Style="{StaticResource ModernSlider}" Minimum="0.5" Maximum="3.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="CpuClockRatioSlider_OnValueChanged"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="EnhancementsSectionCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18" Visibility="Collapsed">
                                            <StackPanel x:Name="EnhancementsSectionStackPanel">
                                                <Grid Margin="0,0,0,14">
                                                    <TextBlock Text="🎨 GRAPHICS ENHANCEMENTS &amp; TEXTURE PACKS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <Button Content="Reset Section" HorizontalAlignment="Right" Style="{StaticResource CompactButton}" Click="ResetEnhancementsSection_OnClick"/>
                                                </Grid>

                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_LoadCustomTextures">
                                                        <TextBlock Text="Custom Texture Packs" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="LoadCustomTexturesCheckBox" Content="Load Custom HD Textures ⭐" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Enables loading high-definition custom texture packs for VanzaKart."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,14" x:Name="Card_PrefetchCustomTextures" Tag="advanced">
                                                        <TextBlock Text="RAM Texture Prefetch" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="PrefetchCustomTexturesCheckBox" Content="Prefetch All Textures into System RAM" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Eliminates in-game micro-stutters by loading entire texture pack into RAM."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,12,14" x:Name="Card_PostProcessingShader" Tag="advanced">
                                                        <TextBlock Text="Post-Processing Shader" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="PostProcessingShaderComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed">
                                                            <ComboBoxItem Content="Disabled" Tag="Off"/>
                                                            <ComboBoxItem Content="FXAA (Fast Anti-Aliasing)" Tag="fxaa"/>
                                                            <ComboBoxItem Content="Bloom Shader" Tag="bloom"/>
                                                            <ComboBoxItem Content="CRT Scanlines" Tag="crt"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 8. LAUNCHER & MODPACK SECTION -->
                                        <Border x:Name="LauncherSectionCard" Visibility="Collapsed">
                                            <StackPanel>
                                                <!-- RELEASE CHANNEL CARD -->
                                                <Border x:Name="ReleaseChannelSettingsCard" Style="{StaticResource GlassCard}" BorderBrush="#397FB9" Margin="0,0,0,18">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="250"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,28,0">
                                                            <TextBlock Text="MODPACK RELEASE CHANNEL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                            <TextBlock x:Name="ReleaseChannelTitleTextBlock" Text="Stable channel" FontSize="18" FontWeight="Black" Margin="0,10,0,4"/>
                                                            <TextBlock x:Name="ReleaseChannelDescriptionTextBlock" Text="Recommended builds tested for regular play." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                                            <TextBlock x:Name="InstalledReleaseChannelTextBlock" Text="Installed channel: Stable" Foreground="{StaticResource TextFaint}" FontSize="12" Margin="0,9,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Use channel" FontWeight="Bold" Margin="0,0,0,7"/>
                                                            <ComboBox x:Name="ModReleaseChannelComboBox" Style="{StaticResource CustomComboBox}" Height="42" SelectionChanged="ModReleaseChannelComboBox_OnSelectionChanged">
                                                                <ComboBoxItem Content="Stable (recommended)" Tag="Stable"/>
                                                                <ComboBoxItem Content="Beta (experimental)" Tag="Beta"/>
                                                            </ComboBox>
                                                            <Button x:Name="ManageBetaTokenButton" Content="🔑 Beta Token" Style="{StaticResource CompactButton}" Margin="0,8,0,0" Visibility="Collapsed" Click="ManageBetaTokenButton_OnClick"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- LAUNCHER & GAME PREFERENCES CARDS -->
                                                <Grid Margin="0,0,0,18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,9,0">
                                                        <Border x:Name="LauncherSettingsCard" Style="{StaticResource GlassCard}">
                                                            <StackPanel>
                                                                <TextBlock Text="LAUNCHER OPTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                                <CheckBox x:Name="AutoUpdateCheckBox" Content="Check updates on startup" Margin="0,14,0,12" Checked="AutoUpdateSetting_Changed" Unchecked="AutoUpdateSetting_Changed"/>
                                                                <CheckBox x:Name="SeparateSaveDefaultCheckBox" Content="Separate savegame by default" Checked="SeparateSaveDefault_Changed" Unchecked="SeparateSaveDefault_Changed"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                        <Border x:Name="GameSettingsCard" Style="{StaticResource GlassCard}">
                                                            <StackPanel>
                                                                <TextBlock Text="GAME OPTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                                <Grid Margin="0,14,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,10,0">
                                                                        <TextBlock Text="Textures (my stuff)" FontWeight="Bold" Margin="0,0,0,12"/>
                                                                        <CheckBox x:Name="GraphicsTexturesCheckBox" Content="Enabled" Checked="GraphicsTextures_Changed" Unchecked="GraphicsTextures_Changed"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                        <TextBlock Text="Launch save" FontWeight="Bold" Margin="0,0,0,12"/>
                                                                        <CheckBox x:Name="SeparateSaveCheckBox" Content="Separate savegame" Checked="SeparateSave_Changed" Unchecked="SeparateSave_Changed"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 9. ADVANCED / DEVELOPER SECTION -->
                                        <Border x:Name="AdvancedSectionCard" Style="{StaticResource GlassCard}" BorderBrush="#6EFF6B82" Margin="0,0,0,18" Visibility="Collapsed">
                                            <StackPanel x:Name="AdvancedSectionStackPanel">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="🛠️ ADVANCED / DEVELOPER TOOLS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                                </StackPanel>

                                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                                    <StackPanel Margin="0,0,12,0" x:Name="Card_LogLevel">
                                                        <TextBlock Text="Log Verbosity Level" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="LogLevelComboBox" Style="{StaticResource CustomComboBox}" Height="40" SelectionChanged="SettingControl_Changed">
                                                            <ComboBoxItem Content="Notice (Standard)" Tag="Notice"/>
                                                            <ComboBoxItem Content="Error" Tag="Error"/>
                                                            <ComboBoxItem Content="Warning" Tag="Warning"/>
                                                            <ComboBoxItem Content="Info" Tag="Info"/>
                                                            <ComboBoxItem Content="Debug" Tag="Debug"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="12,0,0,0" x:Name="Card_PortableMode">
                                                        <TextBlock Text="Portable Mode (portable.txt)" FontWeight="Bold" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="PortableModeCheckBox" Content="Force Portable Mode in Dolphin Directory" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" ToolTip="Creates or removes portable.txt to store configurations inside executable directory."/>
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Border Background="#1A1826" CornerRadius="8" Padding="14" Margin="0,6,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Re-initialize In-Game VanzaKart Settings File (Settings.pul)" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="Use only if experiencing startup crashes. Permanently resets in-game saved configuration." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Delete Settings.pul" Style="{StaticResource ActionButton}" Foreground="{StaticResource DangerBrush}" BorderBrush="#88FF6B82" VerticalAlignment="Center" Click="DeleteGameSettingsFileButton_OnClick"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="DebugView" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="DEBUG CONSOLE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock x:Name="DebugLogTextBlock" Text="Debug information will appear here." FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="3">
                                            <Button Content="Refresh state" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="RefreshDebugButton_OnClick"/>
                                            <Button Content="Open settings file" Style="{StaticResource ActionButton}" Margin="4,0" Click="OpenSettingsFileButton_OnClick"/>
                                            <Button Content="Open preferences file" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="OpenPreferencesFileButton_OnClick"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="LicenseMiiPickerOverlay"
                  Grid.RowSpan="2"
                  Background="#B0070A13"
                  Visibility="Collapsed"
                  Opacity="0">
                <Border x:Name="LicenseMiiPickerCard"
                        Width="760"
                        MaxHeight="650"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24"
                        CornerRadius="16"
                        Background="#F012192A"
                        BorderBrush="{StaticResource RainbowGradient}"
                        BorderThickness="1.6"
                        Effect="{StaticResource NeonGlow}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Switch License Mii" FontSize="24" FontWeight="Black"/>
                                <TextBlock x:Name="LicenseMiiPickerSummaryTextBlock"
                                           Text="Choose a Mii to assign to the selected license."
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="&#xE8BB;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource CompactButton}"
                                    Width="38"
                                    Height="38"
                                    Padding="0"
                                    Click="CancelLicenseMiiPickerButton_OnClick"
                                    ToolTip="Close"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,18,0,14"
                                Padding="14"
                                CornerRadius="12"
                                Background="#AA0B1020"
                                BorderBrush="#2A3857"
                                BorderThickness="1">
                            <TextBlock Text="A safety backup of the selected save is created first. The chosen Mii is also synced into Dolphin's Mii database, so the license can display it without opening the game."
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       FontSize="13"/>
                        </Border>

                        <ListBox x:Name="LicenseMiiPickerListBox"
                                 Grid.Row="2"
                                 MinHeight="170"
                                 MaxHeight="320"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="7"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" Background="Transparent" CornerRadius="12">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border x:Name="PickerGlow" CornerRadius="15" Background="{Binding FavoriteColor}" Opacity="0" Margin="-3">
                                            <Border.Effect>
                                                <BlurEffect Radius="12"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="PickerCard"
                                                Width="156"
                                                Height="188"
                                                Padding="14"
                                                CornerRadius="12"
                                                Background="#131C30"
                                                BorderBrush="{Binding FavoriteColor}"
                                                BorderThickness="1.4"
                                                RenderTransformOrigin="0.5,0.5"
                                                Cursor="Hand">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="PickerCardScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <StackPanel>
                                                <Border Width="78" Height="78" CornerRadius="16" Background="#0C1222" BorderBrush="#2F426F" BorderThickness="1.5" HorizontalAlignment="Center" ClipToBounds="True" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding AvatarInitial}" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CreatorName}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding TechnicalLabel}" FontSize="10" Foreground="{StaticResource TextFaint}" TextAlignment="Center" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PickerCardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.16"/>
                                                        <DoubleAnimation Storyboard.TargetName="PickerCardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.16"/>
                                                        <DoubleAnimation Storyboard.TargetName="PickerGlow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.16"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PickerCardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"/>
                                                        <DoubleAnimation Storyboard.TargetName="PickerCardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"/>
                                                        <DoubleAnimation Storyboard.TargetName="PickerGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="PickerCard" Property="Background" Value="#25355C"/>
                                            <Setter TargetName="PickerCard" Property="BorderThickness" Value="2.4"/>
                                            <Setter TargetName="PickerGlow" Property="Opacity" Value="0.85"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseCaptured, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PickerCardScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.07"/>
                                                        <DoubleAnimation Storyboard.TargetName="PickerCardScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.07"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="3" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LicenseMiiPickerStatusTextBlock"
                                       Text="Select a Mii to continue."
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource CompactButton}" Width="112" Click="CancelLicenseMiiPickerButton_OnClick"/>
                            <Button x:Name="ApplyLicenseMiiButton" Grid.Column="3" Content="Apply Mii" Style="{StaticResource CompactPrimaryButton}" Width="126" Click="ApplyLicenseMiiButton_OnClick"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ToastBorder"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="360"
                    Margin="0,0,28,28"
                    Padding="16"
                    CornerRadius="8"
                    Background="#F012192A"
                    BorderBrush="#3B4C72"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Opacity="0"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock x:Name="ToastTitleTextBlock" Text="VanzaKart" FontSize="13" FontWeight="Bold"/>
                    <TextBlock x:Name="ToastMessageTextBlock" Text="" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
