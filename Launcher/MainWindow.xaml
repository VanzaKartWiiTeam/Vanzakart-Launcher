                                                            <Grid Margin="0,3"><TextBlock Text="Trigger R" VerticalAlignment="Center"/><TextBox x:Name="Bind_R" Style="{StaticResource BindingTextBox}" Width="120" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
