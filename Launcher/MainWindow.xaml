                                                            <Grid Margin="0,3"><TextBlock Text="Start / Pause" VerticalAlignment="Center"/><TextBox x:Name="Bind_Start" Style="{StaticResource BindingTextBox}" Width="120" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Main Stick Group -->
                                                    <Border Background="#101726" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                                        <StackPanel x:Name="Group_MainStick">
                                                            <TextBlock Text="MAIN STICK" FontWeight="Bold" Foreground="#00F2FF" Margin="0,0,0,8"/>
                                                            <Grid Margin="0,3"><TextBlock Text="Up" VerticalAlignment="Center"/><TextBox x:Name="Bind_MainUp" Style="{StaticResource BindingTextBox}" Width="120" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
                                                            <Grid Margin="0,3"><TextBlock Text="Down" VerticalAlignment="Center"/><TextBox x:Name="Bind_MainDown" Style="{StaticResource BindingTextBox}" Width="120" Height="30" HorizontalAlignment="Right" PreviewMouseDown="BindingField_PreviewMouseDown" IsReadOnly="True" Cursor="Hand" ToolTip="Click to rebind" TextChanged="ControllerControl_Changed"/></Grid>
