        <!-- Modern Smooth Custom Slider Style -->
        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="Glow" Width="20" Height="20" Fill="#00F2FF" Opacity="0.3">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#00F2FF" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="OuterRing" Width="16" Height="16" Fill="#0F172A" Stroke="#00F2FF" StrokeThickness="2"/>
                            <Ellipse x:Name="InnerDot" Width="6" Height="6" Fill="#00F2FF"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.65"/>
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#4DFFB0"/>
                                <Setter TargetName="InnerDot" Property="Fill" Value="#4DFFB0"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="Glow" Property="Width" Value="24"/>
                                <Setter TargetName="Glow" Property="Height" Value="24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="GridRoot" Background="Transparent" VerticalAlignment="Center">
                            <Border x:Name="TrackBackground" Height="8" CornerRadius="4" Background="#111827" BorderBrush="#2A3857" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8" CornerRadius="4" Background="{StaticResource PlayGradient}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18"
            BorderThickness="1.2"
            BorderBrush="#4C5C8C"
            Background="{StaticResource WindowGradient}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dual-layer background parallax animation -->
            <Canvas x:Name="AmbientParticleCanvas" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.85">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="AmbientParticleTransform"/>
                </Canvas.RenderTransform>

                <!-- Glowing Layer 1 (Deep/Thick/Soft) -->
                <Path Data="M-120,130 C180,20 330,260 650,112 S1040,160 1460,48"
                      Stroke="{StaticResource RainbowGradient}"
                      StrokeThickness="20"
                      Opacity="0.5">
                    <Path.Effect>
                        <BlurEffect Radius="28"/>
                    </Path.Effect>
                </Path>
                <!-- Glowing Layer 1 (Thin/Solid) -->
                <Path Data="M-120,130 C180,20 330,260 650,112 S1040,160 1460,48"
                      Stroke="{StaticResource RainbowGradient}"
                      StrokeThickness="3.0"
                      Opacity="0.8">
                    <Path.Effect>
                        <DropShadowEffect Color="#FF007F" BlurRadius="12" ShadowDepth="0" Opacity="0.65"/>
                    </Path.Effect>
                </Path>

                <!-- Glowing Layer 2 (Deep/Thick/Soft) -->
                <Path Data="M-80,650 C250,500 430,720 720,560 S1060,540 1420,430"
                      Stroke="#00F2FF"
                      StrokeThickness="18"
                      Opacity="0.45">
                    <Path.Effect>
                        <BlurEffect Radius="24"/>
                    </Path.Effect>
                </Path>
                <!-- Glowing Layer 2 (Thin/Solid) -->
                <Path Data="M-80,650 C250,500 430,720 720,560 S1060,540 1420,430"
                      Stroke="#00F2FF"
                      StrokeThickness="2.5"
                      Opacity="0.75">
                    <Path.Effect>
                        <DropShadowEffect Color="#00F2FF" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                    </Path.Effect>
                </Path>

                <Rectangle Width="260" Height="2" RadiusX="1" RadiusY="1" Fill="#39E7FF" Opacity="0.4" Canvas.Left="880" Canvas.Top="154">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#39E7FF" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="AmbientStreakTransformA"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="180" Height="2" RadiusX="1" RadiusY="1" Fill="#FF3B7A" Opacity="0.35" Canvas.Left="620" Canvas.Top="690">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#FF3B7A" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="AmbientStreakTransformB"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="140" Height="2" RadiusX="1" RadiusY="1" Fill="#FFD166" Opacity="0.3" Canvas.Left="1120" Canvas.Top="420">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#FFD166" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="AmbientStreakTransformC"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <Border Grid.Row="0"
                    Background="#D00A0F1E"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

