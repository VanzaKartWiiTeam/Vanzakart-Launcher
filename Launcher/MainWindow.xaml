                        <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource ChromeButton}" Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource ChromeButton}" Foreground="{StaticResource DangerBrush}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#B80B1020"
                        BorderBrush="#202A42"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,18">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>



                        <StackPanel Grid.Row="1">
                            <Button x:Name="HomeNavButton" Tag="&#xE768;" Content="HOME / PLAY" Style="{StaticResource NavButton}" Click="HomeNavButton_Click" Margin="0,0,0,7"/>
                            <Button x:Name="NewsNavButton" Tag="&#xE8A5;" Content="NEWS" Style="{StaticResource NavButton}" Click="NewsNavButton_Click" Margin="0,0,0,7"/>
                            <Button x:Name="ModsNavButton" Tag="&#xE7B8;" Content="MODS" Style="{StaticResource NavButton}" Click="ModsNavButton_Click" Margin="0,0,0,7"/>
                            <Button x:Name="LicensesNavButton" Tag="&#xE77B;" Content="MII &amp; LICENSES" Style="{StaticResource NavButton}" Click="LicensesNavButton_Click" Margin="0,0,0,7"/>
                            <Button x:Name="SettingsNavButton" Tag="&#xE713;" Content="SETTINGS" Style="{StaticResource NavButton}" Click="SettingsNavButton_Click" Margin="0,0,0,7"/>
                            <Button x:Name="DebugNavButton" Tag="&#xE943;" Content="DEBUG" Style="{StaticResource NavButton}" Click="DebugNavButton_Click" Visibility="Collapsed"/>
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource MiniCard}" Padding="14">
