<UserControl x:Class="VanzaKartLauncher.Views.MarioKartControllerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:VanzaKartLauncher.Models"
             Loaded="Panel_OnLoaded"
             Unloaded="Panel_OnUnloaded"
             PreviewKeyDown="Panel_OnPreviewKeyDown"
             Focusable="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MkPanel" Color="#111A2C"/>
        <SolidColorBrush x:Key="MkPanelRaised" Color="#17233A"/>
        <SolidColorBrush x:Key="MkStroke" Color="#2B3C5B"/>
        <SolidColorBrush x:Key="MkMuted" Color="#91A3C2"/>
        <SolidColorBrush x:Key="MkAccent" Color="#6EA8FF"/>
        <SolidColorBrush x:Key="MkCyan" Color="#58E7FF"/>
        <SolidColorBrush x:Key="MkSuccess" Color="#50E7A7"/>
        <SolidColorBrush x:Key="MkDanger" Color="#FF7088"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F8FF"/>
        </Style>

        <Style x:Key="MkCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MkPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MkStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="MkButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2A45"/>
            <Setter Property="Foreground" Value="#F5F8FF"/>
            <Setter Property="BorderBrush" Value="#344B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#243A5D"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6099E9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MkPrimaryButton" TargetType="Button" BasedOn="{StaticResource MkButton}">
            <Setter Property="Background" Value="#3979E8"/>
            <Setter Property="BorderBrush" Value="#78A9FF"/>
        </Style>

        <Style x:Key="MkIconButton" TargetType="Button" BasedOn="{StaticResource MkButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="MkBindingButton" TargetType="Button" BasedOn="{StaticResource MkButton}">
            <Setter Property="MinWidth" Value="154"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="#13233C"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListening}" Value="True">
                    <Setter Property="Background" Value="#153D52"/>
                    <Setter Property="BorderBrush" Value="{StaticResource MkCyan}"/>
                    <Setter Property="Foreground" Value="#8DF1FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasConflict}" Value="True">
                    <Setter Property="Background" Value="#321C29"/>
                    <Setter Property="BorderBrush" Value="{StaticResource MkDanger}"/>
                    <Setter Property="Foreground" Value="#FFA5B5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MkComboToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#101C31"/>
            <Setter Property="Foreground" Value="#F4F8FF"/>
            <Setter Property="BorderBrush" Value="#344B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0"
                                      Stroke="#9BB1D2" StrokeThickness="1.8"
                                      Margin="12,0,1,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource MkAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource MkCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F8FF"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource MkComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#121E32" BorderBrush="#3B5276"
                                        BorderThickness="1" CornerRadius="12"
                                        Padding="5" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                        Margin="0,5,0,0">
                                    <ScrollViewer MaxHeight="280">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F5F8FF"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot" Background="{TemplateBinding Background}"
                                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#213554"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#294B76"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MkSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ThumbCircle" Fill="#79A9FF" Stroke="#D9E7FF" StrokeThickness="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbCircle" Property="Fill" Value="#65E6FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbCircle" Property="Fill" Value="#50E7A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MkSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" Background="#243653" CornerRadius="3" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="#5F98F4"
                                                  BorderThickness="0" Height="6">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MkSliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MkSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAF1FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="46" Height="25" CornerRadius="13"
                                    Background="#263751" BorderBrush="#405474" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="19" Height="19" Fill="#AAB8CF"
                                         HorizontalAlignment="Left" Margin="2"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2B69CF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#72A5FF"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MkProgress" TargetType="ProgressBar">
            <Setter Property="Background" Value="#223550"/>
            <Setter Property="Foreground" Value="#62A0FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#40577B" CornerRadius="5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionRow" TargetType="Border">
            <Setter Property="Background" Value="#101A2B"/>
            <Setter Property="BorderBrush" Value="#263855"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14223A"/>
                    <Setter Property="BorderBrush" Value="#3A5B87"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsListening}" Value="True">
                    <Setter Property="Background" Value="#123346"/>
                    <Setter Property="BorderBrush" Value="{StaticResource MkCyan}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasConflict}" Value="True">
                    <Setter Property="Background" Value="#2C1A25"/>
                    <Setter Property="BorderBrush" Value="{StaticResource MkDanger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ActionTemplate" DataType="{x:Type models:MarioKartActionBinding}">
            <Border Style="{StaticResource ActionRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="#1D3150"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icon}" FontSize="18" Foreground="#8DB8FF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,15,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MkMuted}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding BindingButtonText}"
                            Style="{StaticResource MkBindingButton}"
                            Click="BindingButton_OnClick"/>
                    <Button Grid.Column="3" Content="×" Style="{StaticResource MkIconButton}"
                            Foreground="#FF9CAE" Margin="8,0,0,0"
                            Click="ClearBindingButton_OnClick" ToolTip="Clear assignment"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel x:Name="Root" Opacity="0">
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="15" Background="#203B66" Margin="0,0,13,0">
                        <TextBlock Text="MK" FontSize="15" FontWeight="Black"
                                   Foreground="#A9C9FF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MARIO KART CONTROLS" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Only the controls you need. No Dolphin settings to learn."
                                   Foreground="{StaticResource MkMuted}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#142A36" BorderBrush="#2D675C"
                    BorderThickness="1" CornerRadius="13" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PageStatusDot" Width="9" Height="9" Fill="{StaticResource MkSuccess}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding PageStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#BDEFD9"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource MkCard}" Margin="0,0,0,16" Background="#121F34">
            <StackPanel>
                <Grid Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="Controller mode" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Choose how Player 1 is connected to Mario Kart Wii."
                                   Foreground="{StaticResource MkMuted}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="#173B34" CornerRadius="9" Padding="8,4">
                        <TextBlock Text="PLAYER 1" Foreground="#66EAB1" FontSize="9" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LauncherModeButton" Style="{StaticResource MkButton}"
                            HorizontalContentAlignment="Stretch" Padding="16,13"
                            Click="LauncherModeButton_OnClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#203B66">
                                <TextBlock Text="VK" Foreground="#A9C9FF" FontWeight="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                <TextBlock Text="Launcher Configuration (Recommended)" FontWeight="Bold"/>
                                <TextBlock Text="Fast Mario Kart Wii setup directly in this page"
                                           Foreground="{StaticResource MkMuted}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Ellipse x:Name="LauncherModeDot" Grid.Column="2" Width="10" Height="10"
                                     Fill="#50E7A7" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="WiimoteModeButton" Grid.Column="2" Style="{StaticResource MkButton}"
                            HorizontalContentAlignment="Stretch" Padding="16,13"
                            Click="WiimoteModeButton_OnClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#352E57">
                                <TextBlock Text="D" Foreground="#C7BDFF" FontWeight="Black" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                <TextBlock Text="Configure with Dolphin" FontWeight="Bold"/>
                                <TextBlock Text="For advanced users and existing Dolphin setups"
                                           Foreground="{StaticResource MkMuted}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Ellipse x:Name="WiimoteModeDot" Grid.Column="2" Width="10" Height="10"
                                     Fill="#40516D" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="WiimoteModeNotice" Style="{StaticResource MkCard}" Margin="0,0,0,16"
                Background="#171A35" BorderBrush="#4A467C" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="13" Background="#302B55"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="D" Foreground="#C7BDFF" FontWeight="Black" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Dolphin controls this configuration"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Use Dolphin's original controller window for GameCube controllers, emulated Wii Remotes or real Wii Remotes. The launcher will not edit Dolphin.ini, GCPadNew.ini or WiimoteNew.ini in this mode."
                               Foreground="#AAA9D1" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <Border Background="#222043" BorderBrush="#474473" BorderThickness="1"
                            CornerRadius="9" Padding="10,7" Margin="0,11,0,0">
                        <TextBlock Text="Save &amp; play only remembers this choice, then launches the game."
                                   Foreground="#CEC9FF" FontSize="10"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ManagedDeviceCard" Style="{StaticResource MkCard}" Margin="0,0,0,16" Background="#121F34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Controller" FontSize="11" FontWeight="Bold" Foreground="#7698CB" Margin="1,0,0,7"/>
                    <ComboBox x:Name="DeviceComboBox" Style="{StaticResource MkComboBox}"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              SelectionChanged="DeviceComboBox_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="17" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#8397B8"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#173C35" CornerRadius="8" Padding="7,3"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ConnectionLabel}" FontSize="9" Foreground="#72E6B4"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,20,0,0" VerticalAlignment="Center">
                    <Border Background="#14263D" CornerRadius="11" Padding="11,7" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#FFB74D" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionText" Text="In attesa" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RefreshButton" Content="↻  Refresh" Style="{StaticResource MkButton}"
                            Click="RefreshButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ManagedConfigurationGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.18*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.82*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource MkCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Game actions" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Select an action, then press the button you want to use."
                                       Foreground="{StaticResource MkMuted}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="Brake and Drift may intentionally use the same button."
                                       Foreground="#7FAFF7" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1B3150" CornerRadius="10" Padding="9,5" VerticalAlignment="Center">
                            <TextBlock Text="11 ACTIONS" Foreground="#90BAFA" FontWeight="Bold" FontSize="9"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="RACING" Foreground="#6F8EBB" FontWeight="Bold" FontSize="10" Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding RaceActions}" ItemTemplate="{StaticResource ActionTemplate}"/>

                    <TextBlock Text="MOVEMENT" Foreground="#6F8EBB" FontWeight="Bold" FontSize="10" Margin="2,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding MovementActions}" ItemTemplate="{StaticResource ActionTemplate}"/>

                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource MkCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Controller tester" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Every input lights up in real time." Foreground="{StaticResource MkMuted}"
                                           FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#173B34" CornerRadius="9" Padding="8,4">
                                <TextBlock Text="LIVE" Foreground="#66EAB1" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <Grid Height="210" Margin="0,0,0,10" ClipToBounds="True">
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Canvas Width="360" Height="190">
                                    <!-- Symmetrical shell: the fixed design surface keeps every control aligned
                                         while the Viewbox scales the complete tester as one component. -->
                                    <Path Stroke="#45658F" StrokeThickness="2"
                                          Data="M 92,27 C 61,27 38,36 26,56 C 18,70 15,85 11,101 L 4,133 C -1,157 15,175 38,174 L 65,172 C 84,171 100,158 115,145 C 127,135 140,131 155,131 L 205,131 C 220,131 233,135 245,145 C 260,158 276,171 295,172 L 322,174 C 345,175 361,157 356,133 L 349,101 C 345,85 342,70 334,56 C 322,36 299,27 268,27 C 242,27 222,37 205,41 C 188,45 172,45 155,41 C 138,37 118,27 92,27 Z">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#192B46" Offset="0"/>
                                                <GradientStop Color="#111E33" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>

                                    <!-- Shoulder accents -->
                                    <Rectangle Width="72" Height="7" RadiusX="3.5" RadiusY="3.5"
                                               Canvas.Left="49" Canvas.Top="30" Fill="#263D5D"/>
                                    <Rectangle Width="72" Height="7" RadiusX="3.5" RadiusY="3.5"
                                               Canvas.Left="239" Canvas.Top="30" Fill="#263D5D"/>

                                    <!-- Left analog stick -->
                                    <Ellipse Width="58" Height="58" Canvas.Left="71" Canvas.Top="49"
                                             Fill="#0D192A" Stroke="#486789" StrokeThickness="2"/>
                                    <Ellipse Width="44" Height="44" Canvas.Left="78" Canvas.Top="56"
                                             Fill="#14253D" Stroke="#223B5C" StrokeThickness="1"/>
                                    <Ellipse x:Name="TesterLeftKnob" Width="26" Height="26"
                                             Canvas.Left="87" Canvas.Top="65"
                                             Fill="#74A8FF" Stroke="#E1EDFF" StrokeThickness="2"/>

                                    <!-- D-pad; each direction can light independently. -->
                                    <Rectangle x:Name="DpadUp" Width="18" Height="29" RadiusX="5" RadiusY="5"
                                               Canvas.Left="117" Canvas.Top="99" Fill="#253A59"/>
                                    <Rectangle x:Name="DpadDown" Width="18" Height="29" RadiusX="5" RadiusY="5"
                                               Canvas.Left="117" Canvas.Top="136" Fill="#253A59"/>
                                    <Rectangle x:Name="DpadLeft" Width="29" Height="18" RadiusX="5" RadiusY="5"
                                               Canvas.Left="93" Canvas.Top="123" Fill="#253A59"/>
                                    <Rectangle x:Name="DpadRight" Width="29" Height="18" RadiusX="5" RadiusY="5"
                                               Canvas.Left="130" Canvas.Top="123" Fill="#253A59"/>
                                    <Ellipse Width="20" Height="20" Canvas.Left="116" Canvas.Top="122"
                                             Fill="#253A59"/>
                                    <Ellipse Width="5" Height="5" Canvas.Left="123.5" Canvas.Top="129.5"
                                             Fill="#50698D"/>

                                    <!-- Centre controls -->
                                    <Ellipse Width="26" Height="26" Canvas.Left="167" Canvas.Top="51"
                                             Fill="#152842" Stroke="#385779" StrokeThickness="1.5"/>
                                    <Path Data="M 176,59 L 186,64 L 176,69 Z" Fill="#7E91AF"/>
                                    <Ellipse Width="16" Height="16" Canvas.Left="149" Canvas.Top="81"
                                             Fill="#203451" Stroke="#496488" StrokeThickness="1"/>
                                    <Rectangle Width="6" Height="1.5" RadiusX="0.75" RadiusY="0.75"
                                               Canvas.Left="154" Canvas.Top="88.25" Fill="#9CB1CF"/>
                                    <Ellipse Width="16" Height="16" Canvas.Left="195" Canvas.Top="81"
                                             Fill="#203451" Stroke="#496488" StrokeThickness="1"/>
                                    <Rectangle Width="6" Height="1.5" RadiusX="0.75" RadiusY="0.75"
                                               Canvas.Left="200" Canvas.Top="86" Fill="#9CB1CF"/>
                                    <Rectangle Width="6" Height="1.5" RadiusX="0.75" RadiusY="0.75"
                                               Canvas.Left="200" Canvas.Top="90.5" Fill="#9CB1CF"/>

                                    <!-- Right analog stick -->
                                    <Ellipse Width="50" Height="50" Canvas.Left="193" Canvas.Top="107"
                                             Fill="#0D192A" Stroke="#486789" StrokeThickness="2"/>
                                    <Ellipse Width="38" Height="38" Canvas.Left="199" Canvas.Top="113"
                                             Fill="#14253D" Stroke="#223B5C" StrokeThickness="1"/>
                                    <Ellipse x:Name="TesterRightKnob" Width="22" Height="22"
                                             Canvas.Left="207" Canvas.Top="121"
                                             Fill="#887CFF" Stroke="#D7D2FF" StrokeThickness="1.5"/>

                                    <!-- Face buttons: labels are centred by layout, not manual text offsets. -->
                                    <Grid Width="28" Height="28" Canvas.Left="265" Canvas.Top="37">
                                        <Ellipse x:Name="FaceButtonNorth" Fill="#203451" Stroke="#496488" StrokeThickness="1.5"/>
                                        <TextBlock x:Name="FaceLabelNorth" Text="Y" Foreground="#D2E1F5"
                                                   FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Width="28" Height="28" Canvas.Left="239" Canvas.Top="63">
                                        <Ellipse x:Name="FaceButtonWest" Fill="#203451" Stroke="#496488" StrokeThickness="1.5"/>
                                        <TextBlock x:Name="FaceLabelWest" Text="X" Foreground="#D2E1F5"
                                                   FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Width="28" Height="28" Canvas.Left="291" Canvas.Top="63">
                                        <Ellipse x:Name="FaceButtonEast" Fill="#203451" Stroke="#496488" StrokeThickness="1.5"/>
                                        <TextBlock x:Name="FaceLabelEast" Text="B" Foreground="#D2E1F5"
                                                   FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Width="28" Height="28" Canvas.Left="265" Canvas.Top="89">
                                        <Ellipse x:Name="FaceButtonSouth" Fill="#203451" Stroke="#496488" StrokeThickness="1.5"/>
                                        <TextBlock x:Name="FaceLabelSouth" Text="A" Foreground="#D2E1F5"
                                                   FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LT" Foreground="#8599BA" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="TesterLeftTrigger" Grid.Column="1" Height="7" Maximum="1" Style="{StaticResource MkProgress}"/>
                            <TextBlock Grid.Column="2" Text="RT" Foreground="#8599BA" Margin="12,0,7,0" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="TesterRightTrigger" Grid.Column="3" Height="7" Maximum="1" Style="{StaticResource MkProgress}"/>
                        </Grid>

                        <Border Background="#0F1A2B" CornerRadius="11" Padding="10,8" Margin="0,13,0,0" MinHeight="39">
                            <TextBlock x:Name="PressedInputsText" Text="Press a button to test it"
                                       Foreground="#A9BAD4" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </Border>

                        <Grid Margin="0,13,0,0">
                            <CheckBox x:Name="VibrationSwitch" Content="Vibration"
                                      Style="{StaticResource MkSwitch}"
                                      IsChecked="{Binding Vibration, Mode=TwoWay}"
                                      Checked="VibrationSwitch_OnChanged"
                                      Unchecked="VibrationSwitch_OnChanged"/>
                                <Button Content="Test" Style="{StaticResource MkButton}" HorizontalAlignment="Right"
                                    MinWidth="76" Padding="14,7" Click="TestVibrationButton_OnClick"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MkCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock Text="Analog response" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Tune steering and preview the result instantly."
                                           Foreground="{StaticResource MkMuted}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset" Style="{StaticResource MkButton}"
                                    MinWidth="76"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,6"
                                    Click="ResetAnalogButton_OnClick"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <Grid>
                                    <TextBlock Text="Deadzone" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Deadzone, StringFormat={}{0:0}%}"
                                               HorizontalAlignment="Right" Foreground="#7EAEFF"/>
                                </Grid>
                                <Slider Style="{StaticResource MkSlider}" Minimum="0" Maximum="35"
                                        Value="{Binding Deadzone, Mode=TwoWay}"
                                        ValueChanged="AnalogSlider_OnChanged" Margin="0,7,0,0"/>

                                <Grid Margin="0,15,0,0">
                                    <TextBlock Text="Sensitivity" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sensitivity, StringFormat={}{0:0}%}"
                                               HorizontalAlignment="Right" Foreground="#7EAEFF"/>
                                </Grid>
                                <Slider Style="{StaticResource MkSlider}" Minimum="60" Maximum="140"
                                        Value="{Binding Sensitivity, Mode=TwoWay}"
                                        ValueChanged="AnalogSlider_OnChanged" Margin="0,7,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="108" Height="108" CornerRadius="54"
                                    Background="#0E1929" BorderBrush="#344C6F" BorderThickness="1.5">
                                <Canvas Width="104" Height="104">
                                    <Ellipse Width="76" Height="76" Canvas.Left="14" Canvas.Top="14"
                                             Stroke="#29415F" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="52" Y1="8" X2="52" Y2="96" Stroke="#233750"/>
                                    <Line X1="8" Y1="52" X2="96" Y2="52" Stroke="#233750"/>
                                    <Ellipse x:Name="AnalogRawDot" Width="9" Height="9" Canvas.Left="47.5" Canvas.Top="47.5"
                                             Fill="#627896"/>
                                    <Ellipse x:Name="AnalogOutputDot" Width="12" Height="12" Canvas.Left="46" Canvas.Top="46"
                                             Fill="#59E6FF" Stroke="#C6F8FF" StrokeThickness="1.5"/>
                                </Canvas>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="ConflictBanner" Background="#2B1823" BorderBrush="#6F3A50"
                BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,14,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="!" Foreground="#FF8197" FontWeight="Bold" Margin="0,0,9,0"/>
                <TextBlock x:Name="ConflictText" Foreground="#F1B5C0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,15,0,0">
            <TextBlock x:Name="SaveHintText" Text="Changes have not been applied to Dolphin yet."
                       Foreground="{StaticResource MkMuted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RecommendedSetupButton" Content="Recommended setup" Style="{StaticResource MkButton}"
                        Margin="0,0,9,0" Click="RecommendedSetupButton_OnClick"/>
                <Button x:Name="SaveButton" Content="Save &amp; play" Style="{StaticResource MkPrimaryButton}"
                        Padding="22,11" Click="SaveButton_OnClick"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
