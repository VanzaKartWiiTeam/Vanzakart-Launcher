<Window x:Class="VanzaKartLauncher.MiiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mii Editor"
        Width="1080"
        Height="720"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="#090D18"
        Foreground="#F7FAFF">

    <Window.Resources>
        <SolidColorBrush x:Key="EditorTextPrimary" Color="#F7FAFF"/>
        <SolidColorBrush x:Key="EditorTextSecondary" Color="#AAB6D3"/>
        <SolidColorBrush x:Key="EditorTextFaint" Color="#66728F"/>
        <SolidColorBrush x:Key="EditorPanel" Color="#D012192A"/>
        <SolidColorBrush x:Key="EditorPanelSoft" Color="#A80C1222"/>
        <SolidColorBrush x:Key="EditorStroke" Color="#31405F"/>

        <LinearGradientBrush x:Key="EditorRainbow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.00" Color="#FF3B7A"/>
            <GradientStop Offset="0.18" Color="#FFB84A"/>
            <GradientStop Offset="0.35" Color="#F7FF57"/>
            <GradientStop Offset="0.52" Color="#4DFF8D"/>
            <GradientStop Offset="0.68" Color="#39E7FF"/>
            <GradientStop Offset="0.84" Color="#5A6DFF"/>
            <GradientStop Offset="1.00" Color="#C65CFF"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="EditorBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#080B16"/>
            <GradientStop Offset="0.38" Color="#11172C"/>
            <GradientStop Offset="0.72" Color="#071A25"/>
            <GradientStop Offset="1" Color="#170D24"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="EditorGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.48" Color="#39E7FF"/>
        <DropShadowEffect x:Key="EditorSoftShadow" BlurRadius="34" ShadowDepth="0" Opacity="0.36" Color="#000000"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource EditorPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource EditorSoftShadow}"/>
        </Style>

        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2640"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3B4B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#253657"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#66E8FF"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.018" ScaleY="1.018"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPrimaryButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="{StaticResource EditorRainbow}"/>
            <Setter Property="BorderBrush" Value="#A8FFFFFF"/>
            <Setter Property="Effect" Value="{StaticResource EditorGlow}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1020"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#354262"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#39E7FF"/>
            <Setter Property="Margin" Value="0,8,0,14"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource EditorTextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="#111A2C" BorderBrush="#2D3A57" BorderThickness="1" CornerRadius="8" Margin="0,0,8,8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource EditorRainbow}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B8FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource EditorBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#263654" BorderThickness="0,0,0,1" Background="#78070A13">
            <Grid Margin="26,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mii Studio" FontSize="25" FontWeight="Black"/>
                    <TextBlock Text="Live Wii Mii data, Nintendo Studio preview, Dolphin sync" Foreground="{StaticResource EditorTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Close" Width="92" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource EditorButton}" Click="CloseButton_OnClick"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource EditorCard}" Padding="20" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="PreviewNameTextBlock" Text="Mii" FontSize="24" FontWeight="Black" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewMetaTextBlock" Text="Ready" Foreground="{StaticResource EditorTextSecondary}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Width="270" Height="330" CornerRadius="8" Background="#0B1020" BorderBrush="#3A4A6D" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Rectangle Fill="{StaticResource EditorRainbow}" Opacity="0.13"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16"/>
                            <TextBlock x:Name="PreviewPlaceholderTextBlock" Text="Rendering..." FontSize="16" FontWeight="Black" Foreground="{StaticResource EditorTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="RenderStatusTextBlock" Text="Renderer ready" Foreground="{StaticResource EditorTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="Randomize" Style="{StaticResource EditorPrimaryButton}" Margin="0,0,8,8" Click="RandomizeButton_OnClick"/>
                            <Button Content="Reset" Style="{StaticResource EditorButton}" Margin="0,0,8,8" Click="ResetButton_OnClick"/>
                            <Button Content="Export" Style="{StaticResource EditorButton}" Margin="0,0,0,8" Click="ExportButton_OnClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="AutosaveTextBlock" Text="Autosave active" Foreground="{StaticResource EditorTextFaint}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource EditorCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Name" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" Margin="0,0,0,7"/>
                            <TextBox x:Name="NameTextBox" TextChanged="EditorControl_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Creator" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" Margin="0,0,0,7"/>
                            <TextBox x:Name="CreatorTextBox" TextChanged="EditorControl_OnChanged"/>
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1">
                        <TabItem Header="Body">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox x:Name="FemaleCheckBox" Content="Female" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="FavoriteCheckBox" Content="Favorite" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                    </WrapPanel>
                                    <TextBlock Text="Favorite color" FontWeight="Bold"/>
                                    <Slider x:Name="FavoriteColorSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Height" FontWeight="Bold"/>
                                    <Slider x:Name="HeightSlider" Minimum="0" Maximum="127" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Weight" FontWeight="Bold"/>
                                    <Slider x:Name="WeightSlider" Minimum="0" Maximum="127" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Face">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock Text="Face shape" FontWeight="Bold"/>
                                    <Slider x:Name="FaceShapeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Skin tone" FontWeight="Bold"/>
                                    <Slider x:Name="SkinColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Facial details" FontWeight="Bold"/>
                                    <Slider x:Name="FacialFeatureSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Hair">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <CheckBox x:Name="HairFlipCheckBox" Content="Flip hair" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                    <TextBlock Text="Hair style" FontWeight="Bold"/>
                                    <Slider x:Name="HairTypeSlider" Minimum="0" Maximum="71" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Hair color" FontWeight="Bold"/>
                                    <Slider x:Name="HairColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Eyes">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock Text="Eye style" FontWeight="Bold"/>
                                    <Slider x:Name="EyeTypeSlider" Minimum="0" Maximum="47" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Rotation" FontWeight="Bold"/>
                                    <Slider x:Name="EyeRotationSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Color" FontWeight="Bold"/>
                                    <Slider x:Name="EyeColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Size" FontWeight="Bold"/>
                                    <Slider x:Name="EyeSizeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Spacing" FontWeight="Bold"/>
                                    <Slider x:Name="EyeSpacingSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Vertical position" FontWeight="Bold"/>
                                    <Slider x:Name="EyeVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Brows">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock Text="Brow style" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowTypeSlider" Minimum="0" Maximum="23" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Rotation" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowRotationSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Color" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Size" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Spacing" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowSpacingSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Vertical position" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Nose">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock Text="Nose style" FontWeight="Bold"/>
                                    <Slider x:Name="NoseTypeSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Size" FontWeight="Bold"/>
                                    <Slider x:Name="NoseSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Vertical position" FontWeight="Bold"/>
                                    <Slider x:Name="NoseVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Mouth">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock Text="Mouth style" FontWeight="Bold"/>
                                    <Slider x:Name="MouthTypeSlider" Minimum="0" Maximum="23" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Color" FontWeight="Bold"/>
                                    <Slider x:Name="MouthColorSlider" Minimum="0" Maximum="3" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Size" FontWeight="Bold"/>
                                    <Slider x:Name="MouthSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Vertical position" FontWeight="Bold"/>
                                    <Slider x:Name="MouthVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Beard">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock Text="Mustache" FontWeight="Bold"/>
                                    <Slider x:Name="MustacheTypeSlider" Minimum="0" Maximum="3" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Beard" FontWeight="Bold"/>
                                    <Slider x:Name="BeardTypeSlider" Minimum="0" Maximum="3" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Color" FontWeight="Bold"/>
                                    <Slider x:Name="FacialHairColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Mustache size" FontWeight="Bold"/>
                                    <Slider x:Name="MustacheSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Mustache position" FontWeight="Bold"/>
                                    <Slider x:Name="MustacheVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Glasses">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock Text="Glasses style" FontWeight="Bold"/>
                                    <Slider x:Name="GlassesTypeSlider" Minimum="0" Maximum="8" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Color" FontWeight="Bold"/>
                                    <Slider x:Name="GlassesColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Size" FontWeight="Bold"/>
                                    <Slider x:Name="GlassesSizeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Vertical position" FontWeight="Bold"/>
                                    <Slider x:Name="GlassesVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Mole">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <CheckBox x:Name="MoleEnabledCheckBox" Content="Enable mole" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                    <TextBlock Text="Size" FontWeight="Bold"/>
                                    <Slider x:Name="MoleSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Vertical position" FontWeight="Bold"/>
                                    <Slider x:Name="MoleVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock Text="Horizontal position" FontWeight="Bold"/>
                                    <Slider x:Name="MoleHorizontalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
