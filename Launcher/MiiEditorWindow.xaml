                                    <TextBlock x:Name="GlassesVerticalValueTextBlock" Text="Position 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="GlassesVerticalSlider" Minimum="0" Maximum="20" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustMoleTab" Header="Mole">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,14,4" ClipToBounds="False">
                                <StackPanel Margin="0,0,4,0" ClipToBounds="False">
                                    <TextBlock x:Name="MoleSizeValueTextBlock" Text="Mole size 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="MoleSizeSlider" Minimum="0" Maximum="8" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MoleVerticalValueTextBlock" Text="Vertical position 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="MoleVerticalSlider" Minimum="0" Maximum="18" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MoleHorizontalValueTextBlock" Text="Horizontal position 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="MoleHorizontalSlider" Minimum="0" Maximum="16" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
