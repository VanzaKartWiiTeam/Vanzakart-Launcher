                                    <Slider x:Name="NoseTypeSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="NoseSizeValueTextBlock" Text="Size 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="NoseSizeSlider" Minimum="0" Maximum="8" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="NoseVerticalValueTextBlock" Text="Position 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
