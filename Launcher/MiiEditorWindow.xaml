<Window x:Class="VanzaKartLauncher.MiiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mii Editor"
        Width="960"
        Height="680"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#090D18"
        Foreground="#F7FAFF">

    <Window.Resources>
        <SolidColorBrush x:Key="EditorTextPrimary" Color="#F7FAFF"/>
        <SolidColorBrush x:Key="EditorTextSecondary" Color="#AAB6D3"/>
        <SolidColorBrush x:Key="EditorTextFaint" Color="#66728F"/>
        <SolidColorBrush x:Key="EditorPanel" Color="#D012192A"/>
        <SolidColorBrush x:Key="EditorPanelSoft" Color="#A80C1222"/>
        <SolidColorBrush x:Key="EditorStroke" Color="#31405F"/>

        <LinearGradientBrush x:Key="EditorRainbow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.00" Color="#FF3B7A"/>
            <GradientStop Offset="0.18" Color="#FFB84A"/>
            <GradientStop Offset="0.35" Color="#F7FF57"/>
            <GradientStop Offset="0.52" Color="#4DFF8D"/>
            <GradientStop Offset="0.68" Color="#39E7FF"/>
            <GradientStop Offset="0.84" Color="#5A6DFF"/>
            <GradientStop Offset="1.00" Color="#C65CFF"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="EditorBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#080B16"/>
            <GradientStop Offset="0.38" Color="#11172C"/>
            <GradientStop Offset="0.72" Color="#071A25"/>
            <GradientStop Offset="1" Color="#170D24"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="EditorGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.48" Color="#39E7FF"/>
        <DropShadowEffect x:Key="EditorSoftShadow" BlurRadius="34" ShadowDepth="0" Opacity="0.36" Color="#000000"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource EditorPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource EditorSoftShadow}"/>
        </Style>

        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2640"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3B4B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#253657"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#66E8FF"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.018" ScaleY="1.018"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPrimaryButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="{StaticResource EditorRainbow}"/>
            <Setter Property="BorderBrush" Value="#A8FFFFFF"/>
            <Setter Property="Effect" Value="{StaticResource EditorGlow}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1020"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#354262"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#39E7FF"/>
            <Setter Property="Margin" Value="0,8,0,18"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="AutoToolTipPlacement" Value="TopLeft"/>
            <Setter Property="AutoToolTipPrecision" Value="0"/>
            <Setter Property="TickPlacement" Value="BottomRight"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource EditorTextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="#111A2C" BorderBrush="#2D3A57" BorderThickness="1" CornerRadius="8" Margin="0,0,8,8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource EditorRainbow}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B8FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource EditorBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#263654" BorderThickness="0,0,0,1" Background="#78070A13">
            <Grid Margin="18,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mii Studio" FontSize="21" FontWeight="Black"/>
                    <TextBlock Text="Preview live, opzioni a pagine, regolazioni nei menu" Foreground="{StaticResource EditorTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="Close" Width="82" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource EditorButton}" Click="CloseButton_OnClick"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource EditorCard}" Padding="16" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="PreviewNameTextBlock" Text="Mii" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewMetaTextBlock" Text="Ready" Foreground="{StaticResource EditorTextSecondary}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Width="238" Height="292" CornerRadius="8" Background="#0B1020" BorderBrush="#3A4A6D" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Rectangle Fill="{StaticResource EditorRainbow}" Opacity="0.14"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10"/>
                            <TextBlock x:Name="PreviewPlaceholderTextBlock" Text="Rendering..." FontSize="15" FontWeight="Black" Foreground="{StaticResource EditorTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="RenderStatusTextBlock" Text="Renderer ready" Foreground="{StaticResource EditorTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Random" Style="{StaticResource EditorPrimaryButton}" Margin="0,0,8,8" Click="RandomizeButton_OnClick"/>
                            <Button Content="Reset" Style="{StaticResource EditorButton}" Margin="0,0,8,8" Click="ResetButton_OnClick"/>
                            <Button Content="Export" Style="{StaticResource EditorButton}" Margin="0,0,0,8" Click="ExportButton_OnClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="AutosaveTextBlock" Text="Autosave active" Foreground="{StaticResource EditorTextFaint}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource EditorCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="94"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameTextBox" TextChanged="EditorControl_OnChanged" ToolTip="Nome Mii"/>
                        <Button x:Name="SymbolButton" Grid.Column="1" Content="Simboli" Margin="8,0,0,0" Style="{StaticResource EditorButton}" Click="SymbolButton_OnClick"/>
                        <TextBox x:Name="CreatorTextBox" Grid.Column="2" Margin="10,0,0,0" TextChanged="EditorControl_OnChanged" ToolTip="Creator"/>
                        <Button x:Name="OpenAdjustPopupButton" Grid.Column="3" Content="Regola" Margin="8,0,0,0" Style="{StaticResource EditorPrimaryButton}" Click="OpenAdjustPopupButton_OnClick"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="‹" Width="34" Height="34" Style="{StaticResource EditorButton}" Click="PreviousCategoryButton_OnClick"/>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="CategoryRailWrapPanel"/>
                        </ScrollViewer>
                        <Button Grid.Column="2" Content="›" Width="34" Height="34" HorizontalAlignment="Right" Style="{StaticResource EditorButton}" Click="NextCategoryButton_OnClick"/>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource EditorPanelSoft}" BorderBrush="#263654" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CurrentCategoryTitleTextBlock" Text="Volto" FontWeight="Black" FontSize="18"/>
                                <TextBlock x:Name="CurrentCategoryHintTextBlock" Text="Scegli una forma, poi usa Regola per dimensione e posizione." Foreground="{StaticResource EditorTextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviousOptionsButton" Content="‹" Width="36" Height="34" Style="{StaticResource EditorButton}" Click="PreviousOptionsButton_OnClick"/>
                                <TextBlock x:Name="OptionsPageTextBlock" Text="1/1" Width="58" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Black"/>
                                <Button x:Name="NextOptionsButton" Content="›" Width="36" Height="34" Style="{StaticResource EditorButton}" Click="NextOptionsButton_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="FeaturePreviewWrapPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="SymbolPopup" AllowsTransparency="True" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=SymbolButton}">
            <Border Width="430" MaxHeight="300" Background="#F011192A" BorderBrush="#4A5F8E" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource EditorSoftShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="NameSymbolWrapPanel"/>
                </ScrollViewer>
            </Border>
        </Popup>

        <Popup x:Name="AdjustPopup" AllowsTransparency="True" StaysOpen="False" Placement="Left" PlacementTarget="{Binding ElementName=OpenAdjustPopupButton}">
            <Border Width="560" MaxHeight="500" Background="#F011192A" BorderBrush="#4A5F8E" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource EditorSoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Regolazioni fini" FontSize="18" FontWeight="Black"/>
                        <Button Content="Close" Width="72" Height="30" HorizontalAlignment="Right" Style="{StaticResource EditorButton}" Click="CloseAdjustPopupButton_OnClick"/>
                    </Grid>
                    <TabControl Grid.Row="1">
                        <TabItem Header="Base">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox x:Name="FemaleCheckBox" Content="Female" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="FavoriteCheckBox" Content="Favorite" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="HairFlipCheckBox" Content="Flip hair" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="MoleEnabledCheckBox" Content="Neo" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="FavoriteColorValueTextBlock" Text="Colore 1" FontWeight="Bold"/>
                                    <Slider x:Name="FavoriteColorSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="HeightValueTextBlock" Text="Altezza 64" FontWeight="Bold"/>
                                    <Slider x:Name="HeightSlider" Minimum="0" Maximum="127" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="WeightValueTextBlock" Text="Peso 64" FontWeight="Bold"/>
                                    <Slider x:Name="WeightSlider" Minimum="0" Maximum="127" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Volto">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock x:Name="FaceShapeValueTextBlock" Text="Forma volto 1" FontWeight="Bold"/>
                                    <Slider x:Name="FaceShapeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="SkinColorValueTextBlock" Text="Pelle 1" FontWeight="Bold"/>
                                    <Slider x:Name="SkinColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="FacialFeatureValueTextBlock" Text="Dettagli 1" FontWeight="Bold"/>
                                    <Slider x:Name="FacialFeatureSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Capelli">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock x:Name="HairTypeValueTextBlock" Text="Stile capelli 1" FontWeight="Bold"/>
                                    <Slider x:Name="HairTypeSlider" Minimum="0" Maximum="71" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="HairColorValueTextBlock" Text="Colore capelli 1" FontWeight="Bold"/>
                                    <Slider x:Name="HairColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Occhi">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock x:Name="EyeTypeValueTextBlock" Text="Stile occhi 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyeTypeSlider" Minimum="0" Maximum="47" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeRotationValueTextBlock" Text="Rotazione 0" FontWeight="Bold"/>
                                    <Slider x:Name="EyeRotationSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeColorValueTextBlock" Text="Colore 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyeColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeSizeValueTextBlock" Text="Dimensione 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyeSizeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeSpacingValueTextBlock" Text="Distanza 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyeSpacingSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeVerticalValueTextBlock" Text="Posizione 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyeVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Sopracciglia">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock x:Name="EyebrowTypeValueTextBlock" Text="Stile sopracciglia 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowTypeSlider" Minimum="0" Maximum="23" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyebrowRotationValueTextBlock" Text="Rotazione 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowRotationSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyebrowColorValueTextBlock" Text="Colore 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyebrowSizeValueTextBlock" Text="Dimensione 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyebrowSpacingValueTextBlock" Text="Distanza 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowSpacingSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyebrowVerticalValueTextBlock" Text="Posizione 1" FontWeight="Bold"/>
                                    <Slider x:Name="EyebrowVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Naso">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock x:Name="NoseTypeValueTextBlock" Text="Stile naso 1" FontWeight="Bold"/>
                                    <Slider x:Name="NoseTypeSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="NoseSizeValueTextBlock" Text="Dimensione 1" FontWeight="Bold"/>
                                    <Slider x:Name="NoseSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="NoseVerticalValueTextBlock" Text="Posizione 1" FontWeight="Bold"/>
                                    <Slider x:Name="NoseVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Bocca">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock x:Name="MouthTypeValueTextBlock" Text="Stile bocca 1" FontWeight="Bold"/>
                                    <Slider x:Name="MouthTypeSlider" Minimum="0" Maximum="23" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MouthColorValueTextBlock" Text="Colore 1" FontWeight="Bold"/>
                                    <Slider x:Name="MouthColorSlider" Minimum="0" Maximum="3" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MouthSizeValueTextBlock" Text="Dimensione 1" FontWeight="Bold"/>
                                    <Slider x:Name="MouthSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MouthVerticalValueTextBlock" Text="Posizione 1" FontWeight="Bold"/>
                                    <Slider x:Name="MouthVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Extra">
                            <ScrollViewer>
                                <StackPanel Margin="2,10,8,0">
                                    <TextBlock x:Name="MustacheTypeValueTextBlock" Text="Baffi 1" FontWeight="Bold"/>
                                    <Slider x:Name="MustacheTypeSlider" Minimum="0" Maximum="3" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="BeardTypeValueTextBlock" Text="Barba 1" FontWeight="Bold"/>
                                    <Slider x:Name="BeardTypeSlider" Minimum="0" Maximum="3" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="FacialHairColorValueTextBlock" Text="Colore 1" FontWeight="Bold"/>
                                    <Slider x:Name="FacialHairColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MustacheSizeValueTextBlock" Text="Dimensione baffi 1" FontWeight="Bold"/>
                                    <Slider x:Name="MustacheSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MustacheVerticalValueTextBlock" Text="Posizione baffi 1" FontWeight="Bold"/>
                                    <Slider x:Name="MustacheVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="GlassesTypeValueTextBlock" Text="Stile occhiali 1" FontWeight="Bold"/>
                                    <Slider x:Name="GlassesTypeSlider" Minimum="0" Maximum="8" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="GlassesColorValueTextBlock" Text="Colore 1" FontWeight="Bold"/>
                                    <Slider x:Name="GlassesColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="GlassesSizeValueTextBlock" Text="Dimensione 1" FontWeight="Bold"/>
                                    <Slider x:Name="GlassesSizeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="GlassesVerticalValueTextBlock" Text="Posizione 1" FontWeight="Bold"/>
                                    <Slider x:Name="GlassesVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MoleSizeValueTextBlock" Text="Dimensione neo 1" FontWeight="Bold"/>
                                    <Slider x:Name="MoleSizeSlider" Minimum="0" Maximum="15" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MoleVerticalValueTextBlock" Text="Posizione verticale 1" FontWeight="Bold"/>
                                    <Slider x:Name="MoleVerticalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MoleHorizontalValueTextBlock" Text="Posizione orizzontale 1" FontWeight="Bold"/>
                                    <Slider x:Name="MoleHorizontalSlider" Minimum="0" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
