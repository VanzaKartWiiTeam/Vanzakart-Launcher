<Window x:Class="VanzaKartLauncher.MiiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mii Editor"
        Width="1320"
        Height="820"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="#090D18"
        Foreground="#F7FAFF"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <SolidColorBrush x:Key="EditorTextPrimary" Color="#F7FAFF"/>
        <SolidColorBrush x:Key="EditorTextSecondary" Color="#AAB6D3"/>
        <SolidColorBrush x:Key="EditorTextFaint" Color="#66728F"/>
        <SolidColorBrush x:Key="EditorPanel" Color="#D012192A"/>
        <SolidColorBrush x:Key="EditorPanelSoft" Color="#A80C1222"/>
        <SolidColorBrush x:Key="EditorStroke" Color="#31405F"/>

        <LinearGradientBrush x:Key="EditorRainbow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.00" Color="#FF3B7A"/>
            <GradientStop Offset="0.18" Color="#FFB84A"/>
            <GradientStop Offset="0.35" Color="#F7FF57"/>
            <GradientStop Offset="0.52" Color="#4DFF8D"/>
            <GradientStop Offset="0.68" Color="#39E7FF"/>
            <GradientStop Offset="0.84" Color="#5A6DFF"/>
            <GradientStop Offset="1.00" Color="#C65CFF"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="EditorBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#080B16"/>
            <GradientStop Offset="0.38" Color="#11172C"/>
            <GradientStop Offset="0.72" Color="#071A25"/>
            <GradientStop Offset="1" Color="#170D24"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="EditorGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.48" Color="#39E7FF"/>
        <DropShadowEffect x:Key="EditorSoftShadow" BlurRadius="34" ShadowDepth="0" Opacity="0.36" Color="#000000"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource EditorPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource EditorSoftShadow}"/>
        </Style>

        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2640"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3B4B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#253657"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#66E8FF"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.018" ScaleY="1.018"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPrimaryButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="{StaticResource EditorRainbow}"/>
            <Setter Property="BorderBrush" Value="#A8FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Effect" Value="{StaticResource EditorGlow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="315" Opacity="1.0" Color="Black"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.018" ScaleY="1.018"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1020"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#354262"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#39E7FF"/>
            <Setter Property="Background" Value="#152033"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground" Grid.Row="1" Height="6" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Grid.Row="1" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3,0,0,3" Background="{TemplateBinding Foreground}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#39E7FF" StrokeThickness="2.5" Width="16" Height="16"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="0,3,3,0" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="HiddenHeadersTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource EditorTextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="#111A2C" BorderBrush="#2D3A57" BorderThickness="1" CornerRadius="8" Margin="0,0,8,8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource EditorRainbow}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B8FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="HeaderContent" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="315" Opacity="0.8" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource EditorBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#263654" BorderThickness="0,0,0,1" Background="#78070A13">
            <Grid Margin="18,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mii Studio" FontSize="22" FontWeight="Black"/>
                    <TextBlock Text="Crea il tuo Mii personalizzato in tempo reale." Foreground="{StaticResource EditorTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="Close" Width="90" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource EditorButton}" Click="CloseButton_OnClick"/>
            </Grid>
        </Border>

        <!-- Main Content Area (3-Column Layout) -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Mii Preview and Info Card -->
            <Border Grid.Column="0" Style="{StaticResource EditorCard}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Meta -->
                        <RowDefinition Height="Auto"/> <!-- Mii Card Preview -->
                        <RowDefinition Height="*"/>    <!-- Text Inputs -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons Toolbar -->
                    </Grid.RowDefinitions>

                    <!-- Title & Meta -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock x:Name="PreviewNameTextBlock" Text="Mii" FontSize="24" FontWeight="Black" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewMetaTextBlock" Text="Ready" Foreground="{StaticResource EditorTextSecondary}" FontWeight="SemiBold" Margin="0,4,0,0" FontSize="13"/>
                    </StackPanel>

                    <!-- Mii Card Preview -->
                    <Border Grid.Row="1" Width="260" Height="292" CornerRadius="12" Background="#0B1020" BorderBrush="#3A4A6D" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,0,16" Effect="{StaticResource EditorSoftShadow}">
                        <Grid>
                            <Rectangle Fill="{StaticResource EditorRainbow}" Opacity="0.14"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="14" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="PreviewPlaceholderTextBlock" Text="Rendering..." FontSize="16" FontWeight="Black" Foreground="{StaticResource EditorTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Text Inputs (Name, Creator) -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,16">
                        <TextBlock Text="NOME MII" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NameTextBox" TextChanged="EditorControl_OnChanged" ToolTip="Nome Mii" MaxLength="10" Height="42" FontSize="14" Padding="12,8"/>
                            <Button x:Name="SymbolButton" Grid.Column="2" Content="☺" Width="42" Height="42" ToolTip="Simboli" Style="{StaticResource EditorButton}" Click="SymbolButton_OnClick" FontSize="16"/>
                        </Grid>

                        <TextBlock Text="CREATORE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" Margin="0,0,0,6"/>
                        <TextBox x:Name="CreatorTextBox" TextChanged="EditorControl_OnChanged" ToolTip="Creator" Height="42" FontSize="14" Padding="12,8" Margin="0,0,0,14"/>

                        <TextBlock x:Name="RenderStatusTextBlock" Text="Renderer ready" Foreground="{StaticResource EditorTextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,4"/>
                        <TextBlock x:Name="AutosaveTextBlock" Text="No unsaved changes" Foreground="{StaticResource EditorTextFaint}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Action Buttons Toolbar -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Row 0: Save & Cancel -->
                        <Button x:Name="SaveMiiButton" Grid.Row="0" Grid.Column="0" Content="Salva" Style="{StaticResource EditorPrimaryButton}" Height="46" Click="SaveMiiButton_OnClick" FontSize="14"/>
                        <Button x:Name="CancelMiiButton" Grid.Row="0" Grid.Column="2" Content="Annulla" Style="{StaticResource EditorButton}" Height="46" Click="CancelMiiButton_OnClick" FontSize="14"/>
                        
                        <!-- Row 1: Random & Reset -->
                        <Button Grid.Row="1" Grid.Column="0" Content="Casuale" Margin="0,10,0,0" Style="{StaticResource EditorButton}" Height="42" Click="RandomizeButton_OnClick" FontSize="13"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Ripristina" Margin="0,10,0,0" Style="{StaticResource EditorButton}" Height="42" Click="ResetButton_OnClick" FontSize="13"/>

                        <!-- Row 2: Export -->
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Esporta file .mii" Margin="0,10,0,0" Style="{StaticResource EditorButton}" Height="42" Click="ExportButton_OnClick" FontSize="13"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Column 1: Feature Browsing & Previews -->
            <Border Grid.Column="1" Style="{StaticResource EditorCard}" Margin="10,0,10,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Large Category tabs navigation -->
                        <RowDefinition Height="Auto"/> <!-- Title & Hint for selected category -->
                        <RowDefinition Height="*"/>    <!-- Feature Previews WrapPanel -->
                    </Grid.RowDefinitions>

                    <!-- Category Navigation -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="‹" Width="44" Height="44" Style="{StaticResource EditorButton}" Click="PreviousCategoryButton_OnClick" FontSize="18"/>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="8,0">
                            <StackPanel x:Name="CategoryRailWrapPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>
                        <Button Grid.Column="2" Content="›" Width="44" Height="44" HorizontalAlignment="Right" Style="{StaticResource EditorButton}" Click="NextCategoryButton_OnClick" FontSize="18"/>
                    </Grid>

                    <!-- Selected Category Header -->
                    <Border Grid.Row="1" Background="{StaticResource EditorPanelSoft}" BorderBrush="#263654" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CurrentCategoryTitleTextBlock" Text="Volto" FontWeight="Black" FontSize="22"/>
                                <TextBlock x:Name="CurrentCategoryHintTextBlock" Text="Scegli una forma, poi usa Regola per dimensione e posizione." Foreground="{StaticResource EditorTextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviousOptionsButton" Content="‹" Width="42" Height="40" Style="{StaticResource EditorButton}" Click="PreviousOptionsButton_OnClick" FontSize="16"/>
                                <TextBlock x:Name="OptionsPageTextBlock" Text="1/1" Width="64" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Black" FontSize="14"/>
                                <Button x:Name="NextOptionsButton" Content="›" Width="42" Height="40" Style="{StaticResource EditorButton}" Click="NextOptionsButton_OnClick" FontSize="16"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Element Previews Grid -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FeaturePreviewWrapPanel" HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Column 2: Contextual Adjustment Sidebar -->
            <Border Grid.Column="2" Style="{StaticResource EditorCard}" Margin="10,0,0,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Scrollable sliders -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="REGOLAZIONI" FontSize="16" FontWeight="Black" Foreground="{StaticResource EditorTextSecondary}" Margin="0,0,0,14"/>

                    <TabControl x:Name="AdjustTabs" Grid.Row="1" Style="{StaticResource HiddenHeadersTabControl}">
                        <TabItem x:Name="AdjustBaseTab" Header="Base">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <WrapPanel Margin="0,0,0,14">
                                        <CheckBox x:Name="FemaleCheckBox" Content="Female" Margin="0,4,12,4" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="FavoriteCheckBox" Content="Favorite" Margin="0,4,12,4" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="HairFlipCheckBox" Content="Flip hair" Margin="0,4,12,4" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="MoleEnabledCheckBox" Content="Neo" Margin="0,4,12,4" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="FavoriteColorValueTextBlock" Text="Colore 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="FavoriteColorSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="HeightValueTextBlock" Text="Altezza 64" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="HeightSlider" Minimum="0" Maximum="127" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="WeightValueTextBlock" Text="Peso 64" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="WeightSlider" Minimum="0" Maximum="127" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustFaceTab" Header="Volto">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="FaceShapeValueTextBlock" Text="Forma volto 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="FaceShapeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="SkinColorValueTextBlock" Text="Pelle 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="SkinColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="FacialFeatureValueTextBlock" Text="Dettagli 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="FacialFeatureSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustHairTab" Header="Capelli">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="HairTypeValueTextBlock" Text="Stile capelli 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="HairTypeSlider" Minimum="0" Maximum="71" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="HairColorValueTextBlock" Text="Colore capelli 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="HairColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustEyesTab" Header="Occhi">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="EyeTypeValueTextBlock" Text="Stile occhi 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="EyeTypeSlider" Minimum="0" Maximum="47" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="EyeRotationValueTextBlock" Text="Rotazione 0" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeRotationSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeColorValueTextBlock" Text="Colore 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeSizeValueTextBlock" Text="Dimensione 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeSizeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeSpacingValueTextBlock" Text="Distanza 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeSpacingSlider" Minimum="0" Maximum="12" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeVerticalValueTextBlock" Text="Posizione 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeVerticalSlider" Minimum="0" Maximum="18" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
