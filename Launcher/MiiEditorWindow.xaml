                                    <TextBlock x:Name="MouthSizeValueTextBlock" Text="Size 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="MouthSizeSlider" Minimum="0" Maximum="8" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MouthVerticalValueTextBlock" Text="Position 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="MouthVerticalSlider" Minimum="0" Maximum="18" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustBeardTab" Header="Facial Hair">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,14,4" ClipToBounds="False">
                                <StackPanel Margin="0,0,4,0" ClipToBounds="False">
                                    <TextBlock x:Name="MustacheTypeValueTextBlock" Text="Mustache 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="MustacheTypeSlider" Minimum="0" Maximum="3" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="BeardTypeValueTextBlock" Text="Beard 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="BeardTypeSlider" Minimum="0" Maximum="3" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock Text="— Shared —" FontWeight="Bold" FontSize="12" Foreground="{StaticResource EditorTextFaint}" Margin="0,4,0,6"/>
                                    <TextBlock x:Name="FacialHairColorValueTextBlock" Text="Color 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
