<Window x:Class="VanzaKartLauncher.MiiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mii Editor"
        Width="1320"
        Height="820"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="#090D18"
        Foreground="#F7FAFF"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <SolidColorBrush x:Key="EditorTextPrimary" Color="#F7FAFF"/>
        <SolidColorBrush x:Key="EditorTextSecondary" Color="#AAB6D3"/>
        <SolidColorBrush x:Key="EditorTextFaint" Color="#66728F"/>
        <SolidColorBrush x:Key="EditorPanel" Color="#D012192A"/>
        <SolidColorBrush x:Key="EditorPanelSoft" Color="#A80C1222"/>
        <SolidColorBrush x:Key="EditorStroke" Color="#31405F"/>

        <LinearGradientBrush x:Key="EditorRainbow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.00" Color="#FF0066"/>
            <GradientStop Offset="0.18" Color="#FF8800"/>
            <GradientStop Offset="0.35" Color="#FFEA00"/>
            <GradientStop Offset="0.52" Color="#00FF66"/>
            <GradientStop Offset="0.68" Color="#00F2FF"/>
            <GradientStop Offset="0.84" Color="#3300FF"/>
            <GradientStop Offset="1.00" Color="#B000FF"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="EditorBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#080B16"/>
            <GradientStop Offset="0.38" Color="#11172C"/>
            <GradientStop Offset="0.72" Color="#071A25"/>
            <GradientStop Offset="1" Color="#170D24"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="EditorGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.48" Color="#39E7FF"/>
        <DropShadowEffect x:Key="EditorSoftShadow" BlurRadius="34" ShadowDepth="0" Opacity="0.36" Color="#000000"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource EditorPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect" Value="{StaticResource EditorSoftShadow}"/>
        </Style>

        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2640"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3B4B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#253657" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#66E8FF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1B2640" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#3B4B70" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPrimaryButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="#151E33"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorRainbow}"/>
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="2">
                            <!-- Rainbow Neon Glow Backdrop -->
                            <Border x:Name="GlowBorder" CornerRadius="10" Background="{StaticResource EditorRainbow}" Opacity="0.35" Margin="-4">
                                <Border.Effect>
                                    <BlurEffect Radius="10"/>
                                </Border.Effect>
                            </Border>

                            <!-- Main Button Card -->
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.8"
                                    CornerRadius="8"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="315" Opacity="0.6" Color="Black"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.80" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1F2C4C" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#151E33" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.05"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1020"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#354262"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#39E7FF"/>
            <Setter Property="Background" Value="#152033"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground" Grid.Row="1" Height="8" CornerRadius="4" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Grid.Row="1" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8" CornerRadius="4,0,0,4" Background="{TemplateBinding Foreground}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>
                                                    <Ellipse x:Name="ThumbGlow" Width="26" Height="26" Fill="#39E7FF" Opacity="0" Margin="-3">
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="6"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse x:Name="ThumbCircle" Fill="#F7FAFF" Stroke="#39E7FF" StrokeThickness="2.5" Width="20" Height="20"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.25" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.25" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.15"/>
                                                                    <ColorAnimation Storyboard.TargetName="ThumbCircle" Storyboard.TargetProperty="(Ellipse.Stroke).(SolidColorBrush.Color)" To="#66E8FF" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
                                                                    <ColorAnimation Storyboard.TargetName="ThumbCircle" Storyboard.TargetProperty="(Ellipse.Stroke).(SolidColorBrush.Color)" To="#39E7FF" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.08"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.08"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.08"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbGlow" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8" CornerRadius="0,4,4,0" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="CheckBoxRoot" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="58" Height="38">
                                <Border x:Name="ActiveGlow" Width="50" Height="28" CornerRadius="14" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#FFFF2D8D"/>
                                            <GradientStop Offset="0.34" Color="#FFFFD23F"/>
                                            <GradientStop Offset="0.67" Color="#FF22D3EE"/>
                                            <GradientStop Offset="1" Color="#FFC026FF"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect><BlurEffect Radius="9"/></Border.Effect>
                                </Border>
                                <Border x:Name="Track" Width="50" Height="28" CornerRadius="14"
                                        Background="#202A40" BorderBrush="#465572" BorderThickness="1.25">
                                    <Grid ClipToBounds="True">
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,47.5,25.5" RadiusX="12.75" RadiusY="12.75"/>
                                        </Grid.Clip>
                                        <Border x:Name="RainbowFill" CornerRadius="13" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0.00" Color="#FFFF2D8D"/><GradientStop Offset="0.17" Color="#FFFF6B24"/>
                                                    <GradientStop Offset="0.33" Color="#FFFFDF3E"/><GradientStop Offset="0.50" Color="#FF34E67A"/>
                                                    <GradientStop Offset="0.67" Color="#FF20D7ED"/><GradientStop Offset="0.83" Color="#FF4568FF"/>
                                                    <GradientStop Offset="1.00" Color="#FFC13BFF"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Border Width="90" HorizontalAlignment="Left" Opacity="0.58">
                                                    <Border.RenderTransform><TranslateTransform X="-38"/></Border.RenderTransform>
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                     From="-38" To="-4" Duration="0:0:3.6"
                                                                                     AutoReverse="True" RepeatBehavior="Forever">
                                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Border.Triggers>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                            <GradientStop Offset="0.00" Color="#00FFFFFF"/><GradientStop Offset="0.18" Color="#C0FF35A8"/>
                                                            <GradientStop Offset="0.38" Color="#B0FFD84A"/><GradientStop Offset="0.58" Color="#B03CF0C5"/>
                                                            <GradientStop Offset="0.78" Color="#B0527BFF"/><GradientStop Offset="1.00" Color="#00D53CFF"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="RainbowSheen" CornerRadius="13" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#70FFFFFF"/>
                                                    <GradientStop Offset="0.48" Color="#12FFFFFF"/>
                                                    <GradientStop Offset="1" Color="#28000000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Ellipse x:Name="ThumbShadow" Width="18" Height="18" Margin="9,0,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#99000000" Opacity="0.5">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbShadowTranslate"/></Ellipse.RenderTransform>
                                    <Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="9,0,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#CFD8E8" Stroke="#80FFFFFF" StrokeThickness="1">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbTranslate"/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShadowTranslate" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RainbowFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="RainbowSheen" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.28"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShadowTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="RainbowFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="RainbowSheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#CCFFFFFF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="Stroke" Value="#E6FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#7EEBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxRoot" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenHeadersTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource EditorTextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="#111A2C" BorderBrush="#2D3A57" BorderThickness="1" CornerRadius="8" Margin="0,0,8,8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource EditorRainbow}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B8FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="HeaderContent" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="315" Opacity="0.8" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Scrollbar Styles -->
        <Style x:Key="SleekScrollBarThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#39E7FF" Opacity="0.3" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SleekScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating Preview Toggle Button Style -->
        <Style x:Key="PreviewToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A00B1020"/>
            <Setter Property="Foreground" Value="#AAB6D3"/>
            <Setter Property="BorderBrush" Value="#31405F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Root" Property="Background" Value="#CC152033"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Root" Property="Background" Value="#39E7FF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39E7FF"/>
                                <Setter Property="Foreground" Value="#090D18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Toggle Button Style -->
        <Style x:Key="SegmentedToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAB6D3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E2942"/>
                                <Setter Property="Foreground" Value="#F7FAFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Root" Property="Background" Value="#39E7FF"/>
                                <Setter Property="Foreground" Value="#090D18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <EventSetter Event="PreviewMouseWheel" Handler="ScrollViewer_PreviewMouseWheel"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource EditorBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#263654" BorderThickness="0,0,0,1" Background="#78070A13">
            <Grid Margin="18,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mii Studio" FontSize="22" FontWeight="Black"/>
                    <TextBlock Text="Create your custom Mii in real time." Foreground="{StaticResource EditorTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="Close" Width="90" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource EditorButton}" Click="CloseButton_OnClick"/>
            </Grid>
        </Border>

        <!-- Main Content Area (3-Column Layout) -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Mii Preview and Info Card -->
            <Border Grid.Column="0" Style="{StaticResource EditorCard}" Margin="0,0,10,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Meta + Preview Card -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Text Inputs -->
                        <RowDefinition Height="Auto"/> <!-- Fixed Action Buttons Toolbar -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Title & Meta + Preview -->
                    <StackPanel Grid.Row="0">
                        <!-- Title & Meta -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock x:Name="PreviewNameTextBlock" Text="Mii" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewMetaTextBlock" Text="Ready" Foreground="{StaticResource EditorTextSecondary}" FontWeight="SemiBold" Margin="0,2,0,0" FontSize="12"/>
                        </StackPanel>

                        <!-- Mii Card Preview Grid with Floating Overlays -->
                        <Grid Width="260" Height="292" Margin="0,0,0,14" HorizontalAlignment="Center">
                            <!-- Base Card -->
                            <Border CornerRadius="12" Background="#0B1020" BorderBrush="#3A4A6D" BorderThickness="1.5" ClipToBounds="True" Effect="{StaticResource EditorSoftShadow}">
                                <Grid>
                                    <Rectangle Fill="{StaticResource EditorRainbow}" Opacity="0.14"/>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="14" RenderOptions.BitmapScalingMode="Fant" UseLayoutRounding="True"/>
                                    <TextBlock x:Name="PreviewPlaceholderTextBlock" Text="Rendering..." FontSize="16" FontWeight="Black" Foreground="{StaticResource EditorTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Bottom-Center View Toggle (Segmented control) -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="36" Background="#A00B1020" BorderBrush="#31405F" BorderThickness="1" CornerRadius="18" Padding="2" Margin="0,0,0,12" Effect="{StaticResource EditorSoftShadow}">
                                <UniformGrid Columns="2" Width="150">
                                    <Button x:Name="FaceViewButton" Content="FACE" FontSize="11" FontWeight="Black" Style="{StaticResource SegmentedToggleButtonStyle}" Click="FaceViewButton_Click"/>
                                    <Button x:Name="BodyViewButton" Content="BODY" FontSize="11" FontWeight="Black" Style="{StaticResource SegmentedToggleButtonStyle}" Click="BodyViewButton_Click"/>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Row 1: Scrollable Text Inputs (Name, Creator) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Margin="0,4,0,10">
                        <StackPanel Margin="0,4,0,4">
                            <TextBlock Text="MII NAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NameTextBox" TextChanged="EditorControl_OnChanged" ToolTip="Mii Name" MaxLength="10" Height="40" FontSize="13.5" Padding="10,8"/>
                                <Button x:Name="SymbolButton" Grid.Column="2" Content="&#xED58;" FontFamily="Segoe MDL2 Assets" Width="40" Height="40" ToolTip="Symbols" Style="{StaticResource EditorButton}" Click="SymbolButton_OnClick" FontSize="15"/>
                            </Grid>

                            <TextBlock Text="CREATOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="CreatorTextBox" TextChanged="EditorControl_OnChanged" ToolTip="Creator" Height="40" FontSize="13.5" Padding="10,8" Margin="0,0,0,12"/>

                            <TextBlock x:Name="RenderStatusTextBlock" Text="Renderer ready" Foreground="{StaticResource EditorTextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,2"/>
                            <TextBlock x:Name="AutosaveTextBlock" Text="No unsaved changes" Foreground="{StaticResource EditorTextFaint}" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 2: Fixed Action Buttons Toolbar -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Row 0: Save & Cancel -->
                        <Button x:Name="SaveMiiButton" Grid.Row="0" Grid.Column="0" Content="Save" Style="{StaticResource EditorPrimaryButton}" Height="44" Click="SaveMiiButton_OnClick" FontSize="13.5"/>
                        <Button x:Name="CancelMiiButton" Grid.Row="0" Grid.Column="2" Content="Cancel" Style="{StaticResource EditorButton}" Height="44" Click="CancelMiiButton_OnClick" FontSize="13.5"/>
                        
                        <!-- Row 1: Random & Reset -->
                        <Button Grid.Row="1" Grid.Column="0" Content="Random" Margin="0,8,0,0" Style="{StaticResource EditorButton}" Height="40" Click="RandomizeButton_OnClick" FontSize="13"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Reset" Margin="0,8,0,0" Style="{StaticResource EditorButton}" Height="40" Click="ResetButton_OnClick" FontSize="13"/>

                        <!-- Row 2: Export -->
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Export .mii file" Margin="0,8,0,0" Style="{StaticResource EditorButton}" Height="40" Click="ExportButton_OnClick" FontSize="13"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Column 1: Feature Browsing & Previews -->
            <Border Grid.Column="1" Style="{StaticResource EditorCard}" Margin="10,0,10,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Large Category tabs navigation -->
                        <RowDefinition Height="Auto"/> <!-- Title & Hint for selected category -->
                        <RowDefinition Height="*"/>    <!-- Feature Previews WrapPanel -->
                    </Grid.RowDefinitions>

                    <!-- Category Navigation -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Width="44" Height="44" Style="{StaticResource EditorButton}" Click="PreviousCategoryButton_OnClick" FontSize="14"/>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="8,0">
                            <StackPanel x:Name="CategoryRailWrapPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>
                        <Button Grid.Column="2" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Width="44" Height="44" HorizontalAlignment="Right" Style="{StaticResource EditorButton}" Click="NextCategoryButton_OnClick" FontSize="14"/>
                    </Grid>

                    <!-- Selected Category Header -->
                    <Border Grid.Row="1" Background="{StaticResource EditorPanelSoft}" BorderBrush="#263654" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CurrentCategoryTitleTextBlock" Text="Face" FontWeight="Black" FontSize="22"/>
                                <TextBlock x:Name="CurrentCategoryHintTextBlock" Text="Choose a shape, then use Adjust for size and position." Foreground="{StaticResource EditorTextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviousOptionsButton" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Width="42" Height="40" Style="{StaticResource EditorButton}" Click="PreviousOptionsButton_OnClick" FontSize="12"/>
                                <TextBlock x:Name="OptionsPageTextBlock" Text="1/1" Width="64" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Black" FontSize="14"/>
                                <Button x:Name="NextOptionsButton" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Width="42" Height="40" Style="{StaticResource EditorButton}" Click="NextOptionsButton_OnClick" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Element Previews Grid -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="8,8,12,16" ClipToBounds="False">
                        <StackPanel x:Name="FeaturePreviewContainer" HorizontalAlignment="Stretch" Margin="0" ClipToBounds="False"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Column 2: Contextual Adjustment Sidebar -->
            <Border Grid.Column="2" Style="{StaticResource EditorCard}" Margin="10,0,0,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Scrollable sliders -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="ADJUSTMENTS" FontSize="16" FontWeight="Black" Foreground="{StaticResource EditorTextSecondary}" Margin="0,0,0,14"/>

                    <TabControl x:Name="AdjustTabs" Grid.Row="1" Style="{StaticResource HiddenHeadersTabControl}">
                        <TabItem x:Name="AdjustBaseTab" Header="Base">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,14,4" ClipToBounds="False">
                                <StackPanel Margin="0,0,4,0" ClipToBounds="False">
                                    <WrapPanel Margin="0,0,0,14">
                                        <CheckBox x:Name="FemaleCheckBox" Content="Female" Margin="0,4,12,4" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="FavoriteCheckBox" Content="Favorite" Margin="0,4,12,4" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="HairFlipCheckBox" Content="Flip hair" Margin="0,4,12,4" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                        <CheckBox x:Name="MoleEnabledCheckBox" Content="Mole" Margin="0,4,12,4" Checked="EditorControl_OnChanged" Unchecked="EditorControl_OnChanged"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="FavoriteColorValueTextBlock" Text="Color 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="FavoriteColorSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="HeightValueTextBlock" Text="Height 64" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="HeightSlider" Minimum="0" Maximum="127" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="WeightValueTextBlock" Text="Weight 64" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="WeightSlider" Minimum="0" Maximum="127" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="BirthMonthValueTextBlock" Text="Birth Month 6" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="BirthMonthSlider" Minimum="1" Maximum="12" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="BirthDayValueTextBlock" Text="Birth Day 15" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="BirthDaySlider" Minimum="1" Maximum="31" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustFaceTab" Header="Face">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,14,4" ClipToBounds="False">
                                <StackPanel Margin="0,0,4,0" ClipToBounds="False">
                                    <TextBlock x:Name="FaceShapeValueTextBlock" Text="Face shape 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="FaceShapeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="SkinColorValueTextBlock" Text="Skin 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="SkinColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="FacialFeatureValueTextBlock" Text="Features 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="FacialFeatureSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustHairTab" Header="Hair">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,14,4" ClipToBounds="False">
                                <StackPanel Margin="0,0,4,0" ClipToBounds="False">
                                    <TextBlock x:Name="HairTypeValueTextBlock" Text="Hair style 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="HairTypeSlider" Minimum="0" Maximum="71" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="HairColorValueTextBlock" Text="Hair color 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="HairColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustEyesTab" Header="Eyes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,14,4" ClipToBounds="False">
                                <StackPanel Margin="0,0,4,0" ClipToBounds="False">
                                    <TextBlock x:Name="EyeTypeValueTextBlock" Text="Eye style 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="EyeTypeSlider" Minimum="0" Maximum="47" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="EyeRotationValueTextBlock" Text="Rotation 0" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeRotationSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeColorValueTextBlock" Text="Color 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeColorSlider" Minimum="0" Maximum="5" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeSizeValueTextBlock" Text="Size 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeSizeSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeSpacingValueTextBlock" Text="Spacing 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeSpacingSlider" Minimum="0" Maximum="12" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyeVerticalValueTextBlock" Text="Position 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyeVerticalSlider" Minimum="0" Maximum="18" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="AdjustBrowsTab" Header="Eyebrows">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,14,4" ClipToBounds="False">
                                <StackPanel Margin="0,0,4,0" ClipToBounds="False">
                                    <TextBlock x:Name="EyebrowTypeValueTextBlock" Text="Brow style 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
                                    <Slider x:Name="EyebrowTypeSlider" Minimum="0" Maximum="23" ValueChanged="EditorControl_OnChanged" Visibility="Collapsed"/>
                                    <TextBlock x:Name="EyebrowRotationValueTextBlock" Text="Rotation 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyebrowRotationSlider" Minimum="0" Maximum="11" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyebrowColorValueTextBlock" Text="Color 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="EyebrowColorSlider" Minimum="0" Maximum="7" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="EyebrowSizeValueTextBlock" Text="Size 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
