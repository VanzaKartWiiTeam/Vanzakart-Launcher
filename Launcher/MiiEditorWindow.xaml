                                <StackPanel Margin="0,0,4,0" ClipToBounds="False">
                                    <TextBlock x:Name="GlassesTypeValueTextBlock" Text="Glasses style 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}" Visibility="Collapsed"/>
