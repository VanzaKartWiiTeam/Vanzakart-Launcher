                                    <TextBlock Text="— Mustache —" FontWeight="Bold" FontSize="12" Foreground="{StaticResource EditorTextFaint}" Margin="0,10,0,6"/>
                                    <TextBlock x:Name="MustacheSizeValueTextBlock" Text="Mustache size 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="MustacheSizeSlider" Minimum="0" Maximum="8" ValueChanged="EditorControl_OnChanged"/>
                                    <TextBlock x:Name="MustacheVerticalValueTextBlock" Text="Mustache position 1" FontWeight="Bold" FontSize="13" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Slider x:Name="MustacheVerticalSlider" Minimum="0" Maximum="16" ValueChanged="EditorControl_OnChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
