<Window x:Class="VanzaKartSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VanzaKart Setup"
        Width="640"
        Height="500"
        MinWidth="600"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        Icon="/Assets/app.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#0b101c"/>
        <SolidColorBrush x:Key="CardBgAltBrush" Color="#101727"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#F3F6FF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#A9B4C8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#090e1a"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#263246"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="BorderBrush" Value="#2A344A"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0B1020"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#061426"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#31405A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#030405"/>
                <GradientStop Offset="0.22" Color="#06080B"/>
                <GradientStop Offset="0.5" Color="#080A0D"/>
                <GradientStop Offset="0.78" Color="#05070A"/>
                <GradientStop Offset="1" Color="#020304"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="320"
                Height="320"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-120,-110,0"
                CornerRadius="999"
                Opacity="0.16">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#44A855F7"/>
                    <GradientStop Offset="0.35" Color="#33FF3B5C"/>
                    <GradientStop Offset="0.7" Color="#2247E9E2"/>
                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="26">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#55FF3B5C"/>
                        <GradientStop Offset="0.2" Color="#55FF8A3D"/>
                        <GradientStop Offset="0.4" Color="#55F5E74F"/>
                        <GradientStop Offset="0.6" Color="#5547E9E2"/>
                        <GradientStop Offset="1" Color="#55A855F7"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/Assets/logo.png"
                               Width="74"
                               Height="74"
                               Stretch="Uniform"/>
                    </StackPanel>

                    <TextBlock Text="VanzaKart Setup"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource TextMainBrush}"/>

                    <TextBlock Text="Choose where to install the launcher."
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"/>

                    <TextBlock Text="Install path"
                               Margin="0,24,0,8"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMainBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InstallPathTextBox"
                                 Style="{StaticResource ModernTextBox}"/>

                        <Button x:Name="BrowseButton"
                                Grid.Column="2"
                                Content="Browse"
                                Click="BrowseButton_OnClick"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,18,0,0"
                               Text="Ready to install."
                               Foreground="{StaticResource TextMainBrush}"
                               TextWrapping="Wrap"/>

                    <ProgressBar x:Name="ProgressBar"
                                 Margin="0,16,0,0"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Visibility="Collapsed"/>

                    <Button x:Name="InstallButton"
                            Margin="0,22,0,0"
                            Height="50"
                            Content="Install"
                            Click="InstallButton_OnClick"
                            Style="{StaticResource PrimaryButton}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FF3B5C"/>
                                <GradientStop Offset="0.22" Color="#FF8A3D"/>
                                <GradientStop Offset="0.45" Color="#F5E74F"/>
                                <GradientStop Offset="0.68" Color="#52F36C"/>
                                <GradientStop Offset="1" Color="#47E9E2"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>