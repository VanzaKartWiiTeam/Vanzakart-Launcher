<Window x:Class="VanzaKartSetup.MainWindow"
        x:Name="SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VanzaKart Setup"
        Width="960"
        Height="690"
        MinWidth="900"
        MinHeight="690"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/app.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="16"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7FAFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8B4CE"/>
        <SolidColorBrush x:Key="TextFaint" Color="#687794"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F012192A"/>
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#D80E1526"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0B1020"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#2A3857"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFD166"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4DFFB0"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B82"/>

        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#070A13"/>
            <GradientStop Offset="0.38" Color="#0F1426"/>
            <GradientStop Offset="0.70" Color="#061622"/>
            <GradientStop Offset="1.00" Color="#140A1F"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RainbowGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.00" Color="#FF0066"/>
            <GradientStop Offset="0.18" Color="#FF8800"/>
            <GradientStop Offset="0.34" Color="#FFEA00"/>
            <GradientStop Offset="0.50" Color="#00FF66"/>
            <GradientStop Offset="0.67" Color="#00F2FF"/>
            <GradientStop Offset="0.84" Color="#3300FF"/>
            <GradientStop Offset="1.00" Color="#B000FF"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="30" ShadowDepth="0" Opacity="0.32" Color="#000000"/>
        <DropShadowEffect x:Key="NeonGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.65" Color="#00F2FF"/>
        <DropShadowEffect x:Key="PinkGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#FF0066"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Opacity="1">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#00F2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#1A253D"/>
            <Setter Property="BorderBrush" Value="#344563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#223251"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#00F2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2B3C61"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.06"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.06"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.10"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.10"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RainbowButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="BorderThickness" Value="1.8"/>
            <Setter Property="BorderBrush" Value="{StaticResource RainbowGradient}"/>
            <Setter Property="Background" Value="#151E33"/>
            <Setter Property="Effect" Value="{StaticResource PinkGlow}"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24304A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#314263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.06"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.06"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.10"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.10"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource RainbowGradient}"/>
            <Setter Property="Background" Value="#0A1020"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}"
                                           RadiusX="7"
                                           RadiusY="7"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootShell"
            Background="{StaticResource WindowGradient}"
            BorderBrush="#2D3A56"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid>
            <Border x:Name="AmbientOne"
                    Width="360"
                    Height="360"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-150,-120,0"
                    CornerRadius="180"
                    Opacity="0.18">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#88FF0066"/>
                        <GradientStop Offset="0.42" Color="#5500F2FF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="AmbientTwo"
                    Width="320"
                    Height="320"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="-120,0,0,-160"
                    CornerRadius="160"
                    Opacity="0.13">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#9900FF66"/>
                        <GradientStop Offset="0.44" Color="#663300FF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="84"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Grid.Row="0" Background="#70070B16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Image Source="/Assets/logo.png" Width="24" Height="24" Stretch="Uniform"/>
                        <TextBlock Text="VANZAKART SETUP" FontSize="13" FontWeight="Black" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#18243A" BorderBrush="#35445F" BorderThickness="1" CornerRadius="5" Padding="9,3" Margin="14,0,0,0">
                            <TextBlock Text="Setup Installer" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="22,18,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource GlassCard}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <Image Source="/Assets/logo.png" Width="58" Height="58" HorizontalAlignment="Left"/>
                                <TextBlock Text="Setup" FontSize="22" FontWeight="Black" Margin="0,12,0,0"/>
                                <TextBlock
                            TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}"><Run Text="Install"/><Run Language="it-it" Text=" and"/><Run Text=" update the launcher."/></TextBlock>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <Border x:Name="StepWelcome" Tag="0" Style="{StaticResource MetricCard}" Margin="0,0,0,8" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE10F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Welcome" FontWeight="Bold"/>
                                            <TextBlock Text="Detection" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StepFolder" Tag="1" Style="{StaticResource MetricCard}" Margin="0,0,0,8" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Folder" FontWeight="Bold"/>
                                            <TextBlock Text="Preferences" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StepSpace" Tag="2" Style="{StaticResource MetricCard}" Margin="0,0,0,8" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Checks" FontWeight="Bold"/>
                                            <TextBlock Text="Disk and network" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StepDownload" Tag="3" Style="{StaticResource MetricCard}" Margin="0,0,0,8" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Download" FontWeight="Bold"/>
                                            <TextBlock Text="Launcher files" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StepInstall" Tag="4" Style="{StaticResource MetricCard}" Margin="0,0,0,8" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Install" FontWeight="Bold"/>
                                            <TextBlock Text="Registration" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StepComplete" Tag="5" Style="{StaticResource MetricCard}" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Complete" FontWeight="Bold"/>
                                            <TextBlock Text="Ready" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="ContentHost">
                                <Grid x:Name="WelcomeView">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                                        <Image Source="/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Welcome to VanzaKart" FontSize="28" FontWeight="Black" TextAlignment="Center" Margin="0,14,0,0"/>
                                        <TextBlock
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"><Run Text="Install or update the "/><Run Language="it-it" Text="VanzaKart Launcher."/></TextBlock>

                                        <Border x:Name="ExistingInstallCard" Background="#4A341000" BorderBrush="#FFD166" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,28,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Existing installation detected!" Foreground="{StaticResource WarningBrush}" FontWeight="Black" FontSize="15"/>
                                                <TextBlock x:Name="ExistingInstallTextBlock" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,8" TextWrapping="Wrap"/>
                                                <RadioButton x:Name="UpdateInstallRadioButton" Content="Update installation (keeps saves and preferences)" IsChecked="True" GroupName="InstallMode" Style="{StaticResource ModernRadioButton}"/>
                                                <RadioButton x:Name="CleanReinstallRadioButton" Content="Clean reinstall (wipes old program files, keeps a backup if enabled)" GroupName="InstallMode" Style="{StaticResource ModernRadioButton}"/>
                                            </StackPanel>
                                        </Border>

                                        <UniformGrid Columns="2" Margin="0,22,0,0">
                                            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="CONNECTION" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="InternetStatusTextBlock" Text="Waiting" FontSize="17" FontWeight="Black" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="PACKAGE" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="EstimatedSizeTextBlock" Text="Calculating..." FontSize="17" FontWeight="Black" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="FolderView" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Installation Preferences" FontSize="26" FontWeight="Black"/>
                                        <TextBlock Text="Choose the install folder, backup behavior, and shortcuts." Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,6,0,18"/>

                                        <TextBlock Text="INSTALLATION FOLDER" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold"/>
                                        <Grid Margin="0,8,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="136"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="InstallPathTextBox" Style="{StaticResource FieldTextBox}"/>
                                            <Button x:Name="BrowseInstallPathButton" Grid.Column="2" Content="Browse" Click="BrowseInstallPathButton_OnClick" Style="{StaticResource ModernButton}"/>
                                        </Grid>

                                        <Border Style="{StaticResource MetricCard}" Padding="16" Margin="0,0,0,18">
                                            <StackPanel>
                                                <CheckBox x:Name="BackupCheckBox" Content="Create safety backup of user data before installing" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="136"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="BackupPathTextBox" Style="{StaticResource FieldTextBox}"/>
                                                    <Button x:Name="BrowseBackupPathButton" Grid.Column="2" Content="Browse" Click="BrowseBackupPathButton_OnClick" Style="{StaticResource ModernButton}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="SHORTCUTS" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,2,0,6"/>
                                            <CheckBox x:Name="DesktopShortcutCheckBox" Content="Create a desktop shortcut for quick access from the desktop" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                            <CheckBox x:Name="StartMenuShortcutCheckBox" Content="Add VanzaKart to the Windows Start Menu" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                            <CheckBox x:Name="QuickLaunchShortcutCheckBox" Content="Create a Quick Launch shortcut on the taskbar toolbar, when available" Style="{StaticResource ModernCheckBox}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="SpaceView" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Verification" FontSize="26" FontWeight="Black"/>
                                        <TextBlock Text="Check free disk space, internet access, and download size." Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,6,0,18"/>

                                        <UniformGrid Columns="2">
                                            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,16">
                                                <StackPanel>
                                                    <TextBlock Text="REQUIRED SPACE" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="RequiredSpaceTextBlock" Text="-" FontSize="20" FontWeight="Black" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}" Margin="8,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="AVAILABLE SPACE" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="AvailableSpaceTextBlock" Text="-" FontSize="20" FontWeight="Black" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,16">
                                                <StackPanel>
                                                    <TextBlock Text="DOWNLOAD" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="DownloadSizeTextBlock" Text="-" FontSize="20" FontWeight="Black" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}" Margin="8,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="TIME ESTIMATE" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="EstimatedTimeTextBlock" Text="-" FontSize="20" FontWeight="Black" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Style="{StaticResource MetricCard}" Padding="18">
                                            <StackPanel>
                                                <TextBlock x:Name="InternetCheckTextBlock" Text="Connection: waiting" FontWeight="Bold"/>
                                                <TextBlock x:Name="SpaceStatusTextBlock" Text="Press Install to start." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="DownloadView" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Downloading Files" FontSize="26" FontWeight="Black" TextAlignment="Center"/>
                                        <TextBlock x:Name="DownloadStatusTextBlock" Text="Preparing download..." Foreground="{StaticResource TextSecondary}" TextAlignment="Center" FontSize="14" Margin="0,8,0,24"/>
                                        <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100"/>
                                        <UniformGrid Columns="3" Margin="0,22,0,0">
                                            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="SPEED" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="DownloadSpeedTextBlock" Text="0 MB/s" FontSize="18" FontWeight="Black" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}" Margin="8,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="DOWNLOADED" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="DownloadedTextBlock" Text="0 MB" FontSize="18" FontWeight="Black" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MetricCard}" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="REMAINING" Foreground="{StaticResource TextFaint}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock x:Name="DownloadEtaTextBlock" Text="-" FontSize="18" FontWeight="Black" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="InstallView" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Installing" FontSize="26" FontWeight="Black"/>
                                        <TextBlock x:Name="InstallStatusTextBlock" Text="Preparing installation..." Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,6,0,20"/>
                                        <ProgressBar x:Name="InstallProgressBar" Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100"/>
                                        <Expander Header="Installation log" IsExpanded="True" Margin="0,26,0,0" Foreground="{StaticResource TextPrimary}">
                                            <Border Background="#990B1020" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,10,0,0" Height="160">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <TextBlock x:Name="InstallLogTextBlock" Text="Log initialized." FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Expander>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="CompleteView" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                                        <Border Width="96" Height="96" CornerRadius="48" Background="{StaticResource RainbowGradient}" Effect="{StaticResource NeonGlow}">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="VanzaKart Launcher is ready" FontSize="30" FontWeight="Black" TextAlignment="Center" Margin="0,24,0,0"/>
                                        <TextBlock x:Name="CompleteSummaryTextBlock" Text="Installation complete." Foreground="{StaticResource TextSecondary}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,24"/>
                                        <CheckBox x:Name="LaunchAfterInstallCheckBox" Content="Launch VanzaKart Launcher now" IsChecked="True" Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="22,12,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource ModernButton}" Click="BackButton_Click"/>
                    <TextBlock x:Name="FooterStatusTextBlock" Grid.Column="1" Text="Ready." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextAlignment="Center"/>
                    <Button x:Name="NextButton" Grid.Column="2" Content="Next" Style="{StaticResource RainbowButton}" Click="NextButton_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
