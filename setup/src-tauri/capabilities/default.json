{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi minimi dell'installer. Il frontend non tocca il filesystem: sceglie una cartella con la finestra di sistema e la passa a un comando Rust che la valida (stessa regola del launcher, docs/decisions.md §D-017).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "dialog:allow-open",
      "allow": []
    },
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:allow-open-url"
  ]
}
