{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VanzaKart Launcher",
  "version": "2.1.0",
  "identifier": "net.vanzakart.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VanzaKart Launcher",
        "width": 1320,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "backgroundColor": "#070A13",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/*"],
    "copyright": "VanzaKart",
    "category": "Game",
    "shortDescription": "Launcher for the VanzaKart Mario Kart Wii modpack",
    "longDescription": "Installs, updates and starts the VanzaKart modpack on Dolphin with Riivolution patches, Mii and licence management.",
    "publisher": "VanzaKart",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
