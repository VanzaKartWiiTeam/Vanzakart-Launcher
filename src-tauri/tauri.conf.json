{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VanzaKart Launcher",
  "version": "2.0.0-beta.5",
  "identifier": "it.sitodaking.vanzakart.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VanzaKart Launcher",
        "width": 1320,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "backgroundColor": "#070A13",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage", "rpm"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/*"],
    "copyright": "VanzaKart",
    "category": "Game",
    "shortDescription": "Launcher per la modpack VanzaKart di Mario Kart Wii",
    "longDescription": "Installa, aggiorna e avvia la modpack VanzaKart su Dolphin con patch Riivolution, gestione dei Mii e delle licenze.",
    "publisher": "VanzaKart",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxQjJCREM5OEIxMjU5MEEKUldRS1dSS0x5YjJ5Y2JxcUIyT0N6b2JSSTVoTFU0UmxtNTF4QWhwdE5XZDBtLzRUZUFaa1hwbEMK",
      "endpoints": [
        "https://sitodaking.it:8443/Launcher/updater/{{target}}-{{arch}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
