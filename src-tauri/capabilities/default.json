{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi minimi del launcher. Il frontend NON ha accesso al filesystem: ogni operazione su file passa da un comando Rust che valida i percorsi (vedi docs/decisions.md §D-017).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:allow-internal-toggle-devtools",
    {
      "identifier": "dialog:allow-open",
      "allow": []
    },
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:allow-open-url",
    "process:allow-restart",
    "updater:default"
  ]
}
