# Cartelle di compilazione di cargo, comprese quelle con un nome diverso dal
# solito: `CARGO_TARGET_DIR` le crea dove gli si dice, e una `target-qualcosa`
# non rientrava in nessuna regola.
/target
/target-*
/src-tauri/target
/src-tauri/target-*
/setup/src-tauri/target
/setup/src-tauri/target-*

/node_modules
/dist
/docs
/src-tauri/gen
*.log
.DS_Store
.env
.env.*
!.env.example

# Artefatti di rilascio: pacchetti, firme e i due manifest. Li rigenerano
# Publish-LauncherUpdate.ps1 e Publish-SetupRelease.ps1 a ogni pubblicazione.
/dist-launcher

# Frontend compilato dell'installer, e gli schemi che Tauri rigenera a ogni
# build dell'installer.
/setup/dist
/setup/src-tauri/gen

# Impalcatura temporanea per guardare la UI con un IPC finto: si crea e si
# cancella durante il lavoro, non fa parte del progetto.
/preview-tmp
/vite.preview.config.ts
